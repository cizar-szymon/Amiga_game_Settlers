+
+/* The letters of the game's font (it shows them in capitals). */
+static bool
+chat_letter(char c) {
+  return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+         (c >= '0' && c <= '9') || c == ' ' || c == '-' || c == '.' ||
+         c == ':' || c == '?' || c == '%';
+}
+
+/* Only the letters of the font, at most max of them (the other side may
+   send anything). */
+static std::string
+chat_clean(const std::string &s, size_t max) {
+  std::string r;
+  for (char c : s) {
+    if (r.size() >= max) break;
+    if (chat_letter(c)) r += c;
+  }
+  return r;
+}
+
+void
+LanGame::add_chat(int player, const std::string &name,
+                  const std::string &text) {
+  ChatLine line;
+  line.player = player;
+  line.name = chat_clean(name, 15);
+  line.text = chat_clean(text, kChatLength);
+  chat.push_back(line);
+  while (chat.size() > kChatLines) {
+    chat.pop_front();
+  }
+}
+
+void
+LanGame::send_chat() {
+  if (chat_input.empty()) return;
+  int player = static_cast<int>(interface->get_player()->get_index());
+  if (link == nullptr || gone) {
+    add_chat(-1, std::string(), "NOT SENT - NO CONNECTION");
+    return;
+  }
+  link->send(MessageChat, std::string(1, static_cast<char>(player)) +
+                          own_name + "\n" + chat_input);
+  add_chat(player, own_name, chat_input);
+  chat_input.clear();
+}
+
+bool
+LanGame::handle_chat_key(char key, int modifier) {
+  if (!chat_open) {
+    /* Tab opens the chat (Shift+Tab stays: back from a message). */
+    if (key == '\t' && (modifier & 3) == 0) {
+      chat_open = true;
+      update_chat_box(true);
+      return true;
+    }
+    return false;
+  }
+  /* Ctrl with a key stays for the game (Ctrl+Z, Ctrl+C...). */
+  if (modifier & 1) {
+    return false;
+  }
+  if (key == '\t' || key == 27) {
+    chat_open = false;   /* what was typed stays for the next time */
+    chat_shown_until = 0;
+  } else if (key == '\r' || key == '\n') {
+    send_chat();
+  } else if (key == '\b') {
+    if (!chat_input.empty()) chat_input.erase(chat_input.size() - 1);
+  } else if (chat_letter(key) && chat_input.size() < kChatLength) {
+    chat_input += key;
+  }
+  update_chat_box(true);
+  /* All the other keys too: the letters do not go to the game. */
+  return true;
+}
+
+/* The width of the names in the box (longer ones are cut). */
+static const size_t kChatNameShown = 10;
+static const int kChatRow = 10;
+/* Inside the frame: its top and sides, the bottom. */
+static const int kChatTop = 9 + 3;
+static const int kChatSide = 8 + 4;
+static const int kChatBottom = 7 + 3;
+
+void
+LanGame::update_chat_box(bool changed) {
+  bool recent = !chat.empty() &&
+    static_cast<int>(EventLoop::get_instance().get_ticks() -
+                     chat_shown_until) < 0;
+  bool show = chat_open || recent;
+  if (!show) {
+    if (chat_box && chat_box->is_displayed()) {
+      chat_box->set_displayed(false);
+      interface->set_redraw();
+    }
+    return;
+  }
+  if (!chat_box) {
+    chat_box.reset(new LanChatBox(this));
+    interface->add_float(chat_box.get(), 4, 26);
+  }
+  size_t name_len = std::min(kChatNameShown, own_name.size());
+  for (const ChatLine &l : chat) {
+    name_len = std::max(name_len, std::min(kChatNameShown, l.name.size()));
+  }
+  int w = 2 * kChatSide + 8 * static_cast<int>(name_len + 1 + kChatLength + 1);
+  int rows = chat_open ? static_cast<int>(kChatLines) : static_cast<int>(
+                                                          chat.size());
+  int h = kChatTop + rows * kChatRow + kChatBottom +
+          (chat_open ? kChatRow + 4 : 0);
+  int bw = 0, bh = 0;
+  chat_box->get_size(&bw, &bh);
+  if (!chat_box->is_displayed() || bw != w || bh != h) {
+    chat_box->set_size(w, h);
+    chat_box->set_displayed(true);
+    interface->set_redraw();
+  } else if (changed) {
+    chat_box->set_redraw();
+  }
+}
+
+/* A line of each message, the name in the colour of the writer's player.
+   Open: kChatLines rows and under them the line being typed; closed: the
+   lines for a while after one came. */
+void
+LanGame::draw_chat(Frame *frame, int w, int h) {
+  PGame game = interface->get_game();
+  if (!game) return;
+
+  /* The background of the start box, then the frame of the boxes. */
+  unsigned int icon = 290;
+  for (int by = 0; by < h; by += 8) {
+    for (int bx = 0; bx < w; bx += 40) {
+      frame->draw_sprite(bx, by, Data::AssetIcon, icon);
+    }
+    icon = (icon == 290) ? 294 : icon - 1;
+  }
+  draw_box_frame(frame, w, h);
+
+  size_t name_len = std::min(kChatNameShown, own_name.size());
+  for (const ChatLine &l : chat) {
+    name_len = std::max(name_len, std::min(kChatNameShown, l.name.size()));
+  }
+  int text_x = kChatSide + 8 * static_cast<int>(name_len + 1);
+  int ry = kChatTop;
+  if (chat_open) {
+    ry += kChatRow * static_cast<int>(kChatLines - chat.size());
+  }
+  for (const ChatLine &l : chat) {
+    if (l.player < 0 || game->get_player(l.player) == nullptr) {
+      frame->draw_string(kChatSide, ry, l.text, Color(0xdd, 0xdd, 0x00),
+                         Color::black);
+    } else {
+      frame->draw_string(kChatSide, ry, l.name.substr(0, kChatNameShown),
+                         interface->get_player_color(l.player), Color::black);
+      frame->draw_string(text_x, ry, l.text, Color(0xdd, 0xdd, 0xdd),
+                         Color::black);
+    }
+    ry += kChatRow;
+  }
+  if (chat_open) {
+    int own = static_cast<int>(interface->get_player()->get_index());
+    Color own_color = interface->get_player_color(own);
+    ry = kChatTop + kChatRow * static_cast<int>(kChatLines) + 1;
+    frame->fill_rect(kChatSide, ry, w - 2 * kChatSide, 1, own_color);
+    ry += 4;
+    frame->draw_string(kChatSide, ry, own_name.substr(0, kChatNameShown),
+                       own_color, Color::black);
+    frame->draw_string(text_x, ry, chat_input, Color::white, Color::black);
+    if (chat_input.size() < kChatLength) {
+      frame->fill_rect(text_x + 8 * static_cast<int>(chat_input.size()),
+                       ry + 7, 7, 1, Color::white);
+    }
+  }
+}
