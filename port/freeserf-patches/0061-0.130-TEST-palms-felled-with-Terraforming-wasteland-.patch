+void (*load_progress)(int percent) = nullptr;
+
+/* Loading by its steps: reading the file to this percent, making its
+   sections to the next, the parts of the game the rest (shares of the
+   time on a 68060, 20-last.save). */
+static const int kLoadReadShare = 50;
+static const int kLoadSectionsShare = 72;
+static size_t load_file_size = 0;
+static int load_last_percent = -1;
+
+static void
+load_report(int percent) {
+  if (load_progress != nullptr && percent != load_last_percent) {
+    load_last_percent = percent;
+    load_progress(percent);
+  }
+}
+
+static void
+load_read_progress(size_t bytes) {
+  if (load_file_size == 0) return;
+  size_t p = bytes * kLoadReadShare / load_file_size;
+  load_report(static_cast<int>(std::min<size_t>(p, kLoadReadShare)));
+}
+
+static void
+load_progress_sections(size_t done, size_t total) {
+  if (total == 0) return;
+  load_report(kLoadReadShare + static_cast<int>(
+    (kLoadSectionsShare - kLoadReadShare) * done / total));
+}
+
+void
+load_progress_parts(unsigned int done, unsigned int total) {
+  if (total == 0) return;
+  load_report(kLoadSectionsShare + static_cast<int>(
+    (100 - kLoadSectionsShare) * done / total));
+}
