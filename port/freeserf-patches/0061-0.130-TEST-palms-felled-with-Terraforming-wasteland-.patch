+void
+Frame::draw_sprite_turned(int x, int y, Data::Resource res,
+                          unsigned int index, int degrees) {
+  Data::Sprite::Color none = {0, 0, 0, 0};
+  /* The mask fields of the id: 0xe0 and the angle in 5 degree steps. */
+  uint64_t id = Data::Sprite::create_id(res, index, 0xe0,
+                                        static_cast<unsigned int>(degrees / 5),
+                                        none);
+  Image *image = Image::get_cached_image(id);
+  if (image == nullptr) {
+    Data::PSprite base = data_source->get_sprite(res, index, none);
+    if (!base) return;
+    int bw = static_cast<int>(base->get_width());
+    int bh = static_cast<int>(base->get_height());
+    int ox = base->get_offset_x(), oy = base->get_offset_y();
+    /* Pixel (u, v) of the sprite is at (u + ox, v + oy) from the point;
+       turned: x' = x cos - y sin, y' = x sin + y cos (y down). Fixed
+       point, 1/1024, from a small table (no floating point). */
+    static const int kCos[] = { 1024, 1020, 1008, 989, 962, 928, 887, 839,
+                                784, 724, 658, 587, 512, 433, 350, 265, 178,
+                                89, 0 };
+    int k = std::min(18, std::max(0, degrees / 5));
+    int c = kCos[k], sn = kCos[18 - k];
+    int min_x = 1 << 20, min_y = 1 << 20, max_x = -(1 << 20),
+        max_y = -(1 << 20);
+    const int cx[4] = { ox, ox + bw, ox, ox + bw };
+    const int cy[4] = { oy, oy, oy + bh, oy + bh };
+    for (int i = 0; i < 4; i++) {
+      int tx = (cx[i] * c - cy[i] * sn) / 1024;
+      int ty = (cx[i] * sn + cy[i] * c) / 1024;
+      min_x = std::min(min_x, tx); max_x = std::max(max_x, tx);
+      min_y = std::min(min_y, ty); max_y = std::max(max_y, ty);
+    }
+    int w = max_x - min_x + 2, h = max_y - min_y + 2;
+    std::shared_ptr<SpriteBase> s = std::make_shared<SpriteBase>(w, h);
+    s->set_offset(min_x, min_y);
+    uint8_t *dst = s->get_data();
+    std::memset(dst, 0, static_cast<size_t>(w) * h * 4);
+    const uint8_t *src = base->get_data();
+    for (int j = 0; j < h; j++) {
+      for (int i = 0; i < w; i++) {
+        /* Back to the sprite (the turn the other way). */
+        int x1 = i + min_x, y1 = j + min_y;
+        int u = (x1 * c + y1 * sn + 512) / 1024 - ox;
+        int v = (-x1 * sn + y1 * c + 512) / 1024 - oy;
+        if (u < 0 || v < 0 || u >= bw || v >= bh) continue;
+        std::memcpy(dst + (j * w + i) * 4, src + (v * bw + u) * 4, 4);
+      }
+    }
+    image = new Image(video, s);
+    Image::cache_image(id, image);
+  }
+  video->draw_image(image->get_video_image(), x + image->get_offset_x(),
+                    y + image->get_offset_y(), 0, video_frame);
+}
