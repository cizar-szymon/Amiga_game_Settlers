+/* An amount of the original's: "Normal" (as the original), "None", else
+   "50% of normal" - a plain "100%" read like all sand. */
+static std::string
+amount_text(unsigned int percent) {
+  if (percent >= 100) return "Normal";
+  if (percent == 0) return "None";
+  return std::to_string(percent) + "% of normal";
+}
+
+static std::string
+sand_text(const Interface *interface) {
+  return amount_text(interface->get_sand_percent());
+}
+
+static std::string
+rocks_text(const Interface *interface) {
+  return amount_text(interface->get_rock_percent());
+}
