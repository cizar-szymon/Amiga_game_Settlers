 #include "src/gfx.h"
 #include "src/data.h"
 
+void
+draw_small_letters(Frame *frame, int x, int y, const char *const *rows,
+                   int scale, int row_count) {
+  for (int pass = 0; pass < 2; pass++) {
+    for (int r = 0; r < row_count; r++) {
+      for (int col = 0; rows[r][col] != 0; col++) {
+        if (rows[r][col] != '#') continue;
+        int dx = x + col * scale, dy = y + r * scale;
+        if (pass == 0) {
+          frame->fill_rect(dx - 1, dy - 1, scale + 2, scale + 2,
+                           Color(0x55, 0x22, 0x00));
+        } else {
+          frame->fill_rect(dx, dy, scale, scale, Color(0xdd, 0xdd, 0x00));
+        }
+      }
+    }
+  }
+}
+
