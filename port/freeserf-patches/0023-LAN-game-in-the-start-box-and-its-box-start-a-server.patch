+
+/* Opened by the Start button of a LAN game in the start box. One player
+   starts a server with the settings of the start box, the other one
+   joins it: a server found in the network or an address typed in. */
+class LanBox : public GuiObject {
+ public:
+  /* Wide enough for a label, a gap and an address on one row; still
+     fits a 400x300 screen. */
+  static const int kWidth = 352;
+  static const int kHeight = 216;
+
+  /* The frames of the game through the link. */
+  typedef enum Message {
+    MessageSetup = 0   /* START GAME: the settings of the game */
+  } Message;
+
+ protected:
+  typedef enum View {
+    ViewChoose,
+    ViewServer,
+    ViewJoin,
+    ViewJoined   /* connected to a server, waiting for it to start */
+  } View;
+
+  Interface *interface;
+  PGameInfo mission;
+  View view;
+  std::string own_address;
+  /* The names in a LAN game, kept in the settings: of a server (players
+     looking for one see it, MASTER at first) and of a player who joins
+     (the server shows it, SLAVE at first). */
+  std::unique_ptr<TextInput> server_name_field;
+  std::unique_ptr<TextInput> player_name_field;
+  std::unique_ptr<TextInput> address_field;
+  std::vector<LanLink::Server> servers;
+  std::string message;
+  bool starting;
+
+ public:
+  LanBox(Interface *interface, PGameInfo mission);
+  virtual ~LanBox();
+
+  /* With every update of the interface: the network. */
+  void update();
+
+ protected:
+  LanLink *link();
+  LanLink::State link_state();
+  void set_view(View view);
+  void draw_text_button(int x, int y, int w, const std::string &text,
+                        bool enabled = true);
+  void draw_centered(int y, const std::string &text);
+  void draw_rows(int y, const std::string rows[][2], size_t count);
+  std::string ping_text();
+  static bool inside(int x, int y, int bx, int by, int bw, int bh);
+
+  virtual void internal_draw();
+  virtual bool handle_click_left(int x, int y);
+};
+
+#endif  // SRC_LAN_BOX_H_
