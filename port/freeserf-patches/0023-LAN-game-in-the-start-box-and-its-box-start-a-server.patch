+/*
+ * lan-link.h - The network of a LAN game (two players on two computers)
+ *
+ * Copyright (C) 2026  Wicked_Digger <wicked_digger@mail.ru>
+ *
+ * This file is part of freeserf.
+ *
+ * freeserf is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * freeserf is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with freeserf.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#ifndef SRC_LAN_LINK_H_
+#define SRC_LAN_LINK_H_
+
+#include <string>
+#include <vector>
+
+/* The connection of a LAN game, given by the platform (the Amiga port:
+   a process of its own with bsdsocket.library); Freeserf only uses it.
+   Nothing waits: the box and the game call poll() with every update. */
+class LanLink {
+ public:
+  typedef enum State {
+    StateIdle,
+    StateServing,     /* a server waiting for a player */
+    StateSearching,   /* looking for servers in the network */
+    StateConnecting,
+    StateConnected    /* the other player is there */
+  } State;
+
+  typedef struct Server {
+    std::string name;
+    std::string address;
+    std::string version;
+    bool same_version;   /* as this program: it can join */
+  } Server;
+
+  /* The frames of the game: their type and up to kMaxData bytes. */
+  static const int kMaxData = 250;
+
+  virtual ~LanLink() {}
+
+  /* What came from the network since the last call; true: something
+     changed (to draw the box again). */
+  virtual bool poll() = 0;
+  virtual State get_state() = 0;
+  /* This side started the server (it stays one when the player goes). */
+  virtual bool is_server() = 0;
+
+  /* The address of this computer ("" until it is known). */
+  virtual std::string get_address() = 0;
+  /* A message for the player (an error, "Disconnected."), once; "" if
+     none. */
+  virtual std::string take_message() = 0;
+
+  /* Listen for a player and announce the server by name. */
+  virtual void start_server(const std::string &name) = 0;
+  /* Look for servers for a few seconds; get_servers() fills meanwhile. */
+  virtual void search() = 0;
+  virtual std::vector<Server> get_servers() = 0;
+  virtual void connect(const std::string &address,
+                       const std::string &name) = 0;
+  /* Back to idle: the server, the search or the connection ends. */
+  virtual void close() = 0;
+
+  virtual std::string get_peer_name() = 0;
+  virtual std::string get_peer_address() = 0;
+  /* The time there and back of the last ping, ms; -1 none yet. */
+  virtual int get_ping_ms() = 0;
+
+  virtual bool send(int type, const std::string &data) = 0;
+  /* The next frame of the game received, false if none. */
+  virtual bool receive(int *type, std::string *data) = 0;
+};
+
+#endif  // SRC_LAN_LINK_H_
