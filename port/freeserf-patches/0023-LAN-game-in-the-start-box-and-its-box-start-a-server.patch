+static const int kButtonHeight = 16;
+static const int kButtonX = (LanBox::kWidth - kButtonWidth) / 2;
+static const int kLeftButtonX = 16;
+static const int kRightButtonX = LanBox::kWidth - 16 - kButtonWidth;
+static const int kLabelX = 16;
+static const int kValueX = 168;
+static const int kFieldWidth = 132;
+
+/* Choose */
+static const int kServerButtonY = 56;
+static const int kJoinButtonY = 104;
+/* Server: rows of 10 pixels from kRowsY, then the buttons */
+static const int kRowsY = 40;
+static const int kRunY = 138;
+static const int kCancelY = 158;
+/* Join: the list of servers, the name, the address and the buttons */
+static const int kListX = 16, kListY = 34, kListW = 320, kListH = 50;
+static const int kListRows = 6;
+static const int kSearchX = 16, kSearchY = 88, kSearchW = 80;
+static const int kJoinNameY = 112;
+static const int kAddressY = 126;
+static const int kJoinButtonsY = 144;
+static const int kMessageY = 180;
+
+static const char kNoNetwork[] = "No network in this version.";
+
+/* Letters, digits, spaces and - _ . of a name. */
+static bool
+name_filter(const char key, TextInput *text_input) {
+  return (key >= 'a' && key <= 'z') || (key >= 'A' && key <= 'Z') ||
+         (key >= '0' && key <= '9') || key == ' ' || key == '-' ||
+         key == '_' || key == '.';
+}
+
+/* Digits and dots of an IPv4 address. */
+static bool
+address_filter(const char key, TextInput *text_input) {
+  return (key >= '0' && key <= '9') || key == '.';
+}
+
+/* A field for a name, kept in the settings under key. */
+static TextInput *
+make_name_field(const std::string &key, const char *def) {
+  TextInput *field = new TextInput();
+  field->set_text(Settings::get_instance().get("lan", key, std::string(def)));
+  field->set_size(kFieldWidth, 10);
+  field->set_max_length(15);
+  field->set_filter(name_filter);
+  field->set_displayed(false);
+  return field;
+}
+
+LanBox::LanBox(Interface *_interface, PGameInfo _mission)
+  : interface(_interface)
+  , mission(_mission)
+  , view(ViewChoose)
+  , server_name_field(make_name_field("server_name", "MASTER"))
+  , player_name_field(make_name_field("player_name", "SLAVE"))
+  , address_field(new TextInput())
+  , starting(false) {
+  set_size(kWidth, kHeight);
+  add_float(server_name_field.get(), kValueX - 4, kRowsY - 1);
+  add_float(player_name_field.get(), kValueX - 4, kJoinNameY - 1);
+
+  address_field->set_size(kFieldWidth, 10);
+  address_field->set_max_length(15);
+  address_field->set_filter(address_filter);
+  address_field->set_text(Settings::get_instance().get(
+    "lan", "server_address", std::string()));
+  address_field->set_displayed(false);
+  add_float(address_field.get(), kValueX - 4, kAddressY - 1);
+}
+
+LanBox::~LanBox() {
+  if (link() != nullptr) {
+    link()->close();
+  }
+  Settings &settings = Settings::get_instance();
+  if (!server_name_field->get_text().empty()) {
+    settings.set("lan", "server_name", server_name_field->get_text());
+  }
+  if (!player_name_field->get_text().empty()) {
+    settings.set("lan", "player_name", player_name_field->get_text());
+  }
+  settings.set("lan", "server_address", address_field->get_text());
+  settings.save();
+}
+
+LanLink *
+LanBox::link() {
+  return Interface::lan_link;
+}
+
+LanLink::State
+LanBox::link_state() {
+  return link() != nullptr ? link()->get_state() : LanLink::StateIdle;
+}
+
+void
+LanBox::set_view(View _view) {
+  if (link() != nullptr && _view != ViewJoined) {
+    link()->close();
+  }
+  view = _view;
+  message.clear();
+  starting = false;
+  server_name_field->set_displayed(view == ViewServer);
+  player_name_field->set_displayed(view == ViewJoin);
+  address_field->set_displayed(view == ViewJoin);
+  if (view == ViewServer && link() != nullptr && own_address.empty()) {
+    own_address = link()->get_address();
+    message = link()->take_message();
+  }
+  if (view == ViewJoin) {
+    address_field->set_focused();  /* The address is typed at once. */
+  }
+  set_redraw();
+}
+
+void
+LanBox::update() {
+  LanLink *l = link();
+  if (l == nullptr || view == ViewChoose) {
+    return;
+  }
+  if (!l->poll()) {
+    return;
+  }
+  if (own_address.empty()) {
+    own_address = l->get_address();
+  }
+  std::string m = l->take_message();
+  if (!m.empty()) {
+    message = m;
+    starting = false;
+  }
+  if (view == ViewJoin) {
+    servers = l->get_servers();
+    if (l->get_state() == LanLink::StateConnected) {
+      set_view(ViewJoined);
+    }
+  } else if (view == ViewJoined &&
+             l->get_state() != LanLink::StateConnected) {
+    set_view(ViewJoin);
+    message = m;
+  }
+  int type = 0;
+  std::string data;
+  while (l->receive(&type, &data)) {
+    if (type == MessageSetup) {
+      /* Point 3 of the plan: the game itself. */
+      starting = true;
+      message = "The server starts the game...";
+    }
+  }
+  set_redraw();
+}
+
+std::string
+LanBox::ping_text() {
+  int ms = link() != nullptr ? link()->get_ping_ms() : -1;
+  return ms < 0 ? "-" : std::to_string(ms) + " ms";
+}
+
+bool
+LanBox::inside(int x, int y, int bx, int by, int bw, int bh) {
+  return x >= bx && x < bx + bw && y >= by && y < by + bh;
+}
+
+/* A button of the box: a text on a wooden plate with a dark edge, the
+   colours of the small labels of the settings box. A disabled one is
+   grey. */
+void
+LanBox::draw_text_button(int x, int y, int w, const std::string &text,
+                         bool enabled) {
+  frame->fill_rect(x, y, w, kButtonHeight, Color(0x55, 0x22, 0x00));
+  frame->fill_rect(x + 1, y + 1, w - 2, kButtonHeight - 2,
+                   enabled ? Color(0x99, 0x55, 0x22) : Color(0x55, 0x55, 0x55));
+  int tx = x + (w - frame->get_string_width(text)) / 2;
+  frame->draw_string(tx, y + 4, text,
+                     enabled ? Color(0xdd, 0xdd, 0x00) : Color(0x99, 0x99, 0x99),
+                     Color::black);
+}
+
+void
+LanBox::draw_centered(int y, const std::string &text) {
+  frame->draw_string((width - frame->get_string_width(text)) / 2, y, text,
+                     Color::green, Color::black);
+}
+
+void
+LanBox::draw_rows(int y, const std::string rows[][2], size_t count) {
+  for (size_t i = 0; i < count; i++) {
+    frame->draw_string(kLabelX, y, rows[i][0], Color::green, Color::black);
+    frame->draw_string(kValueX, y, rows[i][1], Color::green, Color::black);
+    y += 10;
+  }
+}
+
+void
+LanBox::internal_draw() {
+  for (int y = 0; y < height; y += 16) {
+    for (int x = 0; x < width; x += 16) {
+      frame->draw_sprite(x, y, Data::AssetIcon,
+                         PopupBox::PatternDiagonalGreen);
+    }
+  }
+  draw_box_frame(frame, width, height);
+  draw_centered(9, "LAN game");
+
+  LanLink::State state = link_state();
+  switch (view) {
+    case ViewChoose:
+      draw_centered(26, "Two players on two Amigas");
+      draw_centered(36, "in one network.");
+      draw_text_button(kButtonX, kServerButtonY, kButtonWidth, "START SERVER");
+      draw_centered(kServerButtonY + 20, "This Amiga sets up the game.");
+      draw_text_button(kButtonX, kJoinButtonY, kButtonWidth, "JOIN SERVER");
+      draw_centered(kJoinButtonY + 20, "Find the server or type");
+      draw_centered(kJoinButtonY + 30, "its address and connect.");
+      break;
+    case ViewServer: {
+      bool running = state == LanLink::StateServing ||
+                     state == LanLink::StateConnected;
+      bool joined = state == LanLink::StateConnected;
+      draw_centered(26, joined ? "A player has joined."
+                    : running ? "Waiting for a player..."
+                              : "RUN SERVER to be found.");
+      int ai = 0;
+      for (size_t i = 0; i < mission->get_player_count(); i++) {
+        if (mission->get_player(i)->get_face() < 12) ai++;
+      }
+      /* The name (a field over the first row) is what the players who
+         look for a server see. The player who joins appears below with
+         their name and address; then the game can start. */
+      const std::string rows[][2] = {
+        { "Server name", "" },
+        { "Server address", own_address.empty() ? "-" : own_address },
+        { "", "" },
+        { "Map size", std::to_string(mission->get_map_size()) },
+        { "AI players", std::to_string(ai) },
+        { "", "" },
+        { "Player 2", joined ? link()->get_peer_name() : "-" },
+        { "Address", joined ? link()->get_peer_address() : "-" },
+        { "Response", joined ? ping_text() : "-" },
+      };
+      draw_rows(kRowsY, rows, sizeof(rows) / sizeof(rows[0]));
+      draw_text_button(kLeftButtonX, kRunY, kButtonWidth,
+                       running ? "STOP SERVER" : "RUN SERVER");
+      draw_text_button(kRightButtonX, kRunY, kButtonWidth, "START GAME",
+                       joined && !starting);
+      draw_text_button(kButtonX, kCancelY, kButtonWidth, "CANCEL");
+      break;
+    }
+    case ViewJoin: {
+      bool searching = state == LanLink::StateSearching;
+      frame->draw_string(kListX, 24, searching ? "Searching the network..."
+                                               : "Servers found",
+                         Color::green, Color::black);
+      frame->fill_rect(kListX, kListY, kListW, kListH, Color::black);
+      if (servers.empty() && !searching) {
+        frame->draw_string(kListX + 4, kListY + 4, "None - SEARCH or type",
+                           Color::green);
+        frame->draw_string(kListX + 4, kListY + 12, "the address below.",
+                           Color::green);
+      }
+      for (size_t i = 0; i < servers.size() && i < kListRows; i++) {
+        const LanLink::Server &s = servers[i];
+        int y = kListY + 2 + 8 * static_cast<int>(i);
+        bool same = s.same_version;
+        Color c = same ? Color::green : Color(0x99, 0x99, 0x99);
+        frame->draw_string(kListX + 4, y, s.name, c);
+        std::string a = s.address + (same ? "" : " (" + s.version + ")");
+        frame->draw_string(kListX + 4 + 136, y, a, c);
+      }
+      draw_text_button(kSearchX, kSearchY, kSearchW, "SEARCH", !searching);
+      frame->draw_string(kLabelX, kJoinNameY, "Your name", Color::green,
+                         Color::black);
+      frame->draw_string(kLabelX, kAddressY, "Server address", Color::green,
+                         Color::black);
+      bool connecting = state == LanLink::StateConnecting;
+      draw_text_button(kLeftButtonX, kJoinButtonsY, kButtonWidth,
+                       connecting ? "CONNECTING" : "CONNECT", !connecting);
+      draw_text_button(kRightButtonX, kJoinButtonsY, kButtonWidth, "BACK");
+      break;
+    }
+    case ViewJoined: {
+      draw_centered(26, "Connected. Waiting for the");
+      draw_centered(36, "server to start the game.");
+      const std::string rows[][2] = {
+        { "Server name", link()->get_peer_name() },
+        { "Server address", link()->get_peer_address() },
+        { "", "" },
+        { "Your name", player_name_field->get_text() },
+        { "Your address", own_address.empty() ? "-" : own_address },
+        { "Response", ping_text() },
+      };
+      draw_rows(kRowsY + 20, rows, sizeof(rows) / sizeof(rows[0]));
+      draw_text_button(kButtonX, kCancelY, kButtonWidth, "DISCONNECT");
+      break;
+    }
+  }
+
+  if (!message.empty()) {
+    draw_centered(kMessageY, message);
+  }
+
+  frame->draw_sprite(width - 8 - kExitSize, height - 7 - kExitSize,
+                     Data::AssetIcon, 60);  // Exit
+}
+
+bool
+LanBox::handle_click_left(int x, int y) {
+  int exit_x = width - 8 - kExitSize;
+  int exit_y = height - 7 - kExitSize;
+  if (inside(x, y, exit_x, exit_y, kExitSize, kExitSize)) {
+    play_sound(Audio::TypeSfxClick);
+    interface->close_lan_box();  /* Deletes this box. */
+    return true;
+  }
+
+  LanLink *l = link();
+  LanLink::State state = link_state();
+  switch (view) {
+    case ViewChoose:
+      if (inside(x, y, kButtonX, kServerButtonY, kButtonWidth,
+                 kButtonHeight)) {
+        play_sound(Audio::TypeSfxClick);
+        set_view(ViewServer);
+      } else if (inside(x, y, kButtonX, kJoinButtonY, kButtonWidth,
+                        kButtonHeight)) {
+        play_sound(Audio::TypeSfxClick);
+        set_view(ViewJoin);
+      }
+      break;
+    case ViewServer:
+      if (inside(x, y, kLeftButtonX, kRunY, kButtonWidth, kButtonHeight)) {
+        play_sound(Audio::TypeSfxClick);
+        message.clear();
+        if (l == nullptr) {
+          message = kNoNetwork;
+        } else if (state == LanLink::StateIdle) {
+          l->start_server(server_name_field->get_text());
+        } else {
+          l->close();
+        }
+        set_redraw();
+      } else if (inside(x, y, kRightButtonX, kRunY, kButtonWidth,
+                        kButtonHeight)) {
+        if (state != LanLink::StateConnected || starting) {
+          play_sound(Audio::TypeSfxNotAccepted);
+        } else {
+          play_sound(Audio::TypeSfxClick);
+          std::string setup = std::to_string(mission->get_map_size()) + " " +
+                              std::string(mission->get_random_base());
+          l->send(MessageSetup, setup);
+          starting = true;
+          message = "Starting the game...";
+          set_redraw();
+        }
+      } else if (inside(x, y, kButtonX, kCancelY, kButtonWidth,
+                        kButtonHeight)) {
+        play_sound(Audio::TypeSfxClick);
+        set_view(ViewChoose);
+      }
+      break;
+    case ViewJoin:
+      if (inside(x, y, kListX, kListY, kListW, kListH)) {
+        size_t row = static_cast<size_t>((y - kListY - 2) / 8);
+        if (y >= kListY + 2 && row < servers.size()) {
+          play_sound(Audio::TypeSfxClick);
+          address_field->set_text(servers[row].address);
+        }
+      } else if (inside(x, y, kSearchX, kSearchY, kSearchW, kButtonHeight)) {
+        if (l == nullptr || state == LanLink::StateSearching) {
+          play_sound(Audio::TypeSfxNotAccepted);
+          message = l == nullptr ? kNoNetwork : "";
+        } else {
+          play_sound(Audio::TypeSfxClick);
+          message.clear();
+          servers.clear();
+          l->search();
+        }
+        set_redraw();
+      } else if (inside(x, y, kLeftButtonX, kJoinButtonsY, kButtonWidth,
+                        kButtonHeight)) {
+        std::string address = address_field->get_text();
+        if (l == nullptr || address.empty() ||
+            state == LanLink::StateConnecting) {
+          play_sound(Audio::TypeSfxNotAccepted);
+          message = l == nullptr ? kNoNetwork
+                    : address.empty() ? "Type the server address." : "";
+        } else {
+          play_sound(Audio::TypeSfxClick);
+          message = "Connecting to " + address + "...";
+          l->connect(address, player_name_field->get_text());
+        }
+        set_redraw();
+      } else if (inside(x, y, kRightButtonX, kJoinButtonsY, kButtonWidth,
+                        kButtonHeight)) {
+        play_sound(Audio::TypeSfxClick);
+        set_view(ViewChoose);
+      }
+      break;
+    case ViewJoined:
+      if (inside(x, y, kButtonX, kCancelY, kButtonWidth, kButtonHeight)) {
+        play_sound(Audio::TypeSfxClick);
+        set_view(ViewJoin);
+      }
+      break;
+  }
+  return true;
+}
