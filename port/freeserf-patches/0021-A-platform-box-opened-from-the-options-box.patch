From 54e0159b0781aefd2392c2f1de41917b0575c458 Mon Sep 17 00:00:00 2001
From: cizar-szymon <szymon@cs-lab.eu>
Date: Mon, 26 Oct 2026 09:17:16 +0100
Subject: [PATCH 21/22] A platform box opened from the options box

Next to Advanced the options box shows a button for a box of the
platform when Interface::platform_box_factory is set (with the box's
size for the layout). The Amiga port uses it for its Amiga box (the
computer and its accelerator); without a factory nothing changes.
---
 src/interface.cc | 35 +++++++++++++++++++++++++++++++++++
 src/interface.h  | 12 ++++++++++++
 src/popup.cc     |  9 +++++++++
 3 files changed, 56 insertions(+)

diff --git a/src/interface.cc b/src/interface.cc
index ba67e62..4fad761 100644
--- a/src/interface.cc
+++ b/src/interface.cc
@@ -102,6 +102,7 @@ Interface::Interface()
   init_box = nullptr;
   advanced_box = nullptr;
   keys_box = nullptr;
+  platform_box = nullptr;
   notification_box = nullptr;
 
   GameManager::get_instance().add_handler(this);
@@ -118,6 +119,7 @@ Interface::~Interface() {
   delete init_box;
   delete advanced_box;
   delete keys_box;
+  delete platform_box;
   delete notification_box;
 }
 
@@ -299,6 +301,33 @@ Interface::open_keys_box() {
   layout();
 }
 
+Interface::PlatformBoxFactory Interface::platform_box_factory;
+int Interface::platform_box_width = 0;
+int Interface::platform_box_height = 0;
+
+void
+Interface::open_platform_box() {
+  if (!platform_box_factory) return;
+  if (platform_box == nullptr) {
+    platform_box = platform_box_factory(this);
+    add_float(platform_box, 0, 0);
+  }
+  platform_box->set_displayed(true);
+  platform_box->set_enabled(true);
+  layout();
+}
+
+void
+Interface::close_platform_box() {
+  if (platform_box != nullptr) {
+    platform_box->set_displayed(false);
+    del_float(platform_box);
+    delete platform_box;
+    platform_box = nullptr;
+  }
+  layout();
+}
+
 void
 Interface::close_keys_box() {
   if (keys_box != nullptr) {
@@ -1001,6 +1030,11 @@ Interface::layout() {
                       (height - KeysBox::kHeight) / 2);
   }
 
+  if (platform_box != nullptr) {
+    platform_box->move_to((width - platform_box_width) / 2,
+                          (height - platform_box_height) / 2);
+  }
+
   if (advanced_box != nullptr) {
     advanced_box->move_to((width - AdvancedBox::kWidth) / 2,
                           (height - AdvancedBox::kHeight) / 2);
@@ -1248,6 +1282,7 @@ Interface::draw_pause(Frame *frame) {
   /* Not over a box: it would hide its text. */
   if ((popup != nullptr && popup->is_displayed()) ||
       (keys_box != nullptr && keys_box->is_displayed()) ||
+      (platform_box != nullptr && platform_box->is_displayed()) ||
       (advanced_box != nullptr && advanced_box->is_displayed()) ||
       (init_box != nullptr && init_box->is_displayed())) {
     return;
diff --git a/src/interface.h b/src/interface.h
index 960e3fa..3d61b0c 100644
--- a/src/interface.h
+++ b/src/interface.h
@@ -22,6 +22,7 @@
 #ifndef SRC_INTERFACE_H_
 #define SRC_INTERFACE_H_
 
+#include <functional>
 #include <string>
 
 #include "src/misc.h"
@@ -100,6 +101,7 @@ class Interface : public GuiObject, public GameManager::Handler {
   GameInitBox *init_box;
   AdvancedBox *advanced_box;
   KeysBox *keys_box;
+  GuiObject *platform_box;
   NotificationBox *notification_box;
 
   MapPos map_cursor_pos;
@@ -243,6 +245,16 @@ class Interface : public GuiObject, public GameManager::Handler {
   void close_advanced();
   void open_keys_box();
   void close_keys_box();
+
+  /* A box of the platform, opened by a button next to Advanced in the
+     options box (the Amiga port: the Amiga and its accelerator). Without a
+     factory there is no button. */
+  typedef std::function<GuiObject *(Interface *)> PlatformBoxFactory;
+  static PlatformBoxFactory platform_box_factory;
+  static int platform_box_width;
+  static int platform_box_height;
+  void open_platform_box();
+  void close_platform_box();
   void draw_pause(Frame *frame);
 
   void open_message();
diff --git a/src/popup.cc b/src/popup.cc
index 1bf536d..e03ef0f 100644
--- a/src/popup.cc
+++ b/src/popup.cc
@@ -208,6 +208,7 @@ typedef enum Action {
   ActionShowOptions,
   ACTION_SHOW_SAVE,
   ActionShowKeysInfo,
+  ActionShowPlatform,
   ACTION_SETT_8_CYCLE,
   ACTION_CLOSE_OPTIONS,
   ACTION_OPTIONS_PATHWAY_SCROLLING_1,
@@ -2041,6 +2042,10 @@ PopupBox::draw_options_box() {
 
   /* Advanced options (not in the original game) */
   frame->draw_resource_image(8 * 0 + 8, 128 + 9, "button-advanced.png");
+  /* And the platform's box (the Amiga port: "Amiga"). */
+  if (Interface::platform_box_factory) {
+    frame->draw_resource_image(8 * 7 + 8, 128 + 9, "button-amiga.png");
+  }
   draw_popup_icon(14, 128, 60); /* exit */
 }
 
@@ -3591,6 +3596,9 @@ PopupBox::handle_action(int action, int x_, int /*y_*/) {
   case ActionShowKeysInfo:
     interface->open_keys_box();
     break;
+  case ActionShowPlatform:
+    interface->open_platform_box();
+    break;
   case ActionShowOptions:
     interface->open_popup(TypeOptions);
     break;
@@ -3930,6 +3938,7 @@ PopupBox::handle_box_options_clk(int cx, int cy) {
     ACTION_OPTIONS_MESSAGE_COUNT_1, 90, 90, 32, 16,
     ACTION_CLOSE_OPTIONS, 112, 126, 16, 16,
     ACTION_OPTIONS_ADVANCED, 0, 126, 56, 16,
+    ActionShowPlatform, 56, 126, 38, 16,
 #ifdef __AMIGA__
     ACTION_OPTIONS_SCREEN_PREV, 90, 106, 16, 16,
     ACTION_OPTIONS_SCREEN_NEXT, 106, 106, 16, 16,
-- 
