     ActionApplyRandom ,    244,  24, 16, 24,
-    ActionClose,           308, 216, 32, 16,
+    ActionClose,           308, 224, 32, 16,
     -1
   };
 
@@ -625,7 +627,7 @@ GameInitBox::handle_click_left(int cx, int cy) {
     ActionStartGame,        20,  16, 32, 32,
     ActionToggleGameType,   60,  16, 32, 32,
     ActionShowOptions,     308,  16, 32, 32,
-    ActionClose,           308, 216, 32, 16,
+    ActionClose,           308, 224, 32, 16,
     -1
   };
   const int clickmap_load_delete[] = {
@@ -633,7 +635,7 @@ GameInitBox::handle_click_left(int cx, int cy) {
     ActionToggleGameType,   60,  16, 32, 32,
     ActionShowOptions,     308,  16, 32, 32,
     ActionDeleteSave, kDeleteX, kDeleteY, kDeleteWidth, 16,
-    ActionClose,           308, 216, 32, 16,
+    ActionClose,           308, 224, 32, 16,
     -1
   };
   const int clickmap_load_question[] = {
