Subject: [PATCH 34/42] Start box: the click area of Quit on the button (it was
 8 pixels higher)

---
 src/game-init.cc | 12 +++++++-----
 1 file changed, 7 insertions(+), 5 deletions(-)

diff --git a/src/game-init.cc b/src/game-init.cc
index dd5df78..aaf6c80 100644
--- a/src/game-init.cc
+++ b/src/game-init.cc
@@ -360,7 +360,9 @@ GameInitBox::internal_draw() {
   /* Display program name and version in caption */
   draw_box_string(0, 212, FREESERF_VERSION);
 
-  draw_box_icon(36, 208, 286); /* quit, as wide as the Quit of the game */
+  /* Quit, as wide as the Quit of the game; at 308,224 of the box (its
+     click area too - it was at 216, only the upper half answered). */
+  draw_box_icon(36, 208, 286);
 }
 
