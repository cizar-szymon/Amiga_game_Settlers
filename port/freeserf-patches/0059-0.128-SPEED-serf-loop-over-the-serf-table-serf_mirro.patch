+
+/* The state, type and inventory of this serf in the table of the game
+   (Game::serf_mirror): update_serfs reads it instead of this object for a
+   serf idle in a stock (Amiga port: thousands of serfs, a 68060 waits for
+   memory on each). Called on every change of these. */
+void
+Serf::sync_mirror() {
+  game->set_serf_mirror(index, state, type, s.idle_in_stock.inv_index);
 }
 
 /* Change type of serf and update all global tables
@@ -322,6 +334,7 @@ Serf::set_type(Serf::Type new_type) {
 
