diff --git a/src/game.h b/src/game.h
index c093605..f52ac51 100644
--- a/src/game.h
+++ b/src/game.h
@@ -83,7 +83,34 @@ class Game {
   Flags flags;
   Inventories inventories;
   /* The serfs to update in a step (update_serfs). */
-  std::vector<unsigned int> serf_update_indexes;
+  /* update_serfs goes through the indexes in use when it starts: a serf
+     made while it runs in a place free at its start is marked 2 (not
+     updated in this step), a place freed while it runs 1 (a serf made there
+     is updated, as one that was there at the start). */
+  bool in_serf_loop;
+  std::vector<uint8_t> serf_loop_mark;
+  std::vector<unsigned int> serf_loop_marked;
+  void serf_loop_note(unsigned int index, uint8_t mark);
+ public:
+  /* Of each serf by index: state (bits 0-7), type (8-15), inventory of an
+     idle serf (16-31); ~0 unknown. Serf::sync_mirror keeps it. */
+  std::vector<uint32_t> serf_mirror;
+  void set_serf_mirror(unsigned int index, int state, int type,
+                       unsigned int inventory) {
+    if (index >= serf_mirror.size()) {
+      serf_mirror.resize(index + 256, 0xffffffffu);
+    }
+    serf_mirror[index] = (static_cast<uint32_t>(state) & 0xff) |
+                         ((static_cast<uint32_t>(type) & 0xff) << 8) |
+                         ((inventory & 0xffff) << 16);
+  }
+  /* simtest -V: the table checked against the serfs every step. */
+  static bool serf_mirror_verify;
+  static unsigned long serf_mirror_errors;
+  void clear_serf_mirror(unsigned int index) {
+    if (index < serf_mirror.size()) serf_mirror[index] = 0xffffffffu;
+  }
+ protected:
   std::vector<unsigned int> land_part;
   unsigned int land_parts_version = 0;
   Buildings buildings;
diff --git a/src/gfx.cc b/src/gfx.cc
index b3aa4bf..aad6242 100644
--- a/src/gfx.cc
+++ b/src/gfx.cc
@@ -101,23 +101,39 @@ Image::ImageCache Image::image_cache;
    getting them decoded the sprite again, for every head in every frame. */
 static std::unordered_map<uint32_t, std::pair<int, int>> sprite_deltas;
 
+Image::Front Image::front[Image::kFront];
+
 void
 Image::cache_image(uint64_t id, Image *image) {
   image_cache[id] = image;
+  uint32_t hi = static_cast<uint32_t>(id >> 32);
+  uint32_t lo = static_cast<uint32_t>(id);
+  Front &f = front[front_slot(hi, lo)];
+  f.hi = hi;
+  f.lo = lo;
+  f.image = image;
 }
 
 /* Return a pointer to the sprite pointer associated with id. */
 Image *
 Image::get_cached_image(uint64_t id) {
+  uint32_t hi = static_cast<uint32_t>(id >> 32);
+  uint32_t lo = static_cast<uint32_t>(id);
+  Front &f = front[front_slot(hi, lo)];
+  if (f.image != nullptr && f.hi == hi && f.lo == lo) return f.image;
   ImageCache::iterator result = image_cache.find(id);
   if (result == image_cache.end()) {
     return nullptr;
   }
+  f.hi = hi;
+  f.lo = lo;
+  f.image = result->second;
   return result->second;
 }
 
 void
 Image::clear_cache() {
+  std::memset(front, 0, sizeof(front));
   while (!image_cache.empty()) {
     Image *image = image_cache.begin()->second;
     image_cache.erase(image_cache.begin());
@@ -206,7 +222,14 @@ Frame::draw_sprite(int x, int y, Data::Resource res, unsigned int index,
                             color.get_green(),
                             color.get_red(),
                             color.get_alpha()};
-  uint64_t id = Data::Sprite::create_id(res, index, 0, 0, pc);
+  /* Data::Sprite::create_id(res, index, 0, 0, pc), made here: the call
+     takes 64-bit arguments. */
+  uint64_t id = (static_cast<uint64_t>(
+                   ((static_cast<uint32_t>(res) & 0xff) << 24) |
+                   ((static_cast<uint32_t>(index) & 0xfff) << 12)) << 32) |
+                ((static_cast<uint32_t>(pc.red) << 16) |
+                 (static_cast<uint32_t>(pc.green) << 8) |
+                 static_cast<uint32_t>(pc.blue));
   Image *image = Image::get_cached_image(id);
   if (image == nullptr) {
     Data::PSprite s = data_source->get_sprite(res, index, pc);
@@ -227,7 +250,9 @@ Frame::draw_sprite(int x, int y, Data::Resource res, unsigned int index,
   /* Almost always whole: no float arithmetic then (in software on a CPU
      without an FPU). */
   int y_off = 0;
-  if (progress < 1.f) {
+  uint32_t progress_bits;
+  std::memcpy(&progress_bits, &progress, sizeof(progress_bits));
+  if (progress_bits != 0x3f800000u && progress < 1.f) {  /* not 1.0 */
     y_off = image->get_height() - static_cast<int>(image->get_height() *
                                                    progress);
   }
diff --git a/src/gfx.h b/src/gfx.h
index a2a0b3d..e7fd26a 100644
--- a/src/gfx.h
+++ b/src/gfx.h
@@ -103,6 +103,18 @@ class Image {
   };
   typedef std::unordered_map<uint64_t, Image*, IdHash> ImageCache;
   static ImageCache image_cache;
+  /* In front of it, a table by a few bits of the id: most sprites of a
+     frame are found at the first try, without the hash table's buckets and
+     nodes (a 68060 waited for memory on each, ~600 sprites a frame). */
+  struct Front {
+    uint32_t hi, lo;
+    Image *image;
+  };
+  static const unsigned int kFront = 1024;
+  static Front front[kFront];
+  static unsigned int front_slot(uint32_t hi, uint32_t lo) {
+    return (hi ^ (hi >> 11) ^ lo ^ (lo >> 7) ^ (lo >> 15)) & (kFront - 1);
+  }
 
  public:
   Image(Video *video, Data::PSprite sprite);
