From 809bdcc9cc61466871fa4469c9aa95948f3999aa Mon Sep 17 00:00:00 2001
From: cizar-szymon <szymon@cs-lab.eu>
Date: Sat, 7 Nov 2026 19:35:31 +0100
Subject: [PATCH] 0.128 SPEED: serf loop over the serf table (serf_mirror)
 without a list of indexes, serfs made or freed during the loop marked, no
 table update after a serf's own update (it may delete itself), image lookup
 through a direct table in front of the hash table, sprite id without the
 64-bit call

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01J7U35RuKvTQMs84jNJEFhT
---
 src/game.cc     | 128 ++++++++++++++++++++++++++++++++++++++----------
 src/game.h      |  29 ++++++++++-
 src/gfx.cc      |  29 ++++++++++-
 src/gfx.h       |  12 +++++
 src/inventory.h |   5 ++
 src/serf.cc     |  24 ++++++++-
 src/serf.h      |   3 ++
 7 files changed, 200 insertions(+), 30 deletions(-)

diff --git a/src/game.cc b/src/game.cc
index 3c0d7dd..7359ad8 100644
--- a/src/game.cc
+++ b/src/game.cc
@@ -108,6 +108,7 @@ Game::Game()
   inventory_schedule_counter = 0;
 
   gold_total = 0;
+  in_serf_loop = false;
 }
 
 Game::~Game() {
@@ -641,28 +642,88 @@ Game::update_buildings() {
 void
 Game::update_serfs() {
   /* Updating a serf can delete other serfs (e.g. a lost fight) or create
-     new ones, which invalidates iterators of the collection. Go through
-     the indexes taken before and skip serfs deleted in the meantime. */
-  /* Kept between the steps (no allocation of thousands of elements on
-     every step; only the update below uses it, not recursively). */
-  std::vector<unsigned int> &indexes = serf_update_indexes;
-  serfs.get_indexes(&indexes);
-
-  for (unsigned int index : indexes) {
-    Serf *serf = serfs[index];
-    /* index 0 is the dummy serf; an object is at its own index */
-    if (serf != nullptr && index != 0) {
-      if (game_prof_detail_ms) {
-        int st = serf->get_state() & 63;
-        unsigned long p0 = game_prof_detail_ms();
-        serf->update();
-        game_prof_serf[st] += game_prof_detail_ms() - p0;
-        game_prof_serf_n[st]++;
-      } else {
-        serf->update();
+     new ones. The serfs there at the start are updated, in the order of
+     their indexes, those deleted in the meantime skipped - by the table of
+     the serfs (serf_mirror: none where ~0) and the places marked while
+     this runs (in_serf_loop), not a list of the indexes made first: a
+     68060 waited for memory on every one of thousands of serfs. The table
+     and the marks are read through locals, read again after each update
+     (only an update can move them): the compiler read them again for every
+     serf, as a write to a stock might have changed them. */
+  const unsigned int n = serfs.get_max_index();
+  const bool verify = serf_mirror_verify;
+  unsigned long (*const detail)() = game_prof_detail_ms;
+  in_serf_loop = true;
+  if (verify) {
+    for (unsigned int index = 1; index < n; index++) {
+      bool in_table = index < serf_mirror.size() &&
+                      serf_mirror[index] != 0xffffffffu;
+      if (in_table != (serfs[index] != nullptr)) serf_mirror_errors++;
+    }
+  }
+
+  const uint32_t *table = serf_mirror.data();
+  unsigned int table_n = static_cast<unsigned int>(serf_mirror.size());
+  bool marks = false;
+  /* index 0 is the dummy serf; an object is at its own index */
+  for (unsigned int index = 1; index < n; index++) {
+    if (index >= table_n) break;  /* no serf past the table */
+    uint32_t m = table[index];
+    if (m == 0xffffffffu) continue;
+    if (marks && index < serf_loop_mark.size() &&
+        serf_loop_mark[index] == 2) {
+      continue;  /* made while this runs */
+    }
+    if (verify) {
+      Serf *serf = serfs[index];
+      if (serf == nullptr) {
+        serf_mirror_errors++;
+        continue;
+      }
+      bool idle = serf->get_state() == Serf::StateIdleInStock;
+      if ((m & 0xff) != (static_cast<uint32_t>(serf->get_state()) & 0xff) ||
+          ((m >> 8) & 0xff) !=
+            (static_cast<uint32_t>(serf->get_type()) & 0xff) ||
+          (idle && (m >> 16) != (serf->get_idle_inventory() & 0xffff))) {
+        serf_mirror_errors++;
       }
     }
+    /* A serf idle in a stock, as handle_serf_idle_in_stock_state would do
+       it, from the table alone (its object not read): the stock keeps it
+       as the serf of its type; a knight 0-3 (training), a stock sending
+       serfs out and every other state: the update itself. */
+    if (detail == nullptr && (m & 0xff) == Serf::StateIdleInStock) {
+      int type = static_cast<int8_t>((m >> 8) & 0xff);
+      if (type < Serf::TypeKnight0 || type > Serf::TypeKnight3) {
+        Inventory *inventory = inventories[m >> 16];
+        if (inventory->get_serf_mode() == 0 ||
+            inventory->get_serf_mode() == 1 ||
+            inventory->get_serf_queue_length() >= 3) {
+          if (type != Serf::TypeSmelter) {
+            inventory->set_idle_serf(static_cast<Serf::Type>(type), index);
+          }
+          continue;
+        }
+      }
+    }
+    Serf *serf = serfs[index];
+    if (serf == nullptr) continue;
+    if (detail != nullptr) {
+      int st = serf->get_state() & 63;
+      unsigned long p0 = detail();
+      serf->update();
+      game_prof_serf[st] += detail() - p0;
+      game_prof_serf_n[st]++;
+    } else {
+      serf->update();
+    }
+    table = serf_mirror.data();
+    table_n = static_cast<unsigned int>(serf_mirror.size());
+    marks = !serf_loop_marked.empty();
   }
+  in_serf_loop = false;
+  for (unsigned int index : serf_loop_marked) serf_loop_mark[index] = 0;
+  serf_loop_marked.clear();
 }
 
 /* Update historical player statistics for one measure. */
@@ -935,6 +996,8 @@ Game::update_game_stats() {
 /* Profiling (the Amiga port's simtest -p): when game_prof_ms is set, the
    milliseconds of the parts of update() add up in game_prof. */
 unsigned long (*game_prof_detail_ms)() = nullptr;  /* per object (-P) */
+bool Game::serf_mirror_verify = false;
+unsigned long Game::serf_mirror_errors = 0;
 unsigned long (*game_prof_ms)() = nullptr;
 unsigned long game_prof[64];
 /* Serfs by state (simtest -p): time and count of updates. */
@@ -2717,16 +2780,31 @@ Game::next_search_id() {
 
 Serf *
 Game::create_serf(int index) {
-  if (index == -1) {
-    return serfs.allocate();
-  } else {
-    return serfs.get_or_insert(index);
-  }
+  Serf *serf = index == -1 ? serfs.allocate() : serfs.get_or_insert(index);
+  if (in_serf_loop) serf_loop_note(serf->get_index(), 2);
+  return serf;
 }
 
 void
 Game::delete_serf(Serf *serf) {
-  serfs.erase(serf->get_index());
+  unsigned int index = serf->get_index();
+  serfs.erase(index);
+  clear_serf_mirror(index);
+  if (in_serf_loop) serf_loop_note(index, 1);
+}
+
+/* A place made or freed while update_serfs runs (see in_serf_loop): the
+   first of the two counts - a place freed and used again was in use at
+   the start. */
+void
+Game::serf_loop_note(unsigned int index, uint8_t mark) {
+  if (index >= serf_loop_mark.size()) {
+    serf_loop_mark.resize(index + 256, 0);
+  }
+  if (serf_loop_mark[index] == 0) {
+    serf_loop_mark[index] = mark;
+    serf_loop_marked.push_back(index);
+  }
 }
 
