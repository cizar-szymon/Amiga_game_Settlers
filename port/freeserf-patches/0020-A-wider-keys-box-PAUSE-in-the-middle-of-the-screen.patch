+/* The keys of the game (the I button of the settings box, the I key): over
+   whatever is open, which it leaves as it was. */
+void
+Interface::open_keys_box() {
+  if (keys_box == nullptr) {
+    keys_box = new KeysBox(this);
+    add_float(keys_box, 0, 0);
+  }
+  keys_box->set_displayed(true);
+  keys_box->set_enabled(true);
+  layout();
+}
+
+void
+Interface::close_keys_box() {
+  if (keys_box != nullptr) {
+    keys_box->set_displayed(false);
+    del_float(keys_box);
+    delete keys_box;
+    keys_box = nullptr;
+  }
+  layout();
+}
