+
+#include "src/keys-box.h"
+
+#include <string>
+
+#include "src/interface.h"
+#include "src/popup.h"
+#include "src/box-frame.h"
+#include "src/audio.h"
+#include "src/data.h"
+
+static const int kExitWidth = 16;
+static const int kExitHeight = 16;
+static const int kKeyX = 16;
+static const int kTextX = 104;
+static const int kFirstRowY = 22;
+static const int kRowHeight = 10;
+
+static const struct {
+  const char *key;
+  const char *text;
+} keys[] = {
+  { "+", "Game speed up" },
+  { "-", "Game speed down" },
+  { "0", "Normal speed" },
+  { "Z", "Zoom" },
+  { "Wheel", "Zoom in and out" },
+  { "P", "Pause" },
+  { "M", "Music on-off" },
+  { "S", "Sound on-off" },
+  { "Ctrl+Z", "Quick save" },
+  { "F9", "Screenshot" },
+  { "I", "This box" },
+  { "Shift+Esc", "Quit" }
+};
+
+KeysBox::KeysBox(Interface *_interface)
+  : interface(_interface) {
+  set_size(kWidth, kHeight);
+}
+
+/* The game's font has no '+': drawn, with a shadow like the letters. */
+static void
+draw_plus(Frame *frame, int x, int y) {
+  frame->fill_rect(x + 2, y + 4, 6, 2, Color::black);
+  frame->fill_rect(x + 4, y + 2, 2, 6, Color::black);
+  frame->fill_rect(x + 1, y + 3, 6, 2, Color::green);
+  frame->fill_rect(x + 3, y + 1, 2, 6, Color::green);
+}
+
+void
+KeysBox::internal_draw() {
+  for (int y = 0; y < height; y += 16) {
+    for (int x = 0; x < width; x += 16) {
+      frame->draw_sprite(x, y, Data::AssetIcon,
+                         PopupBox::PatternDiagonalGreen);
+    }
+  }
+  draw_box_frame(frame, width, height);
+
+  std::string title = "Keys";
+  frame->draw_string((width - frame->get_string_width(title)) / 2, 9, title,
+                     Color::green, Color::black);
+  int y = kFirstRowY;
+  for (const auto &k : keys) {
+    std::string key = k.key;
+    std::string with_spaces = key;
+    for (char &c : with_spaces) {
+      if (c == '+') c = ' ';
+    }
+    frame->draw_string(kKeyX, y, with_spaces, Color::green, Color::black);
+    for (std::string::size_type i = 0; i < key.size(); i++) {
+      if (key[i] == '+') {
+        draw_plus(frame, kKeyX + 8 * static_cast<int>(i), y);
+      }
+    }
+    frame->draw_string(kTextX, y, k.text, Color::green, Color::black);
+    y += kRowHeight;
+  }
+
+  frame->draw_sprite(width - 8 - kExitWidth, height - 7 - kExitHeight,
+                     Data::AssetIcon, 60);  // Exit
+}
+
+bool
+KeysBox::handle_click_left(int x, int y) {
+  int exit_x = width - 8 - kExitWidth;
+  int exit_y = height - 7 - kExitHeight;
+  if (x >= exit_x && x < exit_x + kExitWidth &&
+      y >= exit_y && y < exit_y + kExitHeight) {
+    play_sound(Audio::TypeSfxClick);
+    interface->close_keys_box();
+  }
+  return true;
+}
