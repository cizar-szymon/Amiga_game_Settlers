+/* PAUSE in large letters in the middle of the screen while the game is
+   paused (P): yellow with a dark shadow, the letters drawn from 5x7 dot
+   patterns, each dot 6 pixels. */
+void
+Interface::draw_pause(Frame *frame) {
+  if (!game || !game->is_paused()) return;
+  /* Not over a box: it would hide its text. */
+  if ((popup != nullptr && popup->is_displayed()) ||
+      (keys_box != nullptr && keys_box->is_displayed()) ||
+      (advanced_box != nullptr && advanced_box->is_displayed()) ||
+      (init_box != nullptr && init_box->is_displayed())) {
+    return;
+  }
+  static const char *const kLetters[5][7] = {
+    { "#### ", "#   #", "#   #", "#### ", "#    ", "#    ", "#    " },  // P
+    { " ### ", "#   #", "#   #", "#####", "#   #", "#   #", "#   #" },  // A
+    { "#   #", "#   #", "#   #", "#   #", "#   #", "#   #", " ### " },  // U
+    { " ####", "#    ", "#    ", " ### ", "    #", "    #", "#### " },  // S
+    { "#####", "#    ", "#    ", "#### ", "#    ", "#    ", "#####" }   // E
+  };
+  const int dot = 6, gap = 2 * dot;
+  const int letter_w = 5 * dot, text_w = 5 * letter_w + 4 * gap;
+  const int x0 = (width - text_w) / 2, y0 = (height - 7 * dot) / 2;
+  for (int pass = 0; pass < 2; pass++) {
+    Color c = (pass == 0) ? Color::black : Color(0xdd, 0xdd, 0x00);
+    int off = (pass == 0) ? dot / 2 : 0;
+    for (int l = 0; l < 5; l++) {
+      for (int r = 0; r < 7; r++) {
+        for (int col = 0; col < 5; col++) {
+          if (kLetters[l][r][col] != '#') continue;
+          frame->fill_rect(x0 + l * (letter_w + gap) + col * dot + off,
+                           y0 + r * dot + off, dot, dot, c);
+        }
+      }
+    }
+  }
+}
+
 /* Called periodically when the game progresses. */
