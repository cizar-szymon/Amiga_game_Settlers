+bool
+GameManager::load_game_text(const std::string &text) {
+  PGame new_game = std::make_shared<Game>();
+  std::istringstream in(text);
+  if (!GameStore::get_instance().read(&in, new_game.get())) {
+    return false;
+  }
+  /* A game read from a save is paused (its speed is not kept); both sides
+     go on at the normal speed, at the same step. */
+  new_game->speed_reset();
+  set_current_game(new_game);
+  return true;
+}
