+void
+LanBox::receive_save(int type, const std::string &data) {
+  if (type == LanGame::MessageSaveBegin) {
+    std::istringstream s(data);
+    save_in.clear();
+    save_size = 0;
+    s >> save_size >> save_sum >> save_delay;
+    save_in.reserve(save_size);
+  } else if (type == LanGame::MessageSaveData) {
+    save_in += data;
+  } else {
+    message = "The saved game came broken.";
+    save_size = 0;
+    return;
+  }
+  if (save_size != 0) {
+    message = "Receiving the game... " +
+              std::to_string(save_in.size() * 100 / save_size) + "%";
+  }
+}
+
+void
+LanBox::go_on_with_save(const std::string &path) {
+  set_view(ViewServer);
+  use_saved_game(path);
+  set_redraw();
+}
+
+bool
+LanBox::is_lan_save(const std::string &path) {
+  Game game;
+  if (path.empty() || !GameStore::get_instance().load(path, &game)) {
+    return false;
+  }
+  Player *other = game.get_player(1);
+  return other != nullptr && !other->is_ai();
+}
+
+bool
+LanBox::use_saved_game(const std::string &path) {
+  Game game;
+  if (path.empty() || !GameStore::get_instance().load(path, &game)) {
+    message = "Choose a saved game.";
+    return false;
+  }
+  Player *other = game.get_player(1);
+  if (other == nullptr || other->is_ai()) {
+    message = "Player 2 is not a person there.";
+    return false;
+  }
+  save_path = path;
+  size_t slash = path.find_last_of("/\\:");
+  save_name = (slash == std::string::npos) ? path : path.substr(slash + 1);
+  save_map_size = game.get_map()->get_size();
+  return true;
+}
