+void
+LanGame::send_save(const std::string &save) {
+  save_out = save;
+  save_sent = 0;
+  save_begun = false;
+}
+
+/* As many pieces as the link takes now; the rest in the next update. */
+bool
+LanGame::pump_save() {
+  if (save_out.empty()) return true;
+  if (link == nullptr || gone) {
+    save_out.clear();
+    return true;
+  }
+  static const size_t kPiece = LanLink::kMaxData - 10;
+  if (!save_begun) {
+    std::string begin = std::to_string(save_out.size()) + " " +
+                        std::to_string(lan_data_checksum(save_out)) + " " +
+                        std::to_string(delay);
+    if (!link->send(MessageSaveBegin, begin)) return false;
+    save_begun = true;
+  }
+  while (save_sent < save_out.size()) {
+    size_t n = std::min(kPiece, save_out.size() - save_sent);
+    if (!link->send(MessageSaveData, save_out.substr(save_sent, n))) {
+      return false;
+    }
+    save_sent += n;
+  }
+  if (!link->send(MessageSaveEnd, std::string())) return false;
+  save_out.clear();
+  return true;
+}
+
