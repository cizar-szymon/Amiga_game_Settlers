   layout();
 }
 
+bool
+Interface::start_lan_game_from_save(const std::string &save, bool server,
+                                    unsigned int delay) {
+  if (!GameManager::get_instance().load_game_text(save)) {
+    return false;
+  }
+  lan_game.reset(new LanGame(this, lan_link, server, delay));
+  if (server) {
+    lan_game->send_save(save);
+  } else {
+    set_player(1);
+  }
+  close_lan_box();
+  close_game_init();
+  lan_game->started();
+  return true;
+}
