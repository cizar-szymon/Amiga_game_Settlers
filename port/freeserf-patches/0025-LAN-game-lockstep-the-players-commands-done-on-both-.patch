+#include "src/lan-command.h"
+
+#include <algorithm>
+#include <string>
+
+#include "src/game.h"
+#include "src/player.h"
+#include "src/building.h"
+#include "src/flag.h"
+
+LanCommand::LanCommand()
+  : type(0), player(0), pos(0), a(0), b(0), c(0) {
+}
+
+LanCommand::LanCommand(Type _type, unsigned int _player, MapPos _pos, int _a,
+                       int _b, int _c)
+  : type(static_cast<uint8_t>(_type))
+  , player(static_cast<uint8_t>(_player))
+  , pos(_pos), a(_a), b(_b), c(_c) {
+}
+
+static void
+put32(std::string *out, uint32_t v) {
+  out->push_back(static_cast<char>(v >> 24));
+  out->push_back(static_cast<char>(v >> 16));
+  out->push_back(static_cast<char>(v >> 8));
+  out->push_back(static_cast<char>(v));
+}
+
+static uint32_t
+get32(const std::string &in, size_t at) {
+  return (static_cast<uint32_t>(static_cast<uint8_t>(in[at])) << 24) |
+         (static_cast<uint32_t>(static_cast<uint8_t>(in[at + 1])) << 16) |
+         (static_cast<uint32_t>(static_cast<uint8_t>(in[at + 2])) << 8) |
+         static_cast<uint32_t>(static_cast<uint8_t>(in[at + 3]));
+}
+
+/* type, player, pos, a, b, c (big endian); a road: its length (2 bytes)
+   and its directions, two to a byte. */
+void
+LanCommand::encode(std::string *out) const {
+  out->push_back(static_cast<char>(type));
+  out->push_back(static_cast<char>(player));
+  /* A road's place is where it starts. */
+  put32(out, type == TypeBuildRoad ? road.get_source() : pos);
+  put32(out, static_cast<uint32_t>(a));
+  put32(out, static_cast<uint32_t>(b));
+  put32(out, static_cast<uint32_t>(c));
+  if (type == TypeBuildRoad) {
+    Road::Dirs dirs = road.get_dirs();
+    size_t n = dirs.size();
+    out->push_back(static_cast<char>(n >> 8));
+    out->push_back(static_cast<char>(n));
+    int half = -1;
+    for (Direction d : dirs) {
+      if (half < 0) {
+        half = d;
+      } else {
+        out->push_back(static_cast<char>((half << 4) | d));
+        half = -1;
+      }
+    }
+    if (half >= 0) out->push_back(static_cast<char>(half << 4));
+  }
+}
+
+bool
+LanCommand::decode(const std::string &in, size_t *at) {
+  size_t p = *at;
+  if (in.size() < p + 18) return false;
+  type = static_cast<uint8_t>(in[p]);
+  player = static_cast<uint8_t>(in[p + 1]);
+  pos = get32(in, p + 2);
+  a = static_cast<int32_t>(get32(in, p + 6));
+  b = static_cast<int32_t>(get32(in, p + 10));
+  c = static_cast<int32_t>(get32(in, p + 14));
+  p += 18;
+  road.invalidate();
+  if (type == TypeBuildRoad) {
+    if (in.size() < p + 2) return false;
+    size_t n = (static_cast<size_t>(static_cast<uint8_t>(in[p])) << 8) |
+               static_cast<uint8_t>(in[p + 1]);
+    p += 2;
+    if (in.size() < p + (n + 1) / 2) return false;
+    road.start(pos);
+    for (size_t i = 0; i < n; i++) {
+      uint8_t byte = static_cast<uint8_t>(in[p + i / 2]);
+      int d = (i % 2 == 0) ? (byte >> 4) : (byte & 0x0f);
+      if (d > DirectionUp) return false;
+      road.extend(static_cast<Direction>(d));
+    }
+    p += (n + 1) / 2;
+  }
+  *at = p;
+  return true;
+}
+
+void
+LanCommand::move_prio(int *prio, int item, bool up, bool to_end) {
+  int cur_value = prio[item];
+  int next_value = up ? (to_end ? 26 : cur_value + 1)
+                      : (to_end ? 1 : cur_value - 1);
+  if (next_value >= 1 && next_value < 27) {
+    int delta = next_value > cur_value ? -1 : 1;
+    int min = next_value > cur_value ? cur_value + 1 : next_value;
+    int max = next_value > cur_value ? next_value : cur_value - 1;
+    for (int i = 0; i < 26; i++) {
+      if (prio[i] >= min && prio[i] <= max) prio[i] += delta;
+    }
+    prio[item] = next_value;
+  }
+}
+
+bool
+LanCommand::apply(Game *game) const {
+  Player *p = game->get_player(player);
+  if (p == nullptr) return false;
+  switch (type) {
+    case TypeBuildFlag:
+      return game->build_flag(pos, p);
+    case TypeBuildRoad: {
+      if (!road.is_valid()) return false;
+      MapPos end = road.get_end(game->get_map().get());
+      if (a != 0 && !game->build_flag(end, p)) return false;
+      if (!game->build_road(road, p)) {
+        if (a != 0) game->demolish_flag(end, p);
+        return false;
+      }
+      return true;
+    }
+    case TypeBuildBuilding:
+      return game->build_building(pos, static_cast<Building::Type>(a), p);
+    case TypeReplaceBuilding:
+      return game->replace_building(pos, static_cast<Building::Type>(a), p);
+    case TypeBuildCastle:
+      return game->build_castle(pos, p);
+    case TypeDemolishFlag:
+      return game->demolish_flag(pos, p);
+    case TypeDemolishBuilding:
+      return game->demolish_building(pos, p);
+    case TypePullRoads:
+      return game->pull_roads_through_flag(pos, p);
+    case TypeSendGeologist: {
+      Flag *flag = game->get_flag_at_pos(pos);
+      return flag != nullptr && game->send_geologist(flag);
+    }
+    case TypeInventoryResMode:
+    case TypeInventorySerfMode: {
+      Building *building = game->get_building(a);
+      if (building == nullptr || building->get_inventory() == nullptr) {
+        return false;
+      }
+      if (type == TypeInventoryResMode) {
+        game->set_inventory_resource_mode(building->get_inventory(), b);
+      } else {
+        game->set_inventory_serf_mode(building->get_inventory(), b);
+      }
+      return true;
+    }
+    case TypePromoteKnights:
+      return p->promote_serfs_to_knights(a) != 0;
+    case TypeAttack: {
+      Building *building = game->get_building_at_pos(pos);
+      if (building == nullptr) return false;
+      p->building_attacked = building->get_index();
+      p->knights_available_for_attack(pos);
+      p->knights_attacking = std::min(a, std::min(p->total_attacking_knights,
+                                                  100));
+      if (p->knights_attacking <= 0 || p->attacking_building_count <= 0) {
+        return false;
+      }
+      p->start_attack();
+      return true;
+    }
+    case TypePause:
+      game->pause();
+      return true;
+    case TypeSpeed:
+      if (a > 0) {
+        game->speed_increase();
+      } else if (a < 0) {
+        game->speed_decrease();
+      } else {
+        game->speed_reset();
+      }
+      return true;
+    case TypeSetting:
+      break;
+    default:
+      return false;
+  }
+
+  switch (a) {
+    case SettingFoodStonemine: p->set_food_stonemine(b); break;
+    case SettingFoodCoalmine: p->set_food_coalmine(b); break;
+    case SettingFoodIronmine: p->set_food_ironmine(b); break;
+    case SettingFoodGoldmine: p->set_food_goldmine(b); break;
+    case SettingPlanksConstruction: p->set_planks_construction(b); break;
+    case SettingPlanksBoatbuilder: p->set_planks_boatbuilder(b); break;
+    case SettingPlanksToolmaker: p->set_planks_toolmaker(b); break;
+    case SettingSteelToolmaker: p->set_steel_toolmaker(b); break;
+    case SettingSteelWeaponsmith: p->set_steel_weaponsmith(b); break;
+    case SettingCoalSteelsmelter: p->set_coal_steelsmelter(b); break;
+    case SettingCoalGoldsmelter: p->set_coal_goldsmelter(b); break;
+    case SettingCoalWeaponsmith: p->set_coal_weaponsmith(b); break;
+    case SettingWheatPigfarm: p->set_wheat_pigfarm(b); break;
+    case SettingWheatMill: p->set_wheat_mill(b); break;
+    case SettingKnightOccupation:
+      p->change_knight_occupation(b, c / 2 != 0 ? 1 : 0, (c % 2) ? 1 : -1);
+      break;
+    case SettingToolPrio: p->set_tool_prio(b, c); break;
+    case SettingSerfToKnightRate: p->set_serf_to_knight_rate(b); break;
+    case SettingCycleKnights: p->cycle_knights(); break;
+    case SettingSendStrongest:
+      if (b != 0) {
+        p->set_send_strongest();
+      } else {
+        p->drop_send_strongest();
+      }
+      break;
+    case SettingCastleKnights:
+      if (b > 0) {
+        p->increase_castle_knights_wanted();
+      } else {
+        p->decrease_castle_knights_wanted();
+      }
+      break;
+    case SettingResetFood: p->reset_food_priority(); break;
+    case SettingResetPlanks: p->reset_planks_priority(); break;
+    case SettingResetSteel: p->reset_steel_priority(); break;
+    case SettingResetCoal: p->reset_coal_priority(); break;
+    case SettingResetWheat: p->reset_wheat_priority(); break;
+    case SettingResetTools: p->reset_tool_priority(); break;
+    case SettingResetFlagPrio: p->reset_flag_priority(); break;
+    case SettingResetInventoryPrio: p->reset_inventory_priority(); break;
+    case SettingMovePrio:
+      move_prio(b == 0 ? p->get_flag_prio() : p->get_inventory_prio(),
+                c / 4, (c / 2) % 2 != 0, c % 2 != 0);
+      break;
+    default:
+      return false;
+  }
+  return true;
+}
