+/* Everything a player does that changes the game. In a game on one
+   computer it is done at once; in a LAN game it goes to both computers
+   and is done there at the same step (LanGame). */
+class LanCommand {
+ public:
+  typedef enum Type {
+    TypeBuildFlag = 1,      /* pos */
