+static std::string
+volume_text(const Interface *interface) {
+  Audio::VolumeController *c = Audio::get_instance().get_volume_controller();
+  return c != nullptr ? percent_text(c->get_volume()) : std::string("-");
+}
+
+static std::string
+player_volume_text(Audio::PPlayer player) {
+  if (!player) return "-";
+  Audio::PVolumeController c = player->get_volume_controller();
+  return c ? percent_text(c->get_volume()) : std::string("-");
+}
