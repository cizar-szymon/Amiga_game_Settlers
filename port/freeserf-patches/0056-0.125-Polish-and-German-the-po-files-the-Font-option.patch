+void
+Interface::switch_music() {
+  Audio::PPlayer player = Audio::get_instance().get_music_player();
+  if (player) player->enable(!player->is_enabled());
+}
+
+void
+Interface::switch_sound() {
+  Audio::PPlayer player = Audio::get_instance().get_sound_player();
+  if (player) player->enable(!player->is_enabled());
+}
+
+/* A volume 10% up or down (dir 1, -1): all (player nullptr), the music or
+   the effects. */
+static void
+change_volume(Audio::PPlayer player, bool all, int dir) {
+  if (all) {
+    Audio::VolumeController *c = Audio::get_instance().get_volume_controller();
+    if (c == nullptr) return;
+    if (dir > 0) c->volume_up(); else c->volume_down();
+    return;
+  }
+  if (!player) return;
+  Audio::PVolumeController c = player->get_volume_controller();
+  if (!c) return;
+  if (dir > 0) c->volume_up(); else c->volume_down();
+}
+
+void Interface::volume_up() { change_volume(nullptr, true, 1); }
+void Interface::volume_down() { change_volume(nullptr, true, -1); }
+void Interface::music_volume_up() {
+  change_volume(Audio::get_instance().get_music_player(), false, 1);
+}
+void Interface::music_volume_down() {
+  change_volume(Audio::get_instance().get_music_player(), false, -1);
+}
+void Interface::sound_volume_up() {
+  change_volume(Audio::get_instance().get_sound_player(), false, 1);
+}
+void Interface::sound_volume_down() {
+  change_volume(Audio::get_instance().get_sound_player(), false, -1);
+}
+
+void
+Interface::next_audio_output() {
+  Audio &audio = Audio::get_instance();
+  std::vector<std::string> outputs = audio.get_outputs();
+  if (outputs.empty()) return;
+  std::string now = audio.get_output();
+  size_t i = 0;
+  while (i < outputs.size() && outputs[i] != now) i++;
+  std::string next = outputs[(i + 1) % outputs.size()];
+  if (audio.set_output(next)) {
+    Settings &settings = Settings::get_instance();
+    settings.set("audio", "output", next);
+    settings.save();
+  }
+}
