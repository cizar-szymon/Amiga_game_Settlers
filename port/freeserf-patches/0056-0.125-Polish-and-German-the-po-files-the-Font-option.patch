+/* The Polish and German letters for the font of the game data (capitals
+   A-Z only): a letter of the font and a mark drawn over or under it. */
+typedef enum Mark {
+  MarkNone, MarkAcute, MarkDot, MarkUmlaut, MarkOgonek, MarkStroke
+} Mark;
+
+static bool
+decompose(uint32_t ch, unsigned char *base, Mark *mark) {
+  static const struct { uint32_t ch; char base; Mark mark; } kLetters[] = {
+    { 0x104, 'A', MarkOgonek }, { 0x105, 'A', MarkOgonek },
+    { 0x106, 'C', MarkAcute }, { 0x107, 'C', MarkAcute },
+    { 0x118, 'E', MarkOgonek }, { 0x119, 'E', MarkOgonek },
+    { 0x141, 'L', MarkStroke }, { 0x142, 'L', MarkStroke },
+    { 0x143, 'N', MarkAcute }, { 0x144, 'N', MarkAcute },
+    { 0xd3, 'O', MarkAcute }, { 0xf3, 'O', MarkAcute },
+    { 0x15a, 'S', MarkAcute }, { 0x15b, 'S', MarkAcute },
+    { 0x179, 'Z', MarkAcute }, { 0x17a, 'Z', MarkAcute },
+    { 0x17b, 'Z', MarkDot }, { 0x17c, 'Z', MarkDot },
+    { 0xc4, 'A', MarkUmlaut }, { 0xe4, 'A', MarkUmlaut },
+    { 0xd6, 'O', MarkUmlaut }, { 0xf6, 'O', MarkUmlaut },
+    { 0xdc, 'U', MarkUmlaut }, { 0xfc, 'U', MarkUmlaut },
+    { 0xdf, 'S', MarkNone },  /* sharp s: the translations write SS */
+  };
+  for (const auto &l : kLetters) {
+    if (l.ch == ch) {
+      *base = static_cast<unsigned char>(l.base);
+      *mark = l.mark;
+      return true;
+    }
+  }
+  return false;
+}
+
+/* Characters the font of the game data has not (it has A-Z, the digits
+   and % - . : ?), drawn as 8x8 pictures in its style: rows of the cell,
+   '#' a pixel; a ninth row is below the cell. */
+static const struct { char ch; const char *rows[9]; } kExtraGlyphs[] = {
+  { ',', { "........", "........", "........", "........", "........", "........", "..##....", "..##....", "..#....." } },
+  { ';', { "........", "........", "..##....", "..##....", "........", "........", "..##....", "..##....", "..#....." } },
+  { '(', { "....##..", "...##...", "..##....", "..##....", "..##....", "..##....", "...##...", "....##..", nullptr } },
+  { ')', { "..##....", "...##...", "....##..", "....##..", "....##..", "....##..", "...##...", "..##....", nullptr } },
+  { '/', { "......##", ".....##.", "....##..", "....##..", "...##...", "..##....", ".##.....", "##......", nullptr } },
+  { '\'', { "...##...", "...##...", "...#....", "........", "........", "........", "........", "........", nullptr } },
+  { '"', { ".##.##..", ".##.##..", ".#..#...", "........", "........", "........", "........", "........", nullptr } },
+  { '>', { ".##.....", "..##....", "...##...", "....##..", "...##...", "..##....", ".##.....", "........", nullptr } },
+  { '<', { ".....##.", "....##..", "...##...", "..##....", "...##...", "....##..", ".....##.", "........", nullptr } },
+  { '!', { "...##...", "...##...", "...##...", "...##...", "...##...", "........", "...##...", "...##...", nullptr } },
+  { '+', { "........", "...##...", "...##...", ".######.", ".######.", "...##...", "...##...", "........", nullptr } },
+  { '=', { "........", "........", ".######.", "........", "........", ".######.", "........", "........", nullptr } },
+  { '_', { "........", "........", "........", "........", "........", "........", "........", "########", nullptr } },
+  { '#', { "..#..#..", ".######.", "..#..#..", "..#..#..", ".######.", "..#..#..", "........", "........", nullptr } },
+  { '*', { "........", ".#.##.#.", "..####..", ".######.", "..####..", ".#.##.#.", "........", "........", nullptr } },
+  { '&', { "..###...", ".##.##..", "..###...", ".###..#.", "##.####.", "##..##..", ".###.##.", "........", nullptr } },
+  { '[', { "..####..", "..##....", "..##....", "..##....", "..##....", "..##....", "..##....", "..####..", nullptr } },
+  { ']', { "..####..", "....##..", "....##..", "....##..", "....##..", "....##..", "....##..", "..####..", nullptr } },
+};
+
+/* An extra character (kExtraGlyphs) at x, y; false: not one of them. */
+bool
+Frame::draw_extra_glyph(int x, int y, uint32_t ch, const Color &color,
+                        const Color &shadow) {
+  for (const auto &g : kExtraGlyphs) {
+    if (static_cast<uint32_t>(static_cast<unsigned char>(g.ch)) != ch) {
+      continue;
+    }
+    for (int pass = (shadow != Color::transparent) ? 0 : 1; pass < 2;
+         pass++) {
+      for (int r = 0; r < 9 && g.rows[r] != nullptr; r++) {
+        for (int c = 0; c < 8; c++) {
+          if (g.rows[r][c] != '#') continue;
+          if (pass == 0) {
+            fill_rect(x + c - 1, y + r, 3, 1, shadow);
+            fill_rect(x + c, y + r - 1, 1, 3, shadow);
+          } else {
+            fill_rect(x + c, y + r, 1, 1, color);
+          }
+        }
+      }
+    }
+    return true;
+  }
+  return false;
+}
+
+/* The pixels of a mark in the 8x8 cell of a letter (the letters fill the
+   cell: the marks over it go one or two rows above, the ogonek below). */
+void
+Frame::draw_mark(int x, int y, int mark, const Color &color,
+                 const Color &shadow) {
+  /* Two pixels wide, as the strokes of the font. */
+  static const int8_t kAcute[] = { 3, -1, 4, -1, 4, -2, 5, -2, -1 };
+  static const int8_t kDot[] = { 3, -2, 4, -2, 3, -1, 4, -1, -1 };
+  static const int8_t kUmlaut[] = { 1, -2, 2, -2, 1, -1, 2, -1,
+                                    5, -2, 6, -2, 5, -1, 6, -1, -1 };
+  static const int8_t kOgonek[] = { 5, 8, 6, 8, 6, 9, 7, 9, -1 };
+  static const int8_t kStroke[] = { 0, 5, 1, 5, 2, 4, 3, 4, -1 };
+  const int8_t *p = nullptr;
+  switch (mark) {
+    case MarkAcute: p = kAcute; break;
+    case MarkDot: p = kDot; break;
+    case MarkUmlaut: p = kUmlaut; break;
+    case MarkOgonek: p = kOgonek; break;
+    case MarkStroke: p = kStroke; break;
+    default: return;
+  }
+  if (shadow != Color::transparent) {
+    for (const int8_t *q = p; q[0] >= 0; q += 2) {
+      fill_rect(x + q[0] - 1, y + q[1], 3, 1, shadow);
+      fill_rect(x + q[0], y + q[1] - 1, 1, 3, shadow);
+    }
+  }
+  for (const int8_t *q = p; q[0] >= 0; q += 2) {
+    fill_rect(x + q[0], y + q[1], 1, 1, color);
+  }
+}
