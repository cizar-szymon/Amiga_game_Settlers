+/* The left button down on the name of an option of the Options box: its
+   hint until the button goes up (the rows of draw_options_box). */
+bool
+PopupBox::handle_press(int x, int y) {
+  if (box != TypeOptions) return false;
+  int cx = x - 8, cy = y - 8;
+  if (cx < 0 || cx >= 112) return false;   /* the names, not the values */
+  int row = (cy - 6) / 16;
+  if (cy < 6 || row >= kOptionsHintCount) return false;
+  options_hint = row;
+  set_redraw();
+  return true;
+}
+
+bool
+PopupBox::handle_release() {
+  if (options_hint < 0) return false;
+  options_hint = -1;
+  set_redraw();
+  return true;
 }
 
