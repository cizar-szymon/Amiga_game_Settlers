+/* The words of a hint in lines that fit w (the frame of its box). */
+static std::vector<std::string>
+hint_lines(Frame *frame, int w, const std::string &text) {
+  std::vector<std::string> lines;
+  std::string line, word;
+  std::string all = text + " ";
+  for (char c : all) {
+    if (c != ' ') {
+      word += c;
+      continue;
+    }
+    if (word.empty()) continue;
+    std::string next = line.empty() ? word : line + " " + word;
+    if (frame->get_string_width(next) > w - 12 && !line.empty()) {
+      lines.push_back(line);
+      line = word;
+    } else {
+      line = next;
+    }
+    word.clear();
+  }
+  if (!line.empty()) lines.push_back(line);
+  return lines;
+}
+
+int
+hint_box_height(Frame *frame, int w, const std::string &text) {
+  return 10 + 12 + 10 * static_cast<int>(hint_lines(frame, w, text).size()) + 6;
+}
+
+/* The hint of an option (box-frame.h). */
+void
+draw_hint_box(Frame *frame, int x, int top, int w,
+              const std::string &label, const std::string &text) {
+  std::vector<std::string> lines = hint_lines(frame, w, text);
+  int h = 10 + 12 + 10 * static_cast<int>(lines.size()) + 6;
+  frame->fill_rect(x, top, w, h, Color(0x00, 0x33, 0x1a));
+  frame->draw_rect(x, top, w, h, Color::green);
+  frame->draw_string(x + 6, top + 6, label, Color(0xdd, 0xdd, 0x00),
+                     Color::black);
+  int y = top + 6 + 14;
+  for (const std::string &l : lines) {
+    frame->draw_string(x + 6, y, l, Color::green, Color::black);
+    y += 10;
+  }
+}
+
