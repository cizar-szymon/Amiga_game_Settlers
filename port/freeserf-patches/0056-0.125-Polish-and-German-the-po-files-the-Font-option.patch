+
+/* A translated text with %s (or %u) put in: the translations may put the
+   value elsewhere in the sentence. */
+inline std::string
+text_with(const std::string &pattern, const std::string &value) {
+  size_t at = pattern.find("%s");
+  if (at == std::string::npos) at = pattern.find("%u");
+  if (at == std::string::npos) return pattern + " " + value;
+  return pattern.substr(0, at) + value + pattern.substr(at + 2);
+}
 #define C_(context, msgid) Translation::get_instance().translate(context, msgid)
 #define N_(msgid) msgid
 #define NC_(context, msgid) msgid
