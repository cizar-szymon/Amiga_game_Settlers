   }
@@ -1666,7 +1667,8 @@ Interface::handle_key_pressed(char key, int modifier) {
     }
     case 'z':
       if (modifier & 1) {
-        GameStore::get_instance().quick_save("quicksave", game.get());
+        GameStore::get_instance().quick_save("quicksave", game.get(),
