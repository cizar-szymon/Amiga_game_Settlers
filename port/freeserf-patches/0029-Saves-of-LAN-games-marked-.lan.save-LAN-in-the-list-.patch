+    }
     std::string file_path = file_list->get_folder_path() + "/" + file_name;
     if (GameStore::get_instance().save(file_path,
                                        interface->get_game().get())) {
diff --git a/src/savegame.cc b/src/savegame.cc
index 059c97e..1d2ef9f 100644
--- a/src/savegame.cc
+++ b/src/savegame.cc
@@ -597,6 +597,19 @@ const std::vector<GameStore::SaveInfo> &
 GameStore::get_saved_games() {
   saved_games.clear();
   update();
+  /* By name; the LAN saves marked, their name without ".lan". */
+  const std::string lan = lan_suffix();
+  for (SaveInfo &info : saved_games) {
+    if (info.name.size() > lan.size() &&
+        info.name.compare(info.name.size() - lan.size(), lan.size(),
+                          lan) == 0) {
+      info.name.resize(info.name.size() - lan.size());
+      info.lan = true;
+    }
+  }
+  std::sort(saved_games.begin(), saved_games.end(),
+            [](const SaveInfo &a, const SaveInfo &b) {
+              return a.name < b.name; });
   return saved_games;
 }
 
@@ -805,7 +818,7 @@ GameStore::load(const std::string &path, Game *game) {
 }
 
 bool
-GameStore::quick_save(const std::string &prefix, Game *game) {
+GameStore::quick_save(const std::string &prefix, Game *game, bool lan) {
   /* Build filename including time stamp. */
   std::time_t t = time(NULL);
   struct tm *tm = std::localtime(&t);
@@ -822,7 +835,7 @@ GameStore::quick_save(const std::string &prefix, Game *game) {
   GameStore save_game;
 
   std::string path = save_game.get_folder_path();
-  path += "/" + prefix + "-" + name + ".save";
+  path += "/" + prefix + "-" + name + (lan ? lan_suffix() : "") + ".save";
 
   return save(path, game);
 }
diff --git a/src/savegame.h b/src/savegame.h
