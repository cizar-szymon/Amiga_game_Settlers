From: cizar-szymon <szymon@cs-lab.eu>
Date: Mon, 26 Oct 2026 22:34:43 +0100
Subject: [PATCH 29/30] Saves of LAN games marked (.lan.save, LAN in the list),
 Load LAN game; the saves list sorted, with a scroll bar

---
 src/game-init.cc |  4 ++-
 src/interface.cc |  6 ++--
 src/list.cc      | 76 ++++++++++++++++++++++++++++++++++++++++++++----
 src/list.h       |  6 ++++
 src/popup.cc     |  6 ++++
 src/savegame.cc  | 17 +++++++++--
 src/savegame.h   |  7 ++++-
 7 files changed, 111 insertions(+), 11 deletions(-)

diff --git a/src/game-init.cc b/src/game-init.cc
index e0339e3..a19a762 100644
--- a/src/game-init.cc
+++ b/src/game-init.cc
@@ -157,6 +157,7 @@ GameInitBox::GameInitBox(Interface *interface)
       this->map = game.get_map();
       this->minimap->set_map(map);
     }
+    this->set_redraw();  /* "Load LAN game" or "Load game" */
   });
   add_float(file_list.get(), 20, 55);
 }
@@ -312,7 +313,8 @@ GameInitBox::internal_draw() {
     case GameLoad: {
       draw_box_icon(5, 0, 316);  // Game type
 
-      draw_box_string(10, 2, _("Load game"));
+      draw_box_string(10, 2, file_list->is_selected_lan() ? "Load LAN game"
+                                                           : _("Load game"));
 
       break;
     }
diff --git a/src/interface.cc b/src/interface.cc
index ea4c23e..13f0120 100644
--- a/src/interface.cc
+++ b/src/interface.cc
@@ -1367,7 +1367,8 @@ Interface::autosave() {
   autosave_last_game_tick = game->get_tick();
 
   GameStore &store = GameStore::get_instance();
-  std::string path = store.get_folder_path() + "/autosave.save";
+  std::string path = store.get_folder_path() + "/autosave" +
