index 8dfecbb..321f59e 100644
--- a/src/list.h
+++ b/src/list.h
@@ -48,9 +48,15 @@ class ListSavedFiles : public GuiObject {
     selection_handler = handler;
   }
   std::string get_selected() const;
+  /* The selected save is one of a LAN game. */
+  bool is_selected_lan() const;
   std::string get_folder_path() const { return save_game->get_folder_path(); }
 
  protected:
+  /* The rows that fit, and whether there are more (a scroll bar). */
+  int visible_rows() const;
+  bool scrollable() const;
+  void scroll(int rows);
   virtual void internal_draw();
 
   virtual bool handle_click_left(int x, int y);
diff --git a/src/popup.cc b/src/popup.cc
index 832fd67..c947bc0 100644
--- a/src/popup.cc
+++ b/src/popup.cc
@@ -3855,6 +3855,12 @@ PopupBox::handle_action(int action, int x_, int /*y_*/) {
     if (file_ext.empty()) {
       file_name += ".save";
     }
+    /* A save of a LAN game is marked as one in its name. */
+    std::string lan = GameStore::lan_suffix();
+    if (interface->get_lan_game() != nullptr &&
