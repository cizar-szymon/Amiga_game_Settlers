diff --git a/src/list.cc b/src/list.cc
index 59456b6..059dfc4 100644
--- a/src/list.cc
+++ b/src/list.cc
@@ -21,6 +21,7 @@
 
 #include "src/list.h"
 
+#include <algorithm>
 #include <string>
 
 ListSavedFiles::ListSavedFiles()
@@ -35,15 +36,46 @@ ListSavedFiles::ListSavedFiles()
   selected_item = -1;
 }
 
+static const int kBarWidth = 9;
+
 std::string
 ListSavedFiles::get_selected() const {
-  if (items.size() == 0) {
+  if (selected_item < 0 ||
+      selected_item >= static_cast<int>(items.size())) {
     return std::string();
   }
   std::string file_path = items[selected_item].path;
   return file_path;
 }
 
+bool
+ListSavedFiles::is_selected_lan() const {
+  return selected_item >= 0 &&
+         selected_item < static_cast<int>(items.size()) &&
+         items[selected_item].lan;
+}
+
+int
+ListSavedFiles::visible_rows() const {
+  return (height - 6 + 8) / 9;
+}
+
+bool
+ListSavedFiles::scrollable() const {
+  return static_cast<int>(items.size()) > visible_rows();
+}
+
+void
+ListSavedFiles::scroll(int rows) {
+  int last = std::max(0, static_cast<int>(items.size()) - visible_rows());
+  int first = static_cast<int>(first_visible_item) + rows;
+  first = std::max(0, std::min(last, first));
+  if (first != static_cast<int>(first_visible_item)) {
+    first_visible_item = first;
+    set_redraw();
+  }
+}
+
 void
 ListSavedFiles::internal_draw() {
   frame->fill_rect(0, 0, width, height, color_background);
@@ -52,21 +84,55 @@ ListSavedFiles::internal_draw() {
     frame->draw_rect(0, 0, width, height, color_focus);
   }
 
+  int text_width = scrollable() ? width - kBarWidth : width;
   unsigned int item = first_visible_item;
   for (int ly = 0; (ly < (height - 6)) && (item < items.size()); ly += 9) {
     Color tc = color_text;
-    if (static_cast<int>(item) == selected_item) {
-      frame->fill_rect(2, ly + 2, width - 4, 9, Color::green);
+    bool selected = static_cast<int>(item) == selected_item;
+    if (selected) {
+      frame->fill_rect(2, ly + 2, text_width - 4, 9, Color::green);
       tc = Color::black;
     }
-    frame->draw_string(3, 3 + ly, items[item].name, tc);
+    int x = 3;
+    if (items[item].lan) {
+      /* LAN, yellow, before the name of a save of a LAN game. */
+      frame->draw_string(x, 3 + ly, "LAN",
+                         selected ? Color::black : Color(0xdd, 0xdd, 0x00));
+      x += frame->get_string_width("LAN ") + 2;
+    }
+    frame->draw_string(x, 3 + ly, items[item].name, tc);
     item++;
   }
+
+  if (scrollable()) {
+    /* The bar: an arrow up at the top, down at the bottom (a click on
+       the upper half goes a page up, on the lower half a page down),
+       between them where the shown rows are among all. */
+    int bx = width - kBarWidth;
+    Color bar(0x00, 0x8b, 0x47);
+    frame->fill_rect(bx, 0, kBarWidth, height, Color(0x00, 0x33, 0x1a));
+    for (int i = 0; i < 4; i++) {
+      frame->fill_rect(bx + 4 - i, 2 + i, 1 + 2 * i, 1, Color::green);
+      frame->fill_rect(bx + 4 - i, height - 3 - i, 1 + 2 * i, 1,
+                       Color::green);
+    }
+    int track = height - 16;
+    int total = static_cast<int>(items.size());
+    int thumb = std::max(4, track * visible_rows() / total);
+    int top = 8 + (track - thumb) * static_cast<int>(first_visible_item) /
+                  std::max(1, total - visible_rows());
+    frame->fill_rect(bx + 2, top, kBarWidth - 4, thumb, bar);
+  }
 }
 
 bool
-ListSavedFiles::handle_click_left(int /*cx*/, int cy) {
+ListSavedFiles::handle_click_left(int cx, int cy) {
   set_focused();
+  if (scrollable() && cx >= width - kBarWidth) {
+    int page = std::max(1, visible_rows() - 1);
+    scroll(cy < height / 2 ? -page : page);
+    return true;
+  }
   cy -= 3;
   if (cy >= 0) {
     cy = first_visible_item + (cy / 9);
