From af184f97e8d4541c91bf8ce59462f9562f097576 Mon Sep 17 00:00:00 2001
From: cizar-szymon <szymon@cs-lab.eu>
Date: Sun, 25 Oct 2026 18:34:24 +0100
Subject: [PATCH 07/30] Faster drawing of the map view

- draw_sprite_relatively keeps the deltas of the sprites it draws
  relative to: getting them decoded the serf's torso again for every
  head in every frame.
- The tables of the serf and burning building drawing are static, not
  copied onto the stack at each call (up to 2.3 KB per serf).
- No float arithmetic for whole sprites (progress 1).
- The image cache is a hash table.
- Viewport::draw_probe: optional profiling hook for each part of the view.

On a 68060 (Warp7060), 640x400, a game with many serfs: 14.3 -> 31.9
frames per second.
---
 src/gfx.cc      | 38 ++++++++++++++++++++++++++++----------
 src/gfx.h       | 11 ++++++++++-
 src/viewport.cc | 33 +++++++++++++++++++++++----------
 src/viewport.h  |  8 ++++++++
 4 files changed, 69 insertions(+), 21 deletions(-)

diff --git a/src/gfx.cc b/src/gfx.cc
index bd93db5..cd6cfae 100644
--- a/src/gfx.cc
+++ b/src/gfx.cc
@@ -25,6 +25,7 @@
 #include <memory>
 #include <string>
 
+#include <unordered_map>
 #include <utility>
 #include <vector>
 #include <algorithm>
@@ -94,6 +95,10 @@ Image::~Image() {
 /* Sprite cache hash table */
 Image::ImageCache Image::image_cache;
 
+/* Deltas of the sprites others are drawn relative to (the serfs' torsos):
+   getting them decoded the sprite again, for every head in every frame. */
+static std::unordered_map<uint32_t, std::pair<int, int>> sprite_deltas;
+
 void
 Image::cache_image(uint64_t id, Image *image) {
   image_cache[id] = image;
@@ -159,6 +164,7 @@ Graphics::set_cursor_from_data() {
 void
 Graphics::data_changed() {
   Image::clear_cache();
+  sprite_deltas.clear();
   set_cursor_from_data();
 }
 
@@ -204,8 +210,13 @@ Frame::draw_sprite(int x, int y, Data::Resource res, unsigned int index,
     x += image->get_offset_x();
     y += image->get_offset_y();
   }
-  int y_off = image->get_height() - static_cast<int>(image->get_height() *
-                                                     progress);
+  /* Almost always whole: no float arithmetic then (in software on a CPU
+     without an FPU). */
+  int y_off = 0;
+  if (progress < 1.f) {
+    y_off = image->get_height() - static_cast<int>(image->get_height() *
+                                                   progress);
+  }
   video->draw_image(image->get_video_image(), x, y, y_off, video_frame);
 }
 
@@ -233,16 +244,23 @@ Frame::draw_sprite_relatively(int x, int y, Data::Resource res,
                               unsigned int index,
                               Data::Resource relative_to_res,
                               unsigned int relative_to_index) {
-  Data::PSprite s = data_source->get_sprite(relative_to_res, relative_to_index,
-                                            {0, 0, 0, 0});
-  if (s == nullptr) {
-    Log::Warn["graphics"] << "Failed to decode sprite #"
-                          << Data::get_resource_name(res) << ":" << index;
-    return;
+  uint32_t key = (static_cast<uint32_t>(relative_to_res) << 16) |
+                 relative_to_index;
+  auto it = sprite_deltas.find(key);
+  if (it == sprite_deltas.end()) {
+    Data::PSprite s = data_source->get_sprite(relative_to_res,
+                                              relative_to_index, {0, 0, 0, 0});
+    if (s == nullptr) {
+      Log::Warn["graphics"] << "Failed to decode sprite #"
+                            << Data::get_resource_name(res) << ":" << index;
+      return;
+    }
+    it = sprite_deltas.emplace(key, std::make_pair(s->get_delta_x(),
+                                            s->get_delta_y())).first;
   }
 
-  x += s->get_delta_x();
-  y += s->get_delta_y();
+  x += it->second.first;
+  y += it->second.second;
 
   draw_sprite(x, y, res, index, true, Color::transparent, 1.f);
 }
diff --git a/src/gfx.h b/src/gfx.h
index c74a5b4..98d985b 100644
--- a/src/gfx.h
+++ b/src/gfx.h
@@ -25,6 +25,7 @@
 #include <cstdint>
 #include <map>
 #include <string>
+#include <unordered_map>
 #include <memory>
 
 #include "src/data.h"
@@ -92,7 +93,15 @@ class Image {
   Video *video;
   Video::Image *video_image;
 
-  typedef std::map<uint64_t, Image*> ImageCache;
+  /* A hash table: looked up for every sprite drawn. Both halves of the id
+     are mixed, size_t may have only 32 bits. */
+  struct IdHash {
+    size_t operator()(uint64_t id) const {
+      return (static_cast<uint32_t>(id >> 32) * 0x9e3779b1u) ^
+             static_cast<uint32_t>(id);
+    }
+  };
+  typedef std::unordered_map<uint64_t, Image*, IdHash> ImageCache;
   static ImageCache image_cache;
 
  public:
