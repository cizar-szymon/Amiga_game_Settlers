   Translation &translation = Translation::get_instance();
@@ -99,6 +104,9 @@ static const Option options[] = {
      of the data and the language is left out. */
   { N_("Show FPS"), &Interface::get_show_fps, nullptr,
     &Interface::switch_show_fps },
