 src/lan-sync.cc      | 17 +++++++++--------
 src/map-generator.cc | 10 +++++++---
 src/map-generator.h  |  3 +++
 src/mission.cc       |  4 +++-
 src/mission.h        |  4 ++++
 13 files changed, 73 insertions(+), 22 deletions(-)

diff --git a/src/advanced-box.cc b/src/advanced-box.cc
