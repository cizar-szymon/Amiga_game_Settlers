diff --git a/src/game.cc b/src/game.cc
index 8ac0a80..06800a8 100644
--- a/src/game.cc
+++ b/src/game.cc
@@ -858,13 +858,12 @@ Game::pause() {
   Log::Info["game"] << "Game speed: " << game_speed;
 }
 
-/* The speeds of the + and - keys: x1 (DEFAULT_GAME_SPEED) to x3 in steps
-   of x0.5; - stops at the normal speed. In a pause they change the speed
-   the game goes on with; 0 sets the normal speed (also ending a pause). */
+/* The speeds of the + and - keys: x0.5 to x3 (DEFAULT_GAME_SPEED is x1)
+   in steps of x0.5. In a pause they change the speed the game goes on
+   with; 0 sets the normal speed (also ending a pause). */
 void
 Game::speed_increase() {
   unsigned int &speed = (game_speed != 0) ? game_speed : game_speed_save;
-  if (speed < DEFAULT_GAME_SPEED) speed = DEFAULT_GAME_SPEED;
   if (speed < 3 * DEFAULT_GAME_SPEED) {
     speed += DEFAULT_GAME_SPEED / 2;
     Log::Info["game"] << "Game speed: " << speed;
@@ -874,7 +873,7 @@ Game::speed_increase() {
 void
 Game::speed_decrease() {
   unsigned int &speed = (game_speed != 0) ? game_speed : game_speed_save;
-  if (speed > DEFAULT_GAME_SPEED) {
+  if (speed > DEFAULT_GAME_SPEED / 2) {
     speed -= DEFAULT_GAME_SPEED / 2;
     Log::Info["game"] << "Game speed: " << speed;
   }
@@ -2419,12 +2418,13 @@ Game::build_occupied_military(MapPos pos, Building::Type type,
 }
 
 bool
-Game::init(unsigned int map_size, const Random &random) {
+Game::init(unsigned int map_size, const Random &random, unsigned int sand) {
   init_map_rnd = random;
 
   map.reset(new Map(MapGeometry(map_size)));
   ClassicMissionMapGenerator generator(*map, init_map_rnd);
   generator.init();
+  generator.set_desert_percent(sand);
   generator.generate();
   map->init_tiles(generator);
   gold_total = map->get_gold_deposit();
