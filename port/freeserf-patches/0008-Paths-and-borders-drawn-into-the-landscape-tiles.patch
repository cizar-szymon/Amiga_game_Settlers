+void
+Viewport::draw_paths_and_borders_area(int ox, int oy, int w, int h,
+                                      int margin) {
+  int top = oy - margin * MAP_TILE_HEIGHT;
+  int x_off = -(ox + 16 * (top / 20)) % 32;
+  int y_off = -top % 20 - margin * MAP_TILE_HEIGHT;
+  int col_0 = (ox / 16 + top / 20) / 2 & map->get_col_mask();
+  int row_0 = (top / MAP_TILE_HEIGHT) & map->get_row_mask();
+  MapPos base_pos = map->pos(col_0, row_0);
+  if (margin > 0) {
+    x_off -= MAP_TILE_WIDTH;
+    base_pos = map->move_left(base_pos);
+  }
+  int bottom = h + margin * MAP_TILE_HEIGHT;
