+  preview_mission = mission;
+  send_lobby();
+  if (save_path.empty()) {
+    request_preview();
+  }
+  interface->lan_mission_changed();
+  show_fields();
+  set_redraw();
+}
+
+void
+LanBox::request_preview() {
+  preview_pending = true;
+  preview_due = EventLoop::get_instance().get_ticks() + 400;
+  show_fields();
+  set_redraw();
+}
+
+/* The map of the lobby, made as the start box makes its preview (the
+   same random base, size, sand and rocks). */
+void
+LanBox::generate_preview() {
+  preview_pending = false;
+  if (!preview_mission) {
+    return;
+  }
+  preview_map.reset(new Map(MapGeometry(preview_mission->get_map_size())));
+  ClassicMapGenerator generator(*preview_map,
+                                preview_mission->get_random_base());
+  generator.init(MapGenerator::HeightGeneratorMidpoints, true);
+  generator.set_desert_percent(preview_mission->get_sand_percent());
+  generator.set_rock_percent(preview_mission->get_rock_percent());
+  generator.generate();
+  preview_map->init_tiles(generator);
+  preview->set_map(preview_map);
+  show_fields();
+  set_redraw();
+}
+
+void
+LanBox::add_chat(const std::string &name, const std::string &text,
+                 bool note) {
+  LobbyLine line;
+  line.name = chat_clean(name, 15);
+  line.text = chat_clean(text, kChatTextMax);
+  line.note = note;
+  chat.push_back(line);
+  while (chat.size() > kChatRows) {
+    chat.pop_front();
+  }
+  set_redraw();
+}
+
+void
+LanBox::handle_return() {
+  if (!lobby()) {
+    return;
+  }
+  std::string text = chat_clean(chat_field->get_text(), kChatTextMax);
+  if (text.empty()) {
+    return;
+  }
+  send_chat(text);
+  chat_field->set_text(std::string());
+  chat_field->set_focused();
+}
+
+void
+LanBox::send_chat(const std::string &text) {
+  LanLink *l = link();
+  bool server = l->is_server();
+  std::string name = server ? server_name_field->get_text()
+                            : player_name_field->get_text();
+  /* As the chat of the game: the player, the name, a new line, the text. */
+  if (l->send(LanGame::MessageChat,
+              std::string(1, static_cast<char>(server ? 0 : 1)) + name +
+              "\n" + text)) {
+    add_chat(name, text);
+  } else {
+    add_chat(std::string(), "NOT SENT - NO CONNECTION", true);
+  }
+  set_redraw();
+}
