+    draw_text_button(kInfoRightX, kSizeButtonsY, kHalfWidth, "LARGER",
+                     !saved && mission->get_map_size() < 10);
+    draw_text_button(kInfoLeftX, kMapButtonsY, kHalfWidth, "OTHER MAP",
+                     !saved);
+    draw_text_button(kInfoRightX, kMapButtonsY, kHalfWidth,
+                     saved ? "NEW MAP" : "SAVED GAME");
+  } else {
+    frame->draw_string(kInfoX, kSizeButtonsY + 4, "The server chooses",
+                       Color::green, Color::black);
+    frame->draw_string(kInfoX, kSizeButtonsY + 14, "the map. Agree on",
+                       Color::green, Color::black);
+    frame->draw_string(kInfoX, kSizeButtonsY + 24, "it in the chat.",
+                       Color::green, Color::black);
+  }
+  frame->draw_string(kInfoX, kMapButtonsY + 28, "Chat: type, Return",
+                     Color::green, Color::black);
+
+  /* The chat: the last lines, the field to write in below. */
+  int ch = static_cast<int>(kChatRows) * 8 + 4;
+  frame->fill_rect(kChatX, kChatY, kChatW, ch, Color::black);
+  int ry = kChatY + 2;
+  for (const LobbyLine &line : chat) {
+    if (line.note) {
+      frame->draw_string(kChatX + 2, ry, line.text, Color(0xdd, 0xdd, 0x00));
+    } else {
+      std::string name = line.name.substr(0, kChatNameShown);
+      frame->draw_string(kChatX + 2, ry, name, Color::green);
+      frame->draw_string(kChatX + 2 + 8 * static_cast<int>(name.size() + 1),
+                         ry, line.text, Color(0xdd, 0xdd, 0xdd));
+    }
+    ry += 8;
+  }
+
+  if (server) {
+    draw_text_button(kLeftButtonX, kLobbyButtonsY, kButtonWidth, "CANCEL");
+    draw_text_button(kRightButtonX, kLobbyButtonsY, kButtonWidth,
+                     "START GAME");
+  } else {
+    for (int i = 0; i < kQuickCount; i++) {
+      draw_text_button(kQuickX + i * kQuickStep, kLobbyButtonsY, kQuickWidth,
+                       kQuickAnswers[i]);
+    }
+    draw_text_button(kRightButtonX, kLobbyButtonsY, kButtonWidth,
+                     "DISCONNECT");
+  }
+  if (!message.empty()) {
+    frame->draw_string(kLabelX, kLobbyMessageY, message, Color::green,
+                       Color::black);
+  }
+}
+
+/* A click in the lobby; false: not on a button of it. */
+bool
+LanBox::lobby_click(int x, int y) {
+  bool server = view == ViewServer;
+  if (!server) {
+    for (int i = 0; i < kQuickCount; i++) {
+      if (inside(x, y, kQuickX + i * kQuickStep, kLobbyButtonsY, kQuickWidth,
+                 kButtonHeight)) {
+        play_sound(Audio::TypeSfxClick);
+        send_chat(kQuickAnswers[i]);
+        return true;
+      }
+    }
+    if (inside(x, y, kRightButtonX, kLobbyButtonsY, kButtonWidth,
+               kButtonHeight)) {
+      play_sound(Audio::TypeSfxClick);
+      set_view(ViewJoin);
+      return true;
+    }
+    return false;
+  }
+  bool saved = !save_path.empty();
+  if (inside(x, y, kInfoLeftX, kSizeButtonsY, kHalfWidth, kButtonHeight)) {
+    if (saved || mission->get_map_size() <= 1) {
+      play_sound(Audio::TypeSfxNotAccepted);
+    } else {
+      play_sound(Audio::TypeSfxClick);
+      mission->set_map_size(mission->get_map_size() - 1);
+      map_changed();
+    }
+    return true;
+  }
+  if (inside(x, y, kInfoRightX, kSizeButtonsY, kHalfWidth, kButtonHeight)) {
+    if (saved || mission->get_map_size() >= 10) {
+      play_sound(Audio::TypeSfxNotAccepted);
+    } else {
+      play_sound(Audio::TypeSfxClick);
+      mission->set_map_size(mission->get_map_size() + 1);
+      map_changed();
+    }
+    return true;
+  }
+  if (inside(x, y, kInfoLeftX, kMapButtonsY, kHalfWidth, kButtonHeight)) {
+    if (saved) {
+      play_sound(Audio::TypeSfxNotAccepted);
+    } else {
+      /* Another map: a new random base; the players stay (a LAN game,
+         see GameInitBox). */
+      play_sound(Audio::TypeSfxClick);
+      std::vector<PPlayerInfo> keep;
+      for (size_t i = 0; i < mission->get_player_count(); i++) {
+        keep.push_back(mission->get_player(i));
+      }
+      mission->set_random_base(Random());
+      mission->remove_all_players();
+      for (const PPlayerInfo &p : keep) {
+        mission->add_player(p);
+      }
+      map_changed();
+    }
+    return true;
+  }
+  if (inside(x, y, kInfoRightX, kMapButtonsY, kHalfWidth, kButtonHeight)) {
+    play_sound(Audio::TypeSfxClick);
+    if (saved) {
+      save_path.clear();
+      map_changed();
+    } else {
+      set_view(ViewLoad);
+    }
+    return true;
+  }
+  if (inside(x, y, kLeftButtonX, kLobbyButtonsY, kButtonWidth,
+             kButtonHeight)) {
+    play_sound(Audio::TypeSfxClick);
+    set_view(ViewChoose);
+    return true;
+  }
+  return false;
+}
