+/* Pathway scrolling (an option of the original): while a road is built,
+   the map moves when the end of the road comes near the edge of the view,
+   only as far as needed to keep the end that far from the edge - as the
+   original, a long road is built on without scrolling by hand. */
+void
+Interface::pathway_scroll(MapPos pos) {
+  if (!pathway_scrolling || (viewport == nullptr)) return;
+  int sx = 0, sy = 0, vw = 0, vh = 0;
+  viewport->screen_pix_from_map_coord(pos, &sx, &sy);
+  viewport->get_size(&vw, &vh);
+  const int margin = 48;  /* about one and a half tiles */
+  if (sx >= vw || sy >= vh) {
+    /* Out of the view (wrapped around the map): centre on it. */
+    viewport->move_to_map_pos(pos);
+    return;
+  }
+  int dx = 0, dy = 0;
+  if (sx < margin) {
+    dx = sx - margin;
+  } else if (sx >= vw - margin) {
+    dx = sx - (vw - margin);
+  }
+  if (sy < margin) {
+    dy = sy - margin;
+  } else if (sy >= vh - margin) {
+    dy = sy - (vh - margin);
+  }
+  if (dx != 0 || dy != 0) {
+    viewport->move_by_pixels(dx, dy);
+  }
+}
