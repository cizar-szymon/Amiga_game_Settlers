+/* The report of a sync error as files: the .txt of the commands next to
+   the save, and the files of the player who joined sent to the server.
+   Off for now - reports will go to a server of their own, not to the
+   players' Amigas (user, 5.11.2026); the SYNC_ERR save stays. */
+static const bool kReportFiles = false;
+
+void
+LanGame::dump(bool sync_error) {
+  PGame game = interface->get_game();
+  if (!game || dumped_at == steps) return;
+  dumped_at = steps;
+  /* The names fit an Amiga disk with .lan.save (FFS: 30 letters):
+     SYNC_ERR_<yymmdd>_<hhmm><M|S> (the clock of this Amiga at the
+     error), LAN_DUMP_<step>_<M|S>. */
+  std::string base;
+  if (sync_error) {
+    std::time_t now = std::time(nullptr);
+    struct tm *at = std::localtime(&now);
+    char when[16] = "0";
+    if (at != nullptr) {
+      std::strftime(when, sizeof(when), "%y%m%d_%H%M", at);
+    }
+    base = std::string("SYNC_ERR_") + when + (server ? "M" : "S");
+  } else {
+    base = "LAN_DUMP_" + std::to_string(steps) + (server ? "_M" : "_S");
+  }
+  GameStore &store = GameStore::get_instance();
+  std::string folder = store.get_folder_path() + "/";
+  bool saved = store.save(folder + base + GameStore::lan_suffix() + ".save",
+                          game.get());
+
+  std::ostringstream log;
+  std::time_t t = std::time(nullptr);
+  struct tm *tm = std::localtime(&t);
+  char stamp[32] = "-";
+  if (tm != nullptr) {
+    std::strftime(stamp, sizeof(stamp), "%Y-%m-%d %H:%M:%S", tm);
+  }
+  log << "Settlers LAN bug report ("
+      << (sync_error ? "the games went apart" : "asked for") << ")\n"
+      << "side " << (server ? "MASTER (server)" : "SLAVE (joined)") << "\n"
+      << "own name " << own_name << ", other " << peer_name << "\n"
+      << "clock " << stamp << "\n"
+      << "step " << steps << ", game tick " << game->get_tick()
+      << ", turn delay " << delay << "\n"
+      << "out of step " << (out_of_step ? std::to_string(out_of_step_at)
+                                        : std::string("no")) << "\n"
+      << "\nsums (step own other):\n";
+  for (const std::string &s : sum_log) log << s << "\n";
+  log << "\ncommands (the last " << command_log.size() << "):\n";
+  for (const std::string &s : command_log) log << s << "\n";
+  std::string text = log.str();
+  if (kReportFiles) {
+    std::ofstream f(folder + base + ".txt", std::ios::binary);
+    f << text;
+  }
+  Log::Warn["lan"] << "LAN dump at step " << steps << ": " << base;
+  add_chat(-1, std::string(), saved ? "GAME SAVED: SYNC ERROR"
+                                    : "GAME NOT SAVED");
+  chat_shown_until = EventLoop::get_instance().get_ticks() + 10000;
+  update_chat_box(true);
+
+  /* The server gets both files of this side. */
+  if (kReportFiles && !server && saved) {
+    std::ifstream f(folder + base + GameStore::lan_suffix() + ".save",
+                    std::ios::binary);
+    std::stringstream save;
+    save << f.rdbuf();
+    queue_file(base + GameStore::lan_suffix() + ".save", save.str());
+    queue_file(base + ".txt", text);
+  }
+}
