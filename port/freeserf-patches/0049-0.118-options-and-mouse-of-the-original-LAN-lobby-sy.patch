+}
+
+void
+LanGame::resync() {
+  resyncs++;
+  /* From here the checksums are compared again. */
+  resync_step = steps;
+  out_of_step = false;
+  own_sums.clear();
+  if (!server) {
+    resync_waiting = true;
+    add_chat(-1, std::string(), "RESYNC: WAITING FOR THE SERVER");
+    chat_shown_until = EventLoop::get_instance().get_ticks() + 10000;
+    update_chat_box(true);
+    return;
+  }
+  PGame game = interface->get_game();
+  if (!game) return;
+  std::ostringstream out;
+  if (!GameStore::get_instance().write(&out, game.get())) {
+    add_chat(-1, std::string(), "RESYNC FAILED");
+    return;
+  }
+  std::string data = out.str();
+  static const size_t kPiece = LanLink::kMaxData - 10;
+  file_out.push_back(std::make_pair(
+    static_cast<int>(MessageResyncBegin),
+    std::to_string(data.size()) + " " +
+    std::to_string(lan_data_checksum(data)) + " " + std::to_string(steps) +
+    " " + std::to_string(game->get_speed()) + " " +
+    std::to_string(game->get_speed_save())));
+  for (size_t at = 0; at < data.size(); at += kPiece) {
+    file_out.push_back(std::make_pair(static_cast<int>(MessageResyncData),
+                                      data.substr(at, kPiece)));
+  }
+  file_out.push_back(std::make_pair(static_cast<int>(MessageResyncEnd),
+                                    std::string()));
+  Log::Warn["lan"] << "Resync at step " << steps << ": " << data.size()
+                   << " bytes to the other side";
+  add_chat(-1, std::string(), "RESYNC: THE GAME GOES TO THE OTHER SIDE");
+  chat_shown_until = EventLoop::get_instance().get_ticks() + 10000;
+  update_chat_box(true);
+}
+
+void
+LanGame::receive_resync(int type, const std::string &data) {
+  if (type == MessageResyncBegin) {
+    std::istringstream s(data);
+    resync_in.clear();
+    resync_ready = false;
+    resync_size = 0;
+    s >> resync_size >> resync_sum >> resync_in_step >> resync_speed
+      >> resync_speed_save;
+    if (!s || resync_size > 4000000) {
+      resync_size = 0;
+    }
+    resync_in.reserve(resync_size);
+  } else if (type == MessageResyncData) {
+    if (resync_size != 0 && resync_in.size() < resync_size) {
+      resync_in += data;
+    }
+  } else if (resync_size != 0) {
+    resync_ready = resync_in.size() == resync_size &&
+                   lan_data_checksum(resync_in) == resync_sum;
+    if (!resync_ready) {
+      add_chat(-1, std::string(), "RESYNC: THE GAME CAME BROKEN");
+      Log::Warn["lan"] << "Resync data broken";
+      /* Stay apart rather than stop: the game goes on as it was. */
+      resync_waiting = false;
+    }
+  }
+}
+
+bool
+LanGame::load_resync() {
+  resync_ready = false;
+  std::string text;
+  text.swap(resync_in);
+  if (resync_in_step != steps) {
+    Log::Warn["lan"] << "Resync of step " << resync_in_step << " at step "
+                     << steps;
+  }
+  /* The view, the player and the open boxes of this side stay. */
+  Player *player = interface->get_player();
+  unsigned int index = (player != nullptr) ? player->get_index() : 1;
+  MapPos view = 0;
+  if (interface->get_viewport() != nullptr) {
+    view = interface->get_viewport()->get_current_map_pos();
+  }
+  if (interface->is_building_road()) {
+    interface->build_road_end();
+  }
+  interface->close_popup();
+  if (!GameManager::get_instance().load_game_text(text)) {
+    add_chat(-1, std::string(), "RESYNC FAILED");
+    Log::Warn["lan"] << "Resync: the game could not be read";
+    return false;
+  }
+  PGame game = interface->get_game();
+  if (game) {
+    game->set_speeds(resync_speed, resync_speed_save);
+  }
+  interface->set_player(index);
+  if (interface->get_viewport() != nullptr) {
+    interface->get_viewport()->move_to_map_pos(view);
+  }
+  /* The chat over the new map view. */
+  if (chat_box) {
+    interface->del_float(chat_box.get());
+    chat_box.reset();
+  }
+  add_chat(-1, std::string(), "RESYNC DONE - THE GAMES ARE THE SAME");
+  chat_shown_until = EventLoop::get_instance().get_ticks() + 10000;
+  update_chat_box(true);
+  Log::Warn["lan"] << "Resync done at step " << steps;
+  return true;
+}
+
+void
+LanGame::queue_file(const std::string &name, const std::string &data) {
+  static const size_t kPiece = LanLink::kMaxData - 10;
+  file_out.push_back(std::make_pair(
+    static_cast<int>(MessageFileBegin),
+    name + " " + std::to_string(data.size()) + " " +
+    std::to_string(lan_data_checksum(data))));
+  for (size_t at = 0; at < data.size(); at += kPiece) {
+    file_out.push_back(std::make_pair(static_cast<int>(MessageFileData),
+                                      data.substr(at, kPiece)));
+  }
+  file_out.push_back(std::make_pair(static_cast<int>(MessageFileEnd),
+                                    std::string()));
+}
+
+/* As many frames as the link takes now, the rest with the next step. */
+void
+LanGame::pump_files() {
+  if (link == nullptr || gone) {
+    file_out.clear();
+    return;
+  }
+  /* A few at a time: the turns go between them. */
+  for (int i = 0; i < 64 && !file_out.empty(); i++) {
+    if (!link->send(file_out.front().first, file_out.front().second)) {
+      return;
+    }
+    file_out.pop_front();
+  }
+}
+
+/* The name: letters, digits, _ - . only (it comes from the network). */
+static bool
+file_name_ok(const std::string &name) {
+  if (name.empty() || name.size() > 30) return false;
+  for (char c : name) {
+    if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+          (c >= '0' && c <= '9') || c == '_' || c == '-' || c == '.')) {
+      return false;
+    }
+  }
+  return name.find("..") == std::string::npos;
+}
+
+void
+LanGame::receive_file(int type, const std::string &data) {
+  if (type == MessageFileBegin) {
+    std::istringstream s(data);
+    file_in.clear();
+    file_in_name.clear();
+    file_in_size = 0;
+    file_in_sum = 0;
+    s >> file_in_name >> file_in_size >> file_in_sum;
+    if (!file_name_ok(file_in_name) || file_in_size > 4000000) {
+      file_in_name.clear();
+      return;
+    }
+    file_in.reserve(file_in_size);
+  } else if (type == MessageFileData) {
+    if (!file_in_name.empty() && file_in.size() < file_in_size) {
+      file_in += data;
+    }
+  } else if (!file_in_name.empty()) {
+    bool ok = file_in.size() == file_in_size &&
+              lan_data_checksum(file_in) == file_in_sum;
+    if (ok) {
+      std::string path = GameStore::get_instance().get_folder_path() + "/" +
+                         file_in_name;
+      std::ofstream f(path, std::ios::binary);
+      f << file_in;
+      ok = static_cast<bool>(f);
+    }
+    if (file_in_name.size() > 4 &&
+        file_in_name.compare(file_in_name.size() - 4, 4, ".txt") == 0) {
+      add_chat(-1, std::string(), ok ? "STATE OF THE OTHER SIDE RECEIVED"
+                                     : "STATE OF THE OTHER SIDE BROKEN");
+      chat_shown_until = EventLoop::get_instance().get_ticks() + 10000;
+      update_chat_box(true);
+    }
+    Log::Info["lan"] << "Report file " << file_in_name
+                     << (ok ? " received" : " broken");
+    file_in.clear();
+    file_in_name.clear();
+  }
+}
+
+bool
+LanGame::save_at_end() {
+  if (end_saved) return false;
+  end_saved = true;
+  PGame game = interface->get_game();
+  /* Not before the game went (a saved game still coming). */
+  if (!game || steps == 0 || !save_out.empty()) return false;
+  /* A file of its own, named by the time of the end (the clock of the
+     Amiga): LAN_ERR_<yymmdd>_<hhmmss>.lan.save - 30 letters, the most a
+     name may have on an Amiga disk (FFS: a longer one loses its end,
+     ".save", and the list of saves no longer shows it). */
+  std::time_t t = std::time(nullptr);
+  struct tm *tm = std::localtime(&t);
+  char stamp[32] = "0";
+  if (tm != nullptr) {
+    std::strftime(stamp, sizeof(stamp), "%y%m%d_%H%M%S", tm);
+  }
+  GameStore &store = GameStore::get_instance();
+  std::string path = store.get_folder_path() + "/LAN_ERR_" + stamp +
+                     GameStore::lan_suffix() + ".save";
+  bool ok = store.save(path, game.get());
+  if (ok) {
+    Log::Info["lan"] << "LAN game saved at its end (step " << steps
+                     << "): " << path;
+  }
+  return ok;
+}
