@@ -43,8 +43,44 @@ static const int kFirstRowY = 19;
 /* The boxes with a title (Video, Audio): rows below it. */
 static const int kTitleY = 11;
 static const int kTitledFirstRowY = 30;
-/* VIDEO and AUDIO left of the Exit button. */
-static const int kPageButtonWidth = 48;
+/* VIDEO and AUDIO left of the Exit button, in the small letters of the
+   original's buttons (3x5, as the EXIT label). */
+static const int kPageButtonWidth = 40;
+
+static const char *
+small_glyph(char c, int row) {
+  static const char *const kGlyphs[][6] = {
+    { "V", "# #", "# #", "# #", "# #", " # " },
+    { "I", "###", " # ", " # ", " # ", "###" },
+    { "D", "## ", "# #", "# #", "# #", "## " },
+    { "E", "###", "#  ", "## ", "#  ", "###" },
+    { "O", "###", "# #", "# #", "# #", "###" },
+    { "A", "###", "# #", "###", "# #", "# #" },
+    { "U", "# #", "# #", "# #", "# #", "###" },
+  };
+  for (const auto &g : kGlyphs) {
+    if (g[0][0] == c) return g[1 + row];
+  }
+  return "   ";
+}
+
+/* A wooden plate with a word in the small letters. */
+static void
+draw_small_button(Frame *frame, int x, int y, int w, const char *word) {
+  frame->fill_rect(x, y, w, 16, Color(0x55, 0x22, 0x00));
+  frame->fill_rect(x + 1, y + 1, w - 2, 14, Color(0x99, 0x55, 0x22));
+  std::string rows[5];
+  for (const char *c = word; *c != 0; c++) {
+    for (int r = 0; r < 5; r++) {
+      if (c != word) rows[r] += " ";
+      rows[r] += small_glyph(*c, r);
+    }
+  }
+  const char *lines[5];
+  for (int r = 0; r < 5; r++) lines[r] = rows[r].c_str();
+  int lw = static_cast<int>(rows[0].size());
+  draw_small_letters(frame, x + (w - lw) / 2, y + 5, lines);
+}
 
