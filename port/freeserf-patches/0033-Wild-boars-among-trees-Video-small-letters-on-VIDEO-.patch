+/* A wild boar stands here: few places (one free place in 24, by the
+   place - the same on both computers of a LAN game), among trees - at
+   least three of the six neighbours. Only a picture. */
+bool
+Viewport::boar_at(MapPos pos) const {
+  uint32_t h = static_cast<uint32_t>(pos) * 2246822519u;
+  if (((h >> 16) % 24) != 0) return false;
+  int trees = 0;
+  for (int d = 0; d < 6; d++) {
+    Map::Object o = map->get_obj(map->move(pos, static_cast<Direction>(d)));
+    if (o >= Map::ObjectTree0 && o <= Map::ObjectPine7) trees++;
+  }
+  return trees >= 3;
+}
+
+void
+Viewport::draw_boar(MapPos pos, int lx, int ly) {
+  /* The pigs of the pig farm, walking a little and grazing, dark brown. */
+  static const int anim[] = {
+    0xa2, 0, 0xa3, 0, 0xa2, 1, 0xa3, 1, 0xa2, 2, 0xa3, 2, 0xa2, 3, 0xa3, 3,
+    0xa6, 3, 0xa6, 3, 0xa7, 3, 0xa8, 3, 0xa7, 3, 0xa8, 3, 0xa4, 3, 0xa5, 3,
+    0xa4, 2, 0xa5, 2, 0xa4, 1, 0xa5, 1, 0xa4, 0, 0xa5, 0, 0xa6, 0, 0xa6, 0
+  };
+  const int frames = sizeof(anim) / sizeof(anim[0]) / 2;
+  int i = static_cast<int>(((interface->get_game()->get_tick() >> 3) +
+                            pos * 7) % frames) * 2;
+  frame->draw_sprite_variant(lx + anim[i + 1], ly, Data::AssetGameObject,
+                             anim[i] - 1, Frame::VariantDarkBrown);
+  /* Its grunt now and then. */
+  if ((interface->get_random()->random() & 0x3ff) < 8) {
+    play_map_sound(Audio::TypeSfxBoarGrunt);
+  }
+}
+
