+bool
+Interface::demolish_road_at_cursor() {
+  /* A command: in a LAN game done on both computers (0.132: before, only
+     on this one - the LAN game went apart); checked here for the sound. */
+  bool r = game && game->can_demolish_road(map_cursor_pos, player) &&
+           command(LanCommand::TypeDemolishRoad, map_cursor_pos);
+  if (!r) {
+    play_sound(Audio::TypeSfxNotAccepted);
+    update_map_cursor_pos(map_cursor_pos);
+  } else {
+    play_sound(Audio::TypeSfxAccepted);
+  }
+  return r;
+}
+
+void
+Interface::lan_test_road() {
+  /* Stages: 0 the castle (when there is none), 1 the road, 2 its removal,
+     3 done; 10 s apart. */
+  static LanGame *road_game = nullptr;
+  static unsigned int road_at = 0;
+  static int stage = 0;
+  static MapPos road_pos = 0;
+  unsigned int now = EventLoop::get_instance().get_ticks();
+  if (road_game != lan_game.get()) {
+    road_game = lan_game.get();
+    road_at = now + lan_test_road_s * 1000;
+    stage = 0;
+    return;
+  }
+  if (stage >= 3 || static_cast<int>(now - road_at) < 0) return;
+  PMap map = game->get_map();
+  road_at = now + 10000;
+  Flag *flag = nullptr;
+  for (Building *b : game->get_player_buildings(player)) {
+    if (b->get_type() == Building::TypeCastle) {
+      flag = game->get_flag(b->get_flag_index());
+    }
+  }
+  if (stage == 0) {
+    stage = 1;
+    if (flag != nullptr) return;
+    for (int i = 0; i < 295; i++) {  /* the spiral of the map */
+      MapPos pos = map->pos_add_spirally(map_cursor_pos, i);
+      if (game->can_build_castle(pos, player)) {
+        command(LanCommand::TypeBuildCastle, pos);
+        lan_game->note("LANROAD: CASTLE BUILT");
+        Log::Info["lan"] << "LANROAD: castle built";
+        return;
+      }
+    }
+    lan_game->note("LANROAD: NO PLACE FOR A CASTLE");
+    Log::Info["lan"] << "LANROAD: no place for a castle";
+    stage = 3;
+  } else if (stage == 1) {
+    stage = 3;  /* unless the road goes */
+    if (flag == nullptr) {
+      lan_game->note("LANROAD: NO CASTLE");
+      Log::Info["lan"] << "LANROAD: no castle";
+      return;
+    }
+    for (int len = 2; len <= 4 && stage == 3; len++) {
+      for (int d = DirectionRight; d <= DirectionUp && stage == 3; d++) {
+        Road road;
+        road.start(flag->get_position());
+        for (int i = 0; i < len; i++) road.extend(static_cast<Direction>(d));
+        MapPos end = road.get_end(map.get());
+        MapPos dest;
+        if (!game->can_build_flag(end, player) ||
+            game->can_build_road(road, player, &dest, nullptr) <= 0) {
+          continue;
+        }
+        LanCommand c(LanCommand::TypeBuildRoad, 0, 0, 1);
+        c.road = road;
+        if (command(c)) {
+          road_pos = map->move(flag->get_position(), static_cast<Direction>(d));
+          stage = 2;
+          lan_game->note("LANROAD: ROAD BUILT");
+          Log::Info["lan"] << "LANROAD: road of " << len << " built at "
+                           << map->pos_col(road_pos) << ","
+                           << map->pos_row(road_pos);
+        }
+      }
+    }
+    if (stage == 3) {
+      lan_game->note("LANROAD: NO ROAD");
+      Log::Info["lan"] << "LANROAD: no road";
+    }
+  } else {
+    stage = 3;
+    bool there = map->paths(road_pos) != 0;
+    update_map_cursor_pos(road_pos);
+    bool r = demolish_road_at_cursor();
+    lan_game->note(r ? "LANROAD: ROAD REMOVED" : "LANROAD: ROAD NOT REMOVED");
+    Log::Info["lan"] << "LANROAD: road there " << there << ", removed " << r;
+  }
+}
