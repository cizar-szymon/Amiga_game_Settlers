+/* The other side's files come some seconds after the dump (16 frames a
+   step); without them by then, the report goes with the files of this
+   side. */
+static const unsigned int kLanReportWaitMs = 30000;
+/* Busy (an F10 report going out): tried again so much later. */
+static const unsigned int kLanReportRetryMs = 2000;
+
+void
+Interface::start_lan_report(const std::string &text) {
+  if (!report_send) return;
+  /* (A second report while one is still going out: these files are
+     already copied by the sending, see lan_report_files.) */
+  lan_report_text = text;
+  lan_report_due = EventLoop::get_instance().get_ticks() + kLanReportWaitMs;
+  if (lan_report != LanReportSending) lan_report = LanReportWaiting;
+}
+
+void
+Interface::lan_report_complete() {
+  if (lan_report == LanReportWaiting) {
+    lan_report_due = EventLoop::get_instance().get_ticks();
+  }
+}
+
+void
+Interface::remove_sent_lan_files(const std::vector<std::string> &files) {
+  for (const std::string &path : files) {
+    size_t n = path.size();
+    if (n > 10 && path.compare(n - 10, 10, "M.lan.save") == 0) continue;
+    std::remove(path.c_str());
+  }
+}
+
+void
+Interface::pump_lan_report() {
+  if (lan_report == LanReportNone || !report_send) return;
+  if (lan_report == LanReportWaiting) {
+    unsigned int now = EventLoop::get_instance().get_ticks();
+    if (static_cast<int>(now - lan_report_due) < 0) return;
+    if (report_files.empty()) {
+      lan_report = LanReportNone;
+      return;
+    }
+    std::string email = Settings::get_instance().get("report", "email",
+                                                     std::string());
+    if (!report_send("LAN", report_files, email, lan_report_text)) {
+      /* An F10 report going out (one at a time): again a little later. */
+      lan_report_due = now + kLanReportRetryMs;
+      return;
+    }
+    lan_report_files = report_files;
+    report_files.clear();
+    lan_report = LanReportSending;
+    if (lan_game) lan_game->note(_("SENDING THE BUG REPORT"));
+    return;
+  }
+  /* Sending: the result (only this one is out now, an F10 box could not
+     start its own). */
+  std::string text;
+  bool ok = false;
+  if (!report_result || !report_result(&text, &ok)) return;
+  lan_report = report_files.empty() ? LanReportNone : LanReportWaiting;
+  if (ok) {
+    remove_sent_lan_files(lan_report_files);
+    lan_report_files.clear();
+    if (lan_game) {
+      lan_game->note(text_with(_("BUG REPORT NO. %s SENT"), text));
+    }
+    Log::Info["lan"] << "LAN report sent: no. " << text;
+  } else {
+    /* Not sent: the box, SEND again (the files stay on this Amiga). */
+    Log::Warn["lan"] << "LAN report not sent: " << text;
+    for (const std::string &p : lan_report_files) add_report_file(p);
+    lan_report_files.clear();
+    lan_report = LanReportNone;
+    open_lan_report_box();
+  }
+}
