+/* Profiling (the Amiga port's mapgentest): when mapgen_ms is set, the
+   milliseconds of each phase of generate() add up in mapgen_phase. */
+unsigned long (*mapgen_ms)() = nullptr;
+unsigned long mapgen_phase[16];
+#define MG_T(i) do { \
+    if (mapgen_ms) { \
+      unsigned long n_ = mapgen_ms(); \
+      mapgen_phase[i] += n_ - mg_last; \
+      mg_last = n_; \
+    } \
+  } while (0)
+
 void ClassicMapGenerator::generate() {
+  unsigned long mg_last = mapgen_ms ? mapgen_ms() : 0;
   rnd ^= Random(0x5a5a, 0xa5a5, 0xc3c3);
 
   random_int();
   random_int();
 
-  init_heights_squares();
+  init_heights_squares(); MG_T(0);
   switch (height_generator) {
     case HeightGeneratorMidpoints:
       init_heights_midpoints(); /* Midpoint displacement algorithm */
@@ -84,26 +97,26 @@ void ClassicMapGenerator::generate() {
       NOT_REACHED();
   }
 
-  clamp_heights();
-  create_water_bodies();
-  heights_rebase();
-  init_types();
-  remove_islands();
-  heights_rescale();
+  clamp_heights(); MG_T(1);
+  create_water_bodies(); MG_T(2);
+  heights_rebase(); MG_T(3);
+  init_types(); MG_T(4);
+  remove_islands(); MG_T(5);
+  heights_rescale(); MG_T(6);
 
   // Adjust terrain types on shores
-  change_shore_water_type();
-  change_shore_grass_type();
+  change_shore_water_type(); MG_T(7);
+  change_shore_grass_type(); MG_T(8);
 
   // Create deserts
-  create_deserts();
+  create_deserts(); MG_T(9);
 
