 }
 
+void
+GameInitBox::request_map_preview() {
+  preview_pending = true;
+  preview_due = EventLoop::get_instance().get_ticks() + 400;
+  minimap->set_displayed(false);
+  set_redraw();
+}
+
 void
 GameInitBox::generate_map_preview() {
+  preview_pending = false;
+  minimap->set_displayed(game_type != GameLoad);
   map.reset(new Map(MapGeometry(mission->get_map_size())));
   if (game_type == GameMission || game_type == GameTutorial) {
     ClassicMissionMapGenerator generator(*map, mission->get_random_base());
diff --git a/src/game-init.h b/src/game-init.h
