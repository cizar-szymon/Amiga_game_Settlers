+/* The part of the land road network a flag is in (flags joined by land
+   paths, either way): flags of different parts cannot reach each other
+   by a land search. Made again when the network changed. */
+extern unsigned int flag_graph_version;
+
+unsigned int
+Game::flag_land_component(Flag *flag) {
+  if (land_parts_version != flag_graph_version) {
+    land_parts_version = flag_graph_version;
+    unsigned int n = flags.get_max_index() + 1;
+    land_part.assign(n, 0);
+    for (unsigned int i = 0; i < n; i++) land_part[i] = i;
+    /* Union-find, the root of a part the lowest index. */
+    auto find = [this](unsigned int x) {
+      while (land_part[x] != x) {
+        land_part[x] = land_part[land_part[x]];
+        x = land_part[x];
+      }
+      return x;
+    };
+    for (Flag *f : flags) {
+      unsigned int a = f->get_index();
+      for (int d = 0; d < 6; d++) {
+        if (!f->is_water_path(static_cast<Direction>(d))) {
+          Flag *o = f->get_other_end_flag(static_cast<Direction>(d));
+          if (o == nullptr) continue;
+          unsigned int ra = find(a), rb = find(o->get_index());
+          if (ra != rb) land_part[std::max(ra, rb)] = std::min(ra, rb);
+        }
+      }
+    }
+    for (unsigned int i = 0; i < n; i++) land_part[i] = find(i);
+  }
+  unsigned int idx = flag->get_index();
+  return idx < land_part.size() ? land_part[idx] : idx;
+}
