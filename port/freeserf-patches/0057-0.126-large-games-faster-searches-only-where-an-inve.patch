+/* Whether some inventory of the player could give a serf as
+   send_serf_to_flag_search_cb would (its tests, without the road between):
+   when none can, the search over the roads would fail anyway. A large game
+   with buildings waiting for knights or workers that nobody has searched
+   the whole road network for each of them on every step (Amiga port). */
+bool
+Game::inventory_could_send_serf(Flag *dest, int type,
+                                Resource::Type res1, Resource::Type res2) {
+  unsigned int owner = dest->get_owner();
+  unsigned int part = flag_land_component(dest);
+  for (Inventory *inv : inventories) {
+    if (inv->get_owner() != owner) continue;
+    /* Not in the part of the network of the flag: not reached. */
+    Flag *inv_flag = flags[inv->get_flag_index()];
+    if (inv_flag == nullptr || flag_land_component(inv_flag) != part) continue;
+    if (type < 0) {
+      for (int i = 4; i >= -type-1; i--) {
+        if (inv->have_serf((Serf::Type)(Serf::TypeKnight0+i))) return true;
+      }
+      if (type == -1 && inv->have_serf(Serf::TypeGeneric) &&
+          inv->get_count_of(Resource::TypeSword) > 0 &&
+          inv->get_count_of(Resource::TypeShield) > 0) {
+        return true;
+      }
+    } else if (inv->have_serf((Serf::Type)type)) {
+      if (type != Serf::TypeGeneric || inv->free_serf_count() > 4) {
+        return true;
+      }
+    } else if (inv->have_serf(Serf::TypeGeneric) &&
+               (res1 == -1 || inv->get_count_of(res1) > 0) &&
+               (res2 == -1 || inv->get_count_of(res2) > 0)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+/* The same for a transporter (sailor) of a road (call_transporter). */
+bool
+Game::inventory_could_send_transporter(Flag *src, Flag *src_2, bool water) {
+  unsigned int owner = src->get_owner();
+  unsigned int part = flag_land_component(src);
+  unsigned int part_2 = flag_land_component(src_2);
+  for (Inventory *inv : inventories) {
+    if (inv->get_owner() != owner) continue;
+    Flag *inv_flag = flags[inv->get_flag_index()];
+    if (inv_flag == nullptr) continue;
+    unsigned int p = flag_land_component(inv_flag);
+    if (p != part && p != part_2) continue;
+    if (inv->have_serf(water ? Serf::TypeSailor : Serf::TypeTransporter)) {
+      return true;
+    }
+    if (inv->have_serf(Serf::TypeGeneric) &&
+        (!water || inv->get_count_of(Resource::TypeBoat) > 0)) {
+      return true;
+    }
+  }
+  return false;
+}
