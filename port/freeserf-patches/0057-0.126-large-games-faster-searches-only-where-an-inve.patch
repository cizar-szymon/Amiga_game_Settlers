 #define SEARCH_MAX_DEPTH  0x10000
 
+/* Counters (simtest -p): searches, flags visited, failed searches. */
+unsigned long flag_search_count[8];
+
+/* Raised by every change of the road network (paths added or removed,
+   ends linked, flags made or read): Game::flag_land_component() makes
+   the parts of the network again when it changed. */
+unsigned int flag_graph_version = 1;
+
+/* Queues of finished searches, used again (a search a few dozen times a
+   step otherwise allocated its queue each time). */
+static std::vector<std::vector<Flag*>> search_queue_pool;
+
 FlagSearch::FlagSearch(Game *game_) {
   game = game_;
   id = game->next_search_id();
+  if (!search_queue_pool.empty()) {
+    queue.swap(search_queue_pool.back());
+    search_queue_pool.pop_back();
+    queue.clear();
+  } else {
+    queue.reserve(64);
+  }
+}
+
+FlagSearch::~FlagSearch() {
+  queue.clear();
+  search_queue_pool.push_back(std::vector<Flag*>());
+  search_queue_pool.back().swap(queue);
 }
 
