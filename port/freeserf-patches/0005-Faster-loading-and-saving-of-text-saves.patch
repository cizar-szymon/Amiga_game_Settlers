diff --git a/src/savegame.cc b/src/savegame.cc
index 677285d..059c97e 100644
--- a/src/savegame.cc
+++ b/src/savegame.cc
@@ -328,14 +328,46 @@ SaveReaderBinary::read(size_t size) {
   return data;
 }
 
+/* The parts of a list split at the commas, without a stream: the maps of
+   a save have some 50000 numbers, and a stringstream per value made the
+   load take seconds on a 68060. Empty parts are kept, but not a last
+   empty one, as std::getline did. */
 SaveReaderTextValue::SaveReaderTextValue(const std::string &_value)
   : value(_value) {
-  if (value.find(',') != std::string::npos) {
-    std::istringstream iss(value);
-    std::string item;
-    while (std::getline(iss, item, ',')) {
-      parts.emplace_back(item);
-    }
+  size_t comma = value.find(',');
+  if (comma == std::string::npos) return;
+  parts.reserve(std::count(value.begin(), value.end(), ',') + 1);
+  size_t start = 0;
+  while (comma != std::string::npos) {
+    parts.emplace_back(value.data() + start, comma - start);
+    start = comma + 1;
+    comma = value.find(',', start);
+  }
+  if (start < value.size()) {
+    parts.emplace_back(value.data() + start, value.size() - start);
+  }
+}
+
+/* Numbers appended in decimal without a stream (an ostringstream per
+   number made the save take seconds on a 68060). */
+static void
+append_number(std::string *out, unsigned int val) {
+  char buf[12];
+  char *p = buf + sizeof(buf);
+  do {
+    *--p = static_cast<char>('0' + val % 10);
+    val /= 10;
+  } while (val != 0);
+  out->append(p, buf + sizeof(buf) - p);
+}
+
+static void
+append_number(std::string *out, int val) {
+  if (val < 0) {
+    out->push_back('-');
+    append_number(out, 0u - static_cast<unsigned int>(val));
+  } else {
+    append_number(out, static_cast<unsigned int>(val));
   }
 }
 
@@ -350,8 +382,19 @@ SaveReaderTextValue::operator >> (int &val) const {
 const SaveReaderTextValue&
 SaveReaderTextValue::operator >> (unsigned int &val) const {
   /* Not atoi(): a value over the range of int (as 4294967295) stays,
-     whatever the size of long (32 bits on Windows). */
-  val = static_cast<unsigned int>(std::strtoull(value.c_str(), nullptr, 10));
+     whatever the size of long (32 bits on Windows). As strtoull() and a
+     cast, but in 32 bits: strtoull's 64-bit arithmetic is done in software
+     on a 68k, and the maps of a save have some 150000 numbers. */
+  const char *p = value.c_str();
+  while (*p == ' ' || *p == '\t') p++;
+  bool negative = (*p == '-');
+  if (*p == '-' || *p == '+') p++;
+  unsigned int result = 0;
+  while (*p >= '0' && *p <= '9') {
+    result = result * 10 + static_cast<unsigned int>(*p - '0');
+    p++;
+  }
+  val = negative ? 0u - result : result;
 
   return *this;
 }
@@ -417,9 +460,7 @@ SaveWriterTextValue::operator << (int val) {
     value += ",";
   }
 
-  std::ostringstream ss;
-  ss << val;
-  value += ss.str();
+  append_number(&value, val);
 
   return *this;
 }
@@ -430,9 +471,7 @@ SaveWriterTextValue::operator << (unsigned int val) {
     value += ",";
   }
 
-  std::ostringstream ss;
-  ss << val;
-  value += ss.str();
+  append_number(&value, val);
 
   return *this;
 }
@@ -443,9 +482,7 @@ SaveWriterTextValue::operator << (Direction val) {
     value += ",";
   }
 
-  std::ostringstream ss;
-  ss << static_cast<int>(val);
-  value += ss.str();
+  append_number(&value, static_cast<int>(val));
 
   return *this;
 }
@@ -456,9 +493,7 @@ SaveWriterTextValue::operator << (Resource::Type val) {
     value += ",";
   }
 
-  std::ostringstream ss;
-  ss << static_cast<int>(val);
-  value += ss.str();
+  append_number(&value, static_cast<int>(val));
 
   return *this;
 }
