+/* The internet game: the game server, the names, the games waiting there
+   (a click takes the code), the code; NEW GAME makes one (its code for
+   the other player), JOIN GAME joins the one with the code. */
+void
+LanBox::draw_internet(LanLink::State state) {
+  bool waiting = state == LanLink::StateServing;
+  bool asking = state == LanLink::StateSearching;
+  bool connecting = state == LanLink::StateConnecting;
+  draw_centered(24, _("A game over the internet"));
+  if (waiting) {
+    std::string code = link() != nullptr ? link()->get_relay_code() : "";
+    std::string pass = password_field->get_text();
+    const std::string rows[][2] = {
+      { _("Game server"), relay_address() },
+      { _("Your name"), internet_name_field->get_text() },
+      { _("Game name"), game_name_field->get_text() },
+      { _("Code of the game"), code.empty() ? std::string("...") : code },
+      { _("Password"), pass.empty() ? std::string(_("none")) : pass },
+    };
+    draw_rows(kInternetRowsY, rows, sizeof(rows) / sizeof(rows[0]),
+              kServerRowStep);
+    if (code.empty()) {
+      draw_centered(kInternetListY + 8, _("Making the game..."));
+    } else {
+      draw_centered(kInternetListY, _("The other player chooses it"));
+      draw_centered(kInternetListY + 10, _("in JOIN GAME or types the code."));
+      draw_centered(kInternetListY + 30, _("Waiting for a player..."));
+    }
+    draw_text_button(kLeftButtonX, kInternetButtonsY, kButtonWidth,
+                     _("CANCEL GAME"));
+    draw_text_button(kRightButtonX, kInternetButtonsY, kButtonWidth,
+                     _("JOIN GAME"), false);
+  } else {
+    frame->draw_string(kLabelX, kInternetRowsY, _("Game server"),
+                       Color::green, Color::black);
+    frame->draw_string(kLabelX, kInternetRowsY + kServerRowStep,
+                       _("Your name"), Color::green, Color::black);
+    frame->draw_string(kLabelX, kInternetRowsY + 2 * kServerRowStep,
+                       _("Game name"), Color::green, Color::black);
+    frame->draw_string(kListX, kInternetListLabelY,
+                       asking ? _("Asking the game server...")
+                              : _("Games waiting"),
+                       Color::green, Color::black);
+    draw_text_button(kRefreshX, kRefreshY, 80, _("REFRESH"), !asking);
+    frame->fill_rect(kListX, kInternetListY, kListW, kListH, Color::black);
+    if (servers.empty() && !asking) {
+      frame->draw_string(kListX + 4, kInternetListY + 4,
+                         _("None - NEW GAME makes one."), Color::green);
+    }
+    for (size_t i = 0; i < servers.size() && i < kListRows; i++) {
+      const LanLink::Server &s = servers[i];
+      int y = kInternetListY + 2 + 8 * static_cast<int>(i);
+      ReadableText readable;
+      frame->draw_string(kListX + 4, y, s.address + (s.password ? "*" : ""),
+                         Color::green);
+      frame->draw_string(kListX + 44, y, s.name, Color::green);
+      frame->draw_string(kListX + 172, y, s.player, Color::green);
+      std::string w = std::to_string(s.waiting_s / 60) + " min";
+      frame->draw_string(kListX + kListW - 4 - frame->get_string_width(w), y,
+                         w, Color::green);
+    }
+    frame->draw_string(kLabelX, kInternetCodeY, _("Code of the game"),
+                       Color::green, Color::black);
+    frame->draw_string(kLabelX, kInternetPasswordY, _("Password"),
+                       Color::green, Color::black);
+    draw_text_button(kLeftButtonX, kInternetButtonsY, kButtonWidth,
+                     _("NEW GAME"), !connecting);
+    draw_text_button(kRightButtonX, kInternetButtonsY, kButtonWidth,
+                     connecting ? _("CONNECTING") : _("JOIN GAME"),
+                     !connecting);
+  }
+  draw_text_button(kButtonX, kInternetBackY, kButtonWidth, _("BACK"));
+}
+
+/* RELAYAUTO: the clicks of a player. */
+void
+LanBox::relay_auto_step() {
+  unsigned int now = EventLoop::get_instance().get_ticks();
+  if (relay_auto_due == 0) relay_auto_due = now + 2000;
+  if (static_cast<int>(now - relay_auto_due) < 0) return;
+  relay_auto_due = now + 3000;
+  bool host = relay_auto == "HOST";
+  LanLink::State state = link_state();
+  if (view == ViewChoose) {
+    handle_click_left(kButtonX + 4, kInternetButtonY + 4);
+  } else if (view == ViewInternet && state == LanLink::StateIdle) {
+    if (!relay_auto_password.empty()) {
+      password_field->set_text(relay_auto_password);
+    }
+    if (host) {
+      handle_click_left(kLeftButtonX + 4, kInternetButtonsY + 4);
+    } else if (!servers.empty()) {
+      handle_click_left(kListX + 8, kInternetListY + 3);
+      handle_click_left(kRightButtonX + 4, kInternetButtonsY + 4);
+      relay_auto_due = now + 6000;
+    } else {
+      handle_click_left(kRefreshX + 4, kRefreshY + 4);
+    }
+  } else if (host && lobby()) {
+    /* START GAME a few seconds after the player joined. */
+    relay_auto_due = now + 1000;
+    if (relay_auto_joined == 0) {
+      relay_auto_joined = now;
+    } else if (static_cast<int>(now - relay_auto_joined) >= 5000) {
+      relay_auto_joined = 0;
+      handle_click_left(kRightButtonX + 4, kLobbyButtonsY + 4);
+    }
+  }
+}
+
+void
+LanBox::internet_click(int x, int y, LanLink *l, LanLink::State state) {
+  bool waiting = state == LanLink::StateServing;
+  if (inside(x, y, kButtonX, kInternetBackY, kButtonWidth, kButtonHeight)) {
+    play_sound(Audio::TypeSfxClick);
+    set_view(ViewChoose);
+    return;
+  }
+  if (l == nullptr) {
+    play_sound(Audio::TypeSfxNotAccepted);
+    message = _(kNoNetwork);
+    set_redraw();
+    return;
+  }
+  if (waiting) {
+    if (inside(x, y, kLeftButtonX, kInternetButtonsY, kButtonWidth,
+               kButtonHeight)) {
+      /* CANCEL GAME: the game on the server is gone. */
+      play_sound(Audio::TypeSfxClick);
+      l->close();
+      message.clear();
+      show_fields();
+      set_redraw();
+    }
+    return;
+  }
+  if (inside(x, y, kListX, kInternetListY, kListW, kListH)) {
+    size_t row = static_cast<size_t>((y - kInternetListY - 2) / 8);
+    if (y >= kInternetListY + 2 && row < servers.size()) {
+      play_sound(Audio::TypeSfxClick);
+      code_field->set_text(servers[row].address);
+      message.clear();
+      if (servers[row].password) {
+        /* Only who knows the password joins it: typed here. */
+        message = _("The game has a password: type it.");
+        password_field->set_focused();
+      }
+      set_redraw();
+    }
+  } else if (inside(x, y, kRefreshX, kRefreshY, 80, kButtonHeight)) {
+    if (state == LanLink::StateSearching ||
+        state == LanLink::StateConnecting) {
+      play_sound(Audio::TypeSfxNotAccepted);
+    } else {
+      play_sound(Audio::TypeSfxClick);
+      message.clear();
+      servers.clear();
+      l->relay_list(relay_address());
+    }
+    set_redraw();
+  } else if (inside(x, y, kLeftButtonX, kInternetButtonsY, kButtonWidth,
+                    kButtonHeight)) {
+    if (state == LanLink::StateConnecting) {
+      play_sound(Audio::TypeSfxNotAccepted);
+      return;
+    }
+    play_sound(Audio::TypeSfxClick);
+    message.clear();
+    internet = true;
+    l->relay_create(relay_address(), internet_name_field->get_text(),
+                    game_name_field->get_text(), password_field->get_text());
+    show_fields();
+    set_redraw();
+  } else if (inside(x, y, kRightButtonX, kInternetButtonsY, kButtonWidth,
+                    kButtonHeight)) {
+    std::string code = code_field->get_text();
+    for (char &c : code) {
+      if (c >= 'a' && c <= 'z') c = static_cast<char>(c - 'a' + 'A');
+    }
+    if (code.size() != 4 || state == LanLink::StateConnecting) {
+      play_sound(Audio::TypeSfxNotAccepted);
+      if (code.size() != 4) {
+        message = _("Choose a game or type its code.");
+      }
+    } else {
+      play_sound(Audio::TypeSfxClick);
+      internet = true;
+      message = _("Connecting to the game server...");
+      l->relay_join(relay_address(), internet_name_field->get_text(), code,
+                    password_field->get_text());
+    }
+    set_redraw();
+  }
+}
