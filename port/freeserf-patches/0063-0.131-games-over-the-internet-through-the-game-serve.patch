+/* A game server: letters, digits and . : - of a name or an address with
+   its port. */
+static bool
+relay_filter(const char key, TextInput *text_input) {
+  return (key >= 'a' && key <= 'z') || (key >= 'A' && key <= 'Z') ||
+         (key >= '0' && key <= '9') || key == '.' || key == ':' ||
+         key == '-';
+}
+
+/* The code of a game on the game server: letters and digits. */
+static bool
+code_filter(const char key, TextInput *text_input) {
+  return (key >= 'a' && key <= 'z') || (key >= 'A' && key <= 'Z') ||
+         (key >= '0' && key <= '9');
+}
