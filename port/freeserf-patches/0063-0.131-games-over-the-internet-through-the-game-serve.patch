+void
+Interface::open_report_box() {
+  if (report_box != nullptr) {
+    return;  /* one at a time: a second F10 only saved again */
+  }
+  report_box = new ReportBox(this, false);
+  add_float(report_box, (width - ReportBox::kWidth) / 2,
+            (height - ReportBox::kHeight) / 2);
+  report_box->set_displayed(true);
+  report_box->set_enabled(true);
+}
+
+void
+Interface::open_lan_report_box() {
+  if (!report_send) return;
+  close_report_box();
+  report_box = new ReportBox(this, true);
+  add_float(report_box, (width - ReportBox::kWidth) / 2,
+            (height - ReportBox::kHeight) / 2);
+  report_box->set_displayed(true);
+  report_box->set_enabled(true);
+}
+
+void
+Interface::add_report_file(const std::string &path) {
+  for (const std::string &p : report_files) {
+    if (p == path) return;
+  }
+  report_files.push_back(path);
+}
+
+void
+Interface::close_report_box() {
+  if (report_box != nullptr) {
+    report_box->set_displayed(false);
+    del_float(report_box);
+    delete report_box;
+    report_box = nullptr;
+  }
+}
