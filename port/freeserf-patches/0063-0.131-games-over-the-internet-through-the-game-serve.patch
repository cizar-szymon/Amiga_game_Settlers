+/*
+ * report-box.h - The bug report box: after F10 saved the state of the game
+ * (the Amiga port), the player may send it to the game server with an
+ * e-mail address (to hear when the bug is fixed) and a few words.
+ *
+ * Copyright (C) 2026  The Amiga port of Freeserf
+ *
+ * This file is part of freeserf.
+ *
+ * freeserf is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#ifndef SRC_REPORT_BOX_H_
+#define SRC_REPORT_BOX_H_
+
+#include <memory>
+#include <string>
+
+#include "src/gui.h"
+
+class Interface;
+class TextInput;
+class ReportText;
+
+class ReportBox : public GuiObject {
+ public:
+  /* Fits the smallest screen of the port, 400x300. */
+  static const int kWidth = 400;
+  static const int kHeight = 300;
+  /* What happened: so many letters (23 lines of 46 shown, all of it fits;
+     a longer one would show its last lines). */
+  static const int kTextMax = 1000;
+
+ protected:
+  Interface *interface;
+  std::unique_ptr<TextInput> email_field;
+  std::unique_ptr<ReportText> text_field;
+  typedef enum Stage {
+    StageAsk,       /* SEND or CANCEL */
+    StageSending,
+    StageDone,      /* sent: CLOSE */
+    StageFailed     /* not sent: SEND again or CANCEL */
+  } Stage;
+  Stage stage;
+  std::string status;
+  /* A LAN game out of step: the saves of both sides (Interface::
+     get_report_files), sent as kind LAN; else the state of F10. */
+  bool lan;
+
+ public:
+  ReportBox(Interface *interface, bool lan);
+  virtual ~ReportBox();
+
+  /* With every update of the interface: the result of the sending. */
+  void update();
+  /* Return: SEND (not while typing what happened), or CLOSE when it is
+     sent. */
+  void handle_return();
+  /* Tab: typing in the other field. */
+  void next_field();
+
+ protected:
+  virtual void internal_draw();
+  virtual bool handle_click_left(int x, int y);
+  void send();
+  void draw_centered(int y, const std::string &text);
+  static bool inside(int x, int y, int bx, int by, int bw, int bh);
+};
+
+#endif  // SRC_REPORT_BOX_H_
