+static const int kEmailY = 45;
+static const int kEmailWidth = ReportBox::kWidth - 16 - kEmailX;
+static const int kTextLabelY = 70;
+static const int kTextY = 80;
+static const int kTextLines = 23;
+static const int kStatusY = 22;
+static const int kButtonsY = 272;
+static const int kButtonWidth = 112;
+static const int kButtonHeight = 16;
+static const int kLeftButtonX = 16;
+/* Clear of the exit sign in the corner. */
+static const int kRightButtonX = ReportBox::kWidth - 40 - kButtonWidth;
+
+/* What happened: a field of many lines, broken between words; when it is
+   full, the last lines are shown. */
+class ReportText : public TextInput {
+ public:
+  bool is_focused() const { return focused; }
+
+ protected:
+  virtual void internal_draw() {
+    ReadableText readable;
+    frame->fill_rect(0, 0, width, height, color_background);
+    if (focused) frame->draw_rect(0, 0, width, height, color_focus);
+    std::vector<std::string> lines;
+    std::string rest = text;
+    int room = width - 2;
+    while (!rest.empty()) {
+      size_t n = 1;
+      while (n < rest.size() &&
+             frame->get_string_width(rest.substr(0, n + 1)) <= room) {
+        n++;
+      }
+      if (n < rest.size()) {
+        /* Not in the middle of a word, if a space is on the line. */
+        size_t space = rest.rfind(' ', n);
+        if (space != std::string::npos && space > 0) n = space + 1;
+      }
+      lines.push_back(rest.substr(0, n));
+      rest.erase(0, n);
+    }
+    if (lines.empty() || (focused && frame->get_string_width(lines.back() + "_")
+                                     > room)) {
+      lines.push_back("");
+    }
+    int shown = (height - 2) / 8;
+    size_t first = lines.size() > static_cast<size_t>(shown)
+                   ? lines.size() - shown : 0;
+    int y = 1;
+    for (size_t i = first; i < lines.size(); i++) {
+      std::string line = lines[i];
+      if (focused && i + 1 == lines.size()) line += "_";  /* the cursor */
+      frame->draw_string(1, y, line, color_text);
+      y += 8;
+    }
+  }
+};
+
+/* An e-mail address: letters, digits and @ . _ - + */
+static bool
+email_filter(const char key, TextInput *text_input) {
+  return (key >= 'a' && key <= 'z') || (key >= 'A' && key <= 'Z') ||
+         (key >= '0' && key <= '9') || key == '@' || key == '.' ||
+         key == '_' || key == '-' || key == '+';
+}
+
+/* A few words: the letters and signs the fonts of the game have. */
+static bool
+text_filter(const char key, TextInput *text_input) {
+  return (key >= 'a' && key <= 'z') || (key >= 'A' && key <= 'Z') ||
+         (key >= '0' && key <= '9') ||
+         std::string(" .,:;-?!'()/+=%@_#").find(key) != std::string::npos;
+}
+
+ReportBox::ReportBox(Interface *_interface, bool _lan)
+  : interface(_interface)
+  , email_field(new TextInput())
+  , text_field(new ReportText())
+  , stage(StageAsk)
+  , lan(_lan) {
+  opaque = true;
+  set_size(kWidth, kHeight);
+  email_field->set_size(kEmailWidth, 18);
+  email_field->set_max_length(60);
+  email_field->set_filter(email_filter);
+  email_field->set_text(Settings::get_instance().get("report", "email",
+                                                     std::string()));
+  add_float(email_field.get(), kEmailX, kEmailY);
+  text_field->set_size(kFieldWidth, 2 + 8 * kTextLines);
+  text_field->set_max_length(kTextMax);
+  text_field->set_filter(text_filter);
+  add_float(text_field.get(), kFieldX, kTextY);
+  email_field->set_displayed(true);
+  text_field->set_displayed(true);
+  /* Typing at once: the e-mail, or what happened when the e-mail is
+     known. */
+  if (email_field->get_text().empty()) {
+    email_field->set_focused();
+  } else {
+    text_field->set_focused();
+  }
+}
+
+ReportBox::~ReportBox() {
+  Settings &settings = Settings::get_instance();
+  settings.set("report", "email", email_field->get_text());
+  settings.save();
+}
+
+bool
+ReportBox::inside(int x, int y, int bx, int by, int bw, int bh) {
+  return x >= bx && x < bx + bw && y >= by && y < by + bh;
+}
+
+void
+ReportBox::draw_centered(int y, const std::string &text) {
+  frame->draw_string((width - frame->get_string_width(text)) / 2, y, text,
+                     Color::green, Color::black);
+}
+
+void
+ReportBox::internal_draw() {
+  /* All of this box in the readable font, whatever font the player
+     chose. */
+  ReadableText readable;
+  for (int y = 0; y < height; y += 16) {
+    for (int x = 0; x < width; x += 16) {
+      frame->draw_sprite(x, y, Data::AssetIcon,
+                         PopupBox::PatternDiagonalGreen);
+    }
+  }
+  draw_box_frame(frame, width, height);
+  draw_centered(9, _("Bug report"));
+  if (!status.empty()) {
+    draw_centered(kStatusY + 5, status);
+  } else if (lan) {
+    draw_centered(kStatusY, _("The LAN game went out of step."));
+    draw_centered(kStatusY + 10, _("Send the saves of both sides?"));
+  } else {
+    draw_centered(kStatusY, _("The state of the game is saved."));
+    draw_centered(kStatusY + 10, _("Send it to the author of the port?"));
+  }
+  frame->draw_string(kLabelX, kEmailLabelY, _("Your e-mail"), Color::green,
+                     Color::black);
+  frame->draw_string(kLabelX, kEmailLabelY + 9, _("(for an answer)"),
+                     Color::green, Color::black);
+  frame->draw_string(kLabelX, kTextLabelY, _("What happened"), Color::green,
+                     Color::black);
+  std::string count = std::to_string(text_field->get_text().size()) + " / " +
+                      std::to_string(kTextMax);
+  frame->draw_string(width - 16 - frame->get_string_width(count), kTextLabelY,
+                     count, Color::green, Color::black);
+  bool busy = stage == StageSending;
+  if (stage == StageDone) {
+    ::draw_text_button(frame, (width - kButtonWidth) / 2, kButtonsY,
+                       kButtonWidth, _("CLOSE"), true);
+  } else {
+    ::draw_text_button(frame, kLeftButtonX, kButtonsY, kButtonWidth,
+                       _("SEND"), !busy);
+    ::draw_text_button(frame, kRightButtonX, kButtonsY, kButtonWidth,
+                       _("CANCEL"), !busy);
+  }
+  frame->draw_sprite(width - 8 - kExitSize, height - 7 - kExitSize,
+                     Data::AssetIcon, 60);  // Exit
+}
+
+void
+ReportBox::send() {
+  if (!Interface::report_send) {
+    status = _("No network in this version.");
+    stage = StageFailed;
+    return;
+  }
+  std::vector<std::string> files;
+  if (lan) files = interface->get_report_files();
+  if (Interface::report_send(lan ? "LAN" : "F10", files,
+                             email_field->get_text(),
+                             text_field->get_text())) {
+    stage = StageSending;
+    status = _("Sending the report...");
+  } else {
+    stage = StageFailed;
+    status = _("The report was not sent.");
+  }
+}
+
+void
+ReportBox::update() {
+  if (stage != StageSending || !Interface::report_result) return;
+  std::string text;
+  bool ok = false;
+  if (!Interface::report_result(&text, &ok)) return;
+  if (ok) {
+    stage = StageDone;
+    status = text_with(_("Report no. %s sent. Thank you!"), text);
+    play_sound(Audio::TypeSfxAccepted);
+    if (lan) {
+      /* On the server now: off this Amiga, but for the save of this side
+         (SYNC_..M, kept as before). */
+      for (const std::string &path : interface->get_report_files()) {
+        size_t n = path.size();
+        if (n > 10 && path.compare(n - 10, 10, "M.lan.save") == 0) continue;
+        std::remove(path.c_str());
+      }
+      interface->clear_report_files();
+    }
+  } else {
+    stage = StageFailed;
+    status = _(text.c_str());
+    play_sound(Audio::TypeSfxNotAccepted);
+  }
+  set_redraw();
+}
+
+void
+ReportBox::next_field() {
+  if (text_field->is_focused()) {
+    email_field->set_focused();
+  } else {
+    text_field->set_focused();
+  }
+  set_redraw();
+}
+
+void
+ReportBox::handle_return() {
+  if (stage != StageDone && text_field->is_focused()) {
+    return;  /* Typing what happened: SEND with the mouse. */
+  }
+  if (stage == StageDone) {
+    play_sound(Audio::TypeSfxClick);
+    interface->close_report_box();  /* Deletes this box. */
+  } else if (stage != StageSending) {
+    play_sound(Audio::TypeSfxClick);
+    send();
+    set_redraw();
+  }
+}
+
+bool
+ReportBox::handle_click_left(int x, int y) {
+  if (inside(x, y, width - 8 - kExitSize, height - 7 - kExitSize, kExitSize,
+             kExitSize)) {
+    play_sound(Audio::TypeSfxClick);
+    interface->close_report_box();  /* Deletes this box. */
+    return true;
+  }
+  if (stage == StageSending) {
+    return true;
+  }
+  if (stage == StageDone) {
+    if (inside(x, y, (width - kButtonWidth) / 2, kButtonsY, kButtonWidth,
+               kButtonHeight)) {
+      play_sound(Audio::TypeSfxClick);
+      interface->close_report_box();
+    }
+    return true;
+  }
+  if (inside(x, y, kLeftButtonX, kButtonsY, kButtonWidth, kButtonHeight)) {
+    play_sound(Audio::TypeSfxClick);
+    send();
+    set_redraw();
+  } else if (inside(x, y, kRightButtonX, kButtonsY, kButtonWidth,
+                    kButtonHeight)) {
+    play_sound(Audio::TypeSfxClick);
+    interface->close_report_box();
+  }
+  return true;
+}
