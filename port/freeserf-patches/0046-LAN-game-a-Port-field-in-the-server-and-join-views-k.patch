+/* Digits of a port. */
+static bool
+port_filter(const char key, TextInput *text_input) {
+  return key >= '0' && key <= '9';
+}
+
+/* 1..65535 from the text, 0 if it is not a port. */
+static int
+port_from_text(const std::string &text) {
+  if (text.empty() || text.size() > 5) {
+    return 0;
+  }
+  int value = 0;
+  for (char c : text) {
+    if (c < '0' || c > '9') {
+      return 0;
+    }
+    value = value * 10 + (c - '0');
+  }
+  return (value >= 1 && value <= 65535) ? value : 0;
+}
+
+/* The field of the port: what is typed becomes the port when it is one
+   (checked when the field loses the focus and before the port is used),
+   otherwise the field shows the port again. */
+class PortInput : public TextInput {
+ protected:
+  int *port;
+
+ public:
+  explicit PortInput(int *_port) : port(_port) {
+    set_size(kPortWidth, 10);
+    set_max_length(5);
+    set_filter(port_filter);
+    set_displayed(false);
+    show();
+  }
+
+  void show() { set_text(std::to_string(*port)); }
+
+  void check() {
+    int value = port_from_text(get_text());
+    if (value != 0) {
+      *port = value;
+    }
+    show();
+  }
+
+ protected:
+  virtual bool handle_focus_loose() {
+    check();
+    return TextInput::handle_focus_loose();
+  }
+};
