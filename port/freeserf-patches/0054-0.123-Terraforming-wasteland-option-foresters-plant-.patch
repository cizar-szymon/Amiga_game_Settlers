+static bool
+is_sand(Map::Terrain t) {
+  return t >= Map::TerrainDesert0 && t <= Map::TerrainDesert2;
+}
+
+/* The sand of the two triangles of a place to grass (the plain grass the
+   foresters plant on). */
+static void
+green_place(Map *map, MapPos pos) {
+  Map::Terrain up = map->type_up(pos), down = map->type_down(pos);
+  if (!is_sand(up) && !is_sand(down)) return;
+  map->set_types(pos, is_sand(up) ? Map::TerrainGrass1 : up,
+                 is_sand(down) ? Map::TerrainGrass1 : down);
+}
+
+/* A tree planted at pos turns the sand around it to grass: the place and
+   the 6 around it; and of those 2 steps away the ones with land that is
+   not sand right behind them (a strip of sand one place wide would stay
+   between the new grass and the edge of the desert: it goes too). The
+   spiral goes ring by ring: 0, 1-6, 7-18, 19-36. */
+void
+Game::green_sand_around(MapPos pos) {
+  static const unsigned int kRing2End = 7, kRing3End = 19;
+  for (unsigned int off = 0; off < kRing2End; off++) {
+    green_place(map.get(), map->pos_add_spirally(pos, off));
+  }
+  for (unsigned int off = kRing2End; off < kRing3End; off++) {
+    MapPos p = map->pos_add_spirally(pos, off);
+    if (!is_sand(map->type_up(p)) && !is_sand(map->type_down(p))) continue;
+    bool edge = false;
+    for (Direction d : cycle_directions_cw()) {
+      MapPos q = map->move(p, d);
+      /* Outside the 2 rings, and some of it not sand. */
+      bool inside = false;
+      for (unsigned int k = 0; k < kRing3End && !inside; k++) {
+        inside = map->pos_add_spirally(pos, k) == q;
+      }
+      if (!inside && (!is_sand(map->type_up(q)) ||
+                      !is_sand(map->type_down(q)))) {
+        edge = true;
+        break;
+      }
+    }
+    if (edge) green_place(map.get(), p);
+  }
+}
