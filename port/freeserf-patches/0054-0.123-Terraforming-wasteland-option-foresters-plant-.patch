+/* The hint of an option: its label and what it does, words wrapped, in a
+   dark frame over the rows of the box. */
+void
+AdvancedBox::draw_hint(const std::string &label, const std::string &text,
+                       int top) {
+  int x = 12, w = width - 24;
+  std::vector<std::string> lines;
+  std::string line, word;
+  std::string all = text + " ";
+  for (char c : all) {
+    if (c != ' ') {
+      word += c;
+      continue;
+    }
+    if (word.empty()) continue;
+    std::string next = line.empty() ? word : line + " " + word;
+    if (frame->get_string_width(next) > w - 12 && !line.empty()) {
+      lines.push_back(line);
+      line = word;
+    } else {
+      line = next;
+    }
+    word.clear();
+  }
+  if (!line.empty()) lines.push_back(line);
+  int h = 10 + 12 + 10 * static_cast<int>(lines.size()) + 6;
+  frame->fill_rect(x, top, w, h, Color(0x00, 0x33, 0x1a));
+  frame->draw_rect(x, top, w, h, Color::green);
+  frame->draw_string(x + 6, top + 6, label, Color(0xdd, 0xdd, 0x00),
+                     Color::black);
+  int y = top + 6 + 14;
+  for (const std::string &l : lines) {
+    frame->draw_string(x + 6, y, l, Color::green, Color::black);
+    y += 10;
+  }
+}
+
+/* The left button down on the label of an option of the Video box: its
+   hint, until the button goes up. */
+bool
+AdvancedBox::handle_press(int x, int y) {
+  if (page != PageVideo) return false;
+  const PageInfo &info = pages[page];
+  int first_y = (info.title != nullptr) ? kTitledFirstRowY : kFirstRowY;
+  for (int i = 0; i < info.count; i++) {
+    int row_y = first_y + i * kRowHeight;
+    int label_w = frame != nullptr ?
+      frame->get_string_width(_(info.options[i].label)) : 160;
+    if (info.options[i].hint != nullptr &&
+        y >= row_y && y < row_y + kCheckSize &&
+        x >= kLabelX - 4 && x < kLabelX + label_w + 4) {
+      hint = i;
+      set_redraw();
+      return true;
+    }
+  }
+  return false;
+}
+
+bool
+AdvancedBox::handle_release() {
+  if (hint < 0) return false;
+  hint = -1;
+  set_redraw();
+  return true;
 }
 
