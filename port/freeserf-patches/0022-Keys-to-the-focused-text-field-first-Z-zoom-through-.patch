From a0ead6a74d5cff8a6a84f832f22ee9b0e0823285 Mon Sep 17 00:00:00 2001
From: cizar-szymon <szymon@cs-lab.eu>
Date: Mon, 26 Oct 2026 09:47:59 +0100
Subject: [PATCH 22/41] Keys to the focused text field first; Z zoom through
 Interface::zoom_hook

---
 src/gui.cc        | 15 +++++++++++++++
 src/interface.cc  |  3 +++
 src/interface.h   |  4 ++++
 src/popup.cc      |  1 +
 src/text-input.cc | 16 ++++++++++++----
 5 files changed, 35 insertions(+), 4 deletions(-)

diff --git a/src/gui.cc b/src/gui.cc
index 0aaf1b8..f4f1cef 100644
--- a/src/gui.cc
+++ b/src/gui.cc
@@ -143,6 +143,21 @@ GuiObject::handle_event(const Event *event) {
     event_y = static_cast<int>(static_cast<float>(event_y) / zoom);
   }
 
+  /* A key goes first to the focused object (a text field being typed
+     in) when it is on the screen, so that the keys of the game and of the
+     other objects do not take the letters away. */
+  if (event->type == Event::TypeKeyPressed && parent == nullptr &&
+      focused_object != nullptr && focused_object != this) {
+    GuiObject *o = focused_object;
+    while (o != nullptr && o != this && o->displayed && o->enabled) {
+      o = o->parent;
+    }
+    if (o == this &&
+        focused_object->handle_key_pressed(event->dx, event->dy)) {
+      return true;
+    }
+  }
+
   Event internal_event;
   internal_event.type = event->type;
   internal_event.x = event_x;
diff --git a/src/interface.cc b/src/interface.cc
index 4fad761..b10d9bb 100644
--- a/src/interface.cc
+++ b/src/interface.cc
@@ -304,6 +304,7 @@ Interface::open_keys_box() {
 Interface::PlatformBoxFactory Interface::platform_box_factory;
 int Interface::platform_box_width = 0;
 int Interface::platform_box_height = 0;
+std::function<void(int)> Interface::zoom_hook;
 
 void
 Interface::open_platform_box() {
@@ -1493,6 +1494,8 @@ Interface::handle_key_pressed(char key, int modifier) {
     case 'z':
       if (modifier & 1) {
         GameStore::get_instance().quick_save("quicksave", game.get());
+      } else if (modifier == 0 && zoom_hook) {
+        zoom_hook(0);
       }
       break;
     case 'n':
diff --git a/src/interface.h b/src/interface.h
index 3d61b0c..dd16823 100644
--- a/src/interface.h
+++ b/src/interface.h
@@ -254,6 +254,10 @@ class Interface : public GuiObject, public GameManager::Handler {
   static int platform_box_width;
   static int platform_box_height;
   void open_platform_box();
+  /* The Z key (without Ctrl) of the platform: the map view magnified. Here
+     and not in the event loop, so that a text field being typed in gets
+     the letter first. */
+  static std::function<void(int)> zoom_hook;
   void close_platform_box();
   void draw_pause(Frame *frame);
 
diff --git a/src/popup.cc b/src/popup.cc
index e03ef0f..b3efda1 100644
--- a/src/popup.cc
+++ b/src/popup.cc
@@ -3872,6 +3872,7 @@ PopupBox::handle_action(int action, int x_, int /*y_*/) {
   case ACTION_SHOW_SAVE:
     file_list->set_displayed(true);
     file_field->set_displayed(true);
+    file_field->set_focused();  /* The name is typed at once. */
     set_box(TypeLoadSave);
     break;
   case ACTION_SAVE: {
diff --git a/src/text-input.cc b/src/text-input.cc
index 352881a..3c075aa 100644
--- a/src/text-input.cc
+++ b/src/text-input.cc
@@ -81,13 +81,21 @@ TextInput::handle_key_pressed(char key, int modifier) {
     return false;
   }
 
-  if ((max_length != 0) && (text.length() >= max_length)) {
+  if (key == '\b') {
+    if (text.length() > 0) {
+      text = text.substr(0, text.length() - 1);
+      set_redraw();
+    }
     return true;
   }
 
-  if ((key == '\b') && (text.length() > 0)) {
-    text = text.substr(0, text.length() - 1);
-    set_redraw();
+  /* Esc, Tab, Return and the other control keys are left to the game
+     (Esc closes the box). */
+  if (key < 32 || key > 126) {
+    return false;
+  }
+
+  if ((max_length != 0) && (text.length() >= max_length)) {
     return true;
   }
 
-- 
