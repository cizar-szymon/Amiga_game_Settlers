+void
+Frame::draw_sprite_variant(int x, int y, Data::Resource res,
+                           unsigned int index, int variant) {
+  if (variant == VariantNormal) {
+    draw_sprite(x, y, res, index, true);
+    return;
+  }
+  Data::Sprite::Color none = {0, 0, 0, 0};
+  /* The mask fields of the id are free for the sprites of the map. */
+  uint64_t id = Data::Sprite::create_id(res, index, 0xf0 + variant, 0, none);
+  Image *image = Image::get_cached_image(id);
+  if (image == nullptr) {
+    Data::PSprite base = data_source->get_sprite(res, index, none);
+    if (!base) return;
+    /* A birch: its own picture of the frame of the wind (resources,
+       tools/make_birch.py), of the size of the game's tree and put where
+       that tree is. */
+    Data::PSprite pixels = base;
+    if (variant & VariantBirch) {
+      PSpriteFile birch = std::make_shared<SpriteFile>();
+      if (!birch->load_resource("birch" + std::to_string(index & 7) +
+                                ".png") ||
+          birch->get_width() != base->get_width() ||
+          birch->get_height() != base->get_height()) {
+        draw_sprite(x, y, res, index, true);
+        return;
+      }
+      pixels = birch;
+    }
+    /* A copy (the constructor takes the size and offsets, not the
+       pixels). */
+    std::shared_ptr<SpriteBase> s = std::make_shared<SpriteBase>(base);
+    size_t w = s->get_width(), h = s->get_height();
+    std::memcpy(s->get_data(), pixels->get_data(),
+                w * h * sizeof(Data::Sprite::Color));
+    Data::Sprite::Color *px =
+      reinterpret_cast<Data::Sprite::Color *>(s->get_data());
+    if (variant & VariantMirrored) {
+      for (size_t row = 0; row < h; row++) {
+        std::reverse(px + row * w, px + row * w + w);
+      }
+      /* Around the place it stands on: the trunk stays where it was. */
+      s->set_offset(-s->get_offset_x() - static_cast<int>(w),
+                    s->get_offset_y());
+    }
+    image = new Image(video, s);
+    Image::cache_image(id, image);
+  }
+  video->draw_image(image->get_video_image(), x + image->get_offset_x(),
+                    y + image->get_offset_y(), 0, video_frame);
+}
+
 void
 Frame::draw_sprite(int x, int y, Data::Resource res, unsigned int index,
                    bool use_off) {
