         int tree_anim = (interface->get_game()->get_tick() + sprite) >> 4;
+        int kind = sprite;
         if (sprite < 16) {
           sprite = (sprite & ~7) + (tree_anim & 7);
         } else {
           sprite = (sprite & ~3) + (tree_anim & 3);
         }
+        /* More kinds of trees (Advanced): mirrored ones, and birches among
+           the deciduous ones, by the place - always the same tree, on both
+           computers of a LAN game. Only the picture. */
+        if (interface->get_tree_variety() && kind < 16) {
+          uint32_t h = static_cast<uint32_t>(pos) * 2654435761u;
+          int pick = static_cast<int>((h >> 24) % 10);
+          int variant = (pick >= 6) ? Frame::VariantMirrored
+                                    : Frame::VariantNormal;
+          if (kind < 8 && pick < 3) {
+            variant = Frame::VariantBirch | (pick & 1);
+          }
+          frame->draw_sprite(x_base, ly, Data::AssetMapShadow, sprite, true);
+          frame->draw_sprite_variant(x_base, ly, Data::AssetMapObject, sprite,
