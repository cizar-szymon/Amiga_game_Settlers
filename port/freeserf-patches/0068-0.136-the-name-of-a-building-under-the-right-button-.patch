diff --git a/src/box-frame.cc b/src/box-frame.cc
index 0396eaf..083cd1a 100644
--- a/src/box-frame.cc
+++ b/src/box-frame.cc
@@ -170,3 +170,33 @@ draw_hint_box(Frame *frame, int x, int top, int w,
   }
 }
 
+/* The plate of a name (box-frame.h). */
+void
+name_plate_size(Frame *frame, const std::string &name,
+                const std::string &text, int *w, int *h) {
+  int tw = frame->get_string_width(name);
+  if (!text.empty()) tw = std::max(tw, frame->get_string_width(text));
+  *w = tw + 12;
+  *h = text.empty() ? 20 : 30;
+}
+
+void
+draw_name_plate(Frame *frame, int cx, int top, int min_x, int max_x,
+                const std::string &name, const std::string &text,
+                int *w, int *h) {
+  int pw, ph;
+  name_plate_size(frame, name, text, &pw, &ph);
+  if (w != nullptr) *w = pw;
+  if (h != nullptr) *h = ph;
+  int x = cx - pw / 2;
+  if (x + pw > max_x) x = max_x - pw;
+  if (x < min_x) x = min_x;
+  frame->fill_rect(x, top, pw, ph, Color(0x00, 0x33, 0x1a));
+  frame->draw_rect(x, top, pw, ph, Color::green);
+  frame->draw_string(x + 6, top + 6, name, Color(0xdd, 0xdd, 0x00),
+                     Color::black);
+  if (!text.empty()) {
+    frame->draw_string(x + 6, top + 16, text, Color::green, Color::black);
+  }
+}
+
