+/* The name of a building on the map, above the pointer (below it at the
+   top of the screen). */
+void
+Interface::show_map_name(const std::string &name, const std::string &text,
+                         int x, int y) {
+  map_name = name;
+  map_name_text = text;
+  map_name_x = x;
+  map_name_y = y;
+  set_redraw();
+}
+
+void
+Interface::draw_map_name(Frame *frame) {
+  if (map_name.empty() || game == nullptr) return;
+  int w, h;
+  name_plate_size(frame, map_name, map_name_text, &w, &h);
+  int top = map_name_y - 12 - h;
+  if (top < 2) top = map_name_y + 16;
+  draw_name_plate(frame, map_name_x, top, 2, width - 2, map_name,
+                  map_name_text);
+}
+
 /* Called periodically when the game progresses. */
 void
 Interface::update() {
@@ -2372,7 +2397,17 @@ Interface::handle_event(const Event *event) {
         lan_game->draw(reinterpret_cast<Frame*>(event->object));
       }
       draw_pause(reinterpret_cast<Frame*>(event->object));
+      draw_map_name(reinterpret_cast<Frame*>(event->object));
       break;
+    case Event::TypeRelease:
+      /* The right button up: the name of a building on the map goes. */
+      if (event->button == Event::ButtonRight && !map_name.empty()) {
+        map_name.clear();
+        set_redraw();
+        if (viewport != nullptr) viewport->set_redraw();
+        return true;
+      }
+      return GuiObject::handle_event(event);
     case Event::TypeInvalidate:
       invalidate();
       break;
