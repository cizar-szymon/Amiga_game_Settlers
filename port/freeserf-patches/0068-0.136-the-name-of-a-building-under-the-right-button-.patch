 bool
-EventLoop::notify_press(int x, int y) {
+EventLoop::notify_press(int x, int y, Event::Button button, int held) {
   Event event;
   event.type = Event::TypePress;
   event.x = x;
   event.y = y;
-  event.dx = 0;
+  event.dx = held;
   event.dy = 0;
-  event.button = Event::ButtonLeft;
+  event.button = button;
   return notify_handlers(&event);
 }
 
 bool
-EventLoop::notify_release() {
+EventLoop::notify_release(Event::Button button) {
   Event event;
   event.type = Event::TypeRelease;
   event.x = 0;
   event.y = 0;
