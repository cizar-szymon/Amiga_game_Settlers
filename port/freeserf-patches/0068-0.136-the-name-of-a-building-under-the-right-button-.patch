+/* The names of the buildings (Building::Type). */
+static const char *const kBuildingNames[] = {
+  "",
+  NC_("building", "Fisher"),
+  NC_("building", "Lumberjack"),
+  NC_("building", "Boatbuilder"),
+  NC_("building", "Stonecutter"),
+  NC_("building", "Stone mine"),
+  NC_("building", "Coal mine"),
+  NC_("building", "Iron mine"),
+  NC_("building", "Gold mine"),
+  NC_("building", "Forester"),
+  NC_("building", "Storehouse"),
+  NC_("building", "Guard hut"),
+  NC_("building", "Farm"),
+  NC_("building", "Butcher"),
+  NC_("building", "Pig farm"),
+  NC_("building", "Mill"),
+  NC_("building", "Bakery"),
+  NC_("building", "Sawmill"),
+  NC_("building", "Steel smelter"),
+  NC_("building", "Toolmaker"),
+  NC_("building", "Weaponsmith"),
+  NC_("building", "Guard tower"),
+  NC_("building", "Fortress"),
+  NC_("building", "Gold smelter"),
+  NC_("building", "Castle")
+};
+
+std::string
+PopupBox::building_name(int type) {
+  if (type <= 0 ||
+      type >= static_cast<int>(sizeof(kBuildingNames) /
+                               sizeof(kBuildingNames[0]))) {
+    return std::string();
+  }
+  return C_("building", kBuildingNames[type]);
+}
+
+/* The building of a build action of the boxes to choose a building, -1:
+   none (the flag: 0). */
+static int
+build_action_type(int action) {
+  switch (action) {
+    case ACTION_BUILD_STONEMINE: return Building::TypeStoneMine;
+    case ACTION_BUILD_COALMINE: return Building::TypeCoalMine;
+    case ACTION_BUILD_IRONMINE: return Building::TypeIronMine;
+    case ACTION_BUILD_GOLDMINE: return Building::TypeGoldMine;
+    case ACTION_BUILD_FLAG: return 0;
+    case ACTION_BUILD_STONECUTTER: return Building::TypeStonecutter;
+    case ACTION_BUILD_HUT: return Building::TypeHut;
+    case ACTION_BUILD_LUMBERJACK: return Building::TypeLumberjack;
+    case ACTION_BUILD_FORESTER: return Building::TypeForester;
+    case ACTION_BUILD_FISHER: return Building::TypeFisher;
+    case ACTION_BUILD_MILL: return Building::TypeMill;
+    case ACTION_BUILD_BOATBUILDER: return Building::TypeBoatbuilder;
+    case ACTION_BUILD_BUTCHER: return Building::TypeButcher;
+    case ACTION_BUILD_WEAPONSMITH: return Building::TypeWeaponSmith;
+    case ACTION_BUILD_STEELSMELTER: return Building::TypeSteelSmelter;
+    case ACTION_BUILD_SAWMILL: return Building::TypeSawmill;
+    case ACTION_BUILD_BAKER: return Building::TypeBaker;
+    case ACTION_BUILD_GOLDSMELTER: return Building::TypeGoldSmelter;
+    case ACTION_BUILD_FORTRESS: return Building::TypeFortress;
+    case ACTION_BUILD_TOWER: return Building::TypeTower;
+    case ACTION_BUILD_TOOLMAKER: return Building::TypeToolMaker;
+    case ACTION_BUILD_FARM: return Building::TypeFarm;
+    case ACTION_BUILD_PIGFARM: return Building::TypePigFarm;
+    case ACTION_BUILD_STOCK: return Building::TypeStock;
+    default: return -1;
+  }
+}
+
+/* The name shown while the right button is held in a box to choose a
+   building, under the building (over it at the bottom of the box). */
+void
+PopupBox::draw_bld_name() {
+  int w, h;
+  name_plate_size(frame, bld_name, std::string(), &w, &h);
+  int top = bld_name_bottom + 2;
+  if (top + h > height - 8) top = bld_name_top - 2 - h;
+  if (top < 8) top = 8;
+  draw_name_plate(frame, bld_name_x, top, 2, width - 2, bld_name,
+                  std::string());
+}
+
 /* A special click (right button) is handled like a click with the
-   special click flag set, where the original has a special action. */
+   special click flag set, where the original has a special action. The
+   boxes to choose a building: nothing (the name shows while the right
+   button is held, handle_right_press). */
 bool
 PopupBox::handle_click_right(int cx, int cy) {
   switch (box) {
@@ -4798,13 +4895,77 @@ PopupBox::handle_click_right(int cx, int cy) {
       handle_click_left(cx, cy);
       special_click = false;
       return true;
+    case TypeMineBuilding:
+    case TypeBasicBld:
+    case TypeBasicBldFlip:
+    case TypeAdv1Bld:
+    case TypeAdv2Bld:
+      return true;
+    default:
+      return false;
+  }
+}
+
+/* The right button down on a building of a box to choose one: its name
+   until the button goes up. */
+bool
+PopupBox::handle_right_press(int cx, int cy) {
+  switch (box) {
+    case TypeMineBuilding:
+    case TypeBasicBld:
+    case TypeBasicBldFlip:
+    case TypeAdv1Bld:
+    case TypeAdv2Bld:
+      break;
     default:
       return false;
   }
+  name_action = -1;
+  name_click = true;
+  handle_click_left(cx, cy);
+  name_click = false;
+  int type = build_action_type(name_action);
+  MapPos pos = interface->get_map_cursor_pos();
+  PGame game = interface->get_game();
+  /* Only what the box shows: the military buildings and the flag
+     where they can be built. */
+  if ((type == Building::TypeHut || type == Building::TypeTower ||
+       type == Building::TypeFortress) && !game->can_build_military(pos)) {
+    type = -1;
+  }
+  if (type == 0 && !game->can_build_flag(pos, interface->get_player())) {
+    type = -1;
+  }
+  std::string name;
+  if (type == 0) {
+    name = _("Flag");
+  } else if (type > 0) {
+    name = building_name(type);
+  }
+  if (name != bld_name) {
+    bld_name = name;
+    bld_name_x = 8 + name_rect[0] + name_rect[2] / 2;
+    bld_name_top = 8 + name_rect[1];
+    bld_name_bottom = 8 + name_rect[1] + name_rect[3];
+    set_redraw();
+  }
+  return !name.empty();
+}
+
+bool
+PopupBox::handle_right_release() {
+  if (bld_name.empty()) return false;
+  bld_name.clear();
+  set_redraw();
+  return true;
 }
 
 bool
 PopupBox::handle_click_left(int cx, int cy) {
+  if (!name_click && !bld_name.empty()) {
+    bld_name.clear();  /* the name of a right click goes */
+    set_redraw();
+  }
   cx -= 8;
   cy -= 8;
 
@@ -4978,6 +5139,7 @@ PopupBox::set_box(Type box_) {
   bool wide = ((box == TypeLoadSave) != (box_ == TypeLoadSave)) ||
               ((box == TypeOptions) != (box_ == TypeOptions));
   box = box_;
+  bld_name.clear();
   if (wide) {
     interface->layout_popup();  /* the Save box is wider */
   }
