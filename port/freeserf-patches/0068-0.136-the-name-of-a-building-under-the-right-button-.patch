diff --git a/src/viewport.cc b/src/viewport.cc
index 3d79f38..11a74e4 100644
--- a/src/viewport.cc
+++ b/src/viewport.cc
@@ -39,6 +39,7 @@
 #include "src/notification.h"
 #include "src/event_loop.h"
 #include "src/pathfinder.h"
+#include "src/translation.h"
 
 #define MAP_TILE_WIDTH   32
 #define MAP_TILE_HEIGHT  20
@@ -2702,6 +2703,32 @@ Viewport::handle_click_right(int lx, int ly) {
   return true;
 }
 
+/* The right button held still: the name of the building there (built or
+   being built, any player's) until it goes up. The picture of a building
+   stands above its place: a point on it is its place or the one up or up
+   left of it. */
+bool
+Viewport::handle_right_hold(int lx, int ly) {
+  if (interface->is_building_road()) return false;
+  MapPos clk_pos = map_pos_from_screen_pix(lx, ly);
+  const MapPos tries[3] = {
+    clk_pos, map->move_down(clk_pos), map->move_down_right(clk_pos)
+  };
+  for (MapPos pos : tries) {
+    if (!map->has_building(pos)) continue;
+    Building *building = interface->get_game()->get_building_at_pos(pos);
+    if (building == nullptr || building->is_burning()) continue;
+    std::string name = PopupBox::building_name(building->get_type());
+    if (name.empty()) continue;
+    interface->show_map_name(
+      name, building->is_done() ? std::string() : _("Under construction"),
+      x + static_cast<int>(static_cast<float>(lx) * zoom),
+      y + static_cast<int>(static_cast<float>(ly) * zoom));
+    return true;
+  }
+  return false;
+}
+
 /* Left clicked with the right button held: the window of the building or
    flag there (each building: castle, lumberjack...); elsewhere, and
    while a road is being built, an ordinary left click. */
