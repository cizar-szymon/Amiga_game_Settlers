+      if (event->button == Event::ButtonRight) {
+        result = handle_right_release();
+      } else {
+        result = handle_release();
+      }
       break;
     default:
       break;
@@ -226,7 +235,10 @@ GuiObject::handle_event(const Event *event) {
   /* A click on a window that it did not use: not on to what is under it
      (the map). Without taking the focus from a text field in it. */
   if (!result && opaque && (event->type == Event::TypeClick ||
-                            event->type == Event::TypeDoubleClick)) {
+                            event->type == Event::TypeDoubleClick ||
+                            (event->type == Event::TypePress &&
+                             event->button == Event::ButtonRight &&
+                             event->dx != 0))) {
     return true;
   }
 
