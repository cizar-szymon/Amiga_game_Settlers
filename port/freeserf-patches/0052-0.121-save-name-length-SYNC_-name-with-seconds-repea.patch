+/* The + and - buttons (and the priority arrows): they repeat while the
+   left button is held on them. */
+bool
+PopupBox::is_repeat_action(int action) {
+  switch (action) {
+    case ACTION_ATTACKING_KNIGHTS_DEC:
+    case ACTION_ATTACKING_KNIGHTS_INC:
+    case ACTION_SETT_5_6_UP:
+    case ACTION_SETT_5_6_DOWN:
+    case ACTION_SETT_8_CASTLE_DEF_DEC:
+    case ACTION_SETT_8_CASTLE_DEF_INC:
+      return true;
+    default:
+      return action >= ACTION_KNIGHT_LEVEL_CLOSEST_MIN_DEC &&
+             action <= ACTION_KNIGHT_LEVEL_FARTHEST_MAX_INC;
+  }
+}
+
+/* The left button held still (auto repeat): the click again, on the
+   + and - buttons only; the boxes that have them. */
+bool
+PopupBox::handle_hold(int cx, int cy) {
+  switch (box) {
+    case TypeStartAttack:
+    case TypeStartAttackRedraw:
+    case TypeKnightLevel:
+    case TypeSett5:
+    case TypeSett6:
+    case TypeSett8:
+      break;
+    default:
+      return false;
+  }
+  repeat_click = true;
+  repeat_used = false;
+  handle_click_left(cx, cy);
+  repeat_click = false;
+  return repeat_used;
+}
+
 /* A special click (right button) is handled like a click with the
