+static std::string
+save_display_name(const std::string &file) {
+  std::string n = file;
+  const char *const ends[] = { ".save", ".lan" };
+  for (const char *e : ends) {
+    size_t l = strlen(e);
+    if (n.size() > l && n.compare(n.size() - l, l, e) == 0) {
+      n.resize(n.size() - l);
+    }
+  }
+  return n;
+}
