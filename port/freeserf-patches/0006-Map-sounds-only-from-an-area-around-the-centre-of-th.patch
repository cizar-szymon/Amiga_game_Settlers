+int Viewport::hear_width = 320;
+int Viewport::hear_height = 200;
+
+bool
+Viewport::hears(int lx, int ly) const {
+  if (hear_width <= 0) return true;
+  int dx = lx - width / 2;
+  int dy = ly - height / 2;
+  return dx >= -hear_width / 2 && dx < hear_width / 2 &&
+         dy >= -hear_height / 2 && dy < hear_height / 2;
+}
+
