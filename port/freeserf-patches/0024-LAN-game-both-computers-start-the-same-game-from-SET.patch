+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * freeserf is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with freeserf.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#ifndef SRC_LAN_GAME_H_
+#define SRC_LAN_GAME_H_
+
+#include <cstdint>
+#include <map>
+#include <string>
+
+#include "src/mission.h"
+#include "src/random.h"
+
+class Interface;
+class LanLink;
+class Game;
+class Frame;
+
+/* Both computers make the same game from the same settings (SETUP: the
+   map, the players and the seed of the game's random numbers) and, as the
+   logic of the game depends on nothing else, it stays the same on both as
+   long as the players' commands reach both at the same step (point 4 of
+   the plan). To see that, both send a checksum of the game every
+   kSumSteps steps and compare it with their own of the same step. */
+class LanGame {
+ public:
+  /* The frames of the game through the link. */
+  typedef enum Message {
+    MessageSetup = 0,  /* START GAME: the settings of the game */
+    MessageSum = 1     /* step and checksum */
+  } Message;
+
+  static const unsigned int kSumSteps = 250;  /* 5 s */
+
+ protected:
+  Interface *interface;
+  LanLink *link;
+  bool server;
+  unsigned int steps;
+  std::map<unsigned int, uint32_t> own_sums;
+  std::map<unsigned int, uint32_t> other_sums;
+  unsigned int last_checked;
+  bool out_of_step;
+  unsigned int out_of_step_at;
+  bool gone;
+  /* The mode before a LAN game made it 640x480; 0: not changed. */
+  unsigned int old_width, old_height;
+
+ public:
+  LanGame(Interface *interface, LanLink *link, bool server);
+  ~LanGame();
+
+  /* After the game started: the screen to at most 640x480. */
+  void started();
+  /* After every step of the game. */
+  void update();
+  /* The state of the link in the top left corner of the game. */
+  void draw(Frame *frame);
+  bool is_server() const { return server; }
+
+ protected:
+  void compare();
+};
+
+#endif  // SRC_LAN_GAME_H_
