+  if (!mission) {
+    return false;
+  }
+  mission->set_game_random(seed);
+  if (!GameManager::get_instance().start_game(mission)) {
+    return false;
+  }
+  /* The link goes on in the game; the boxes go. */
+  lan_game.reset(new LanGame(this, lan_link, server));
+  if (!server) {
+    set_player(1);
+  }
+  close_lan_box();
+  close_game_init();
+  lan_game->started();
+  return true;
