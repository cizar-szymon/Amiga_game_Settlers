+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with freeserf.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include "src/lan-game.h"
+
+#include <sstream>
+#include <string>
+
+#include "src/interface.h"
+#include "src/lan-link.h"
+#include "src/lan-sync.h"
+#include "src/game.h"
+#include "src/map.h"
+#include "src/gfx.h"
+
+/* The largest screen of a LAN game. */
+static const unsigned int kMaxWidth = 640;
+static const unsigned int kMaxHeight = 480;
+
+LanGame::LanGame(Interface *_interface, LanLink *_link, bool _server)
+  : interface(_interface)
+  , link(_link)
+  , server(_server)
+  , steps(0)
+  , last_checked(0)
+  , out_of_step(false)
+  , out_of_step_at(0)
+  , gone(false)
+  , old_width(0)
+  , old_height(0) {
+}
+
+LanGame::~LanGame() {
+  if (link != nullptr) {
+    link->close();
+  }
+  if (old_width != 0) {
+    Graphics::get_instance().set_resolution(old_width, old_height, true);
+  }
+}
+
+void
+LanGame::started() {
+  Graphics &gfx = Graphics::get_instance();
+  unsigned int w = 0, h = 0;
+  gfx.get_resolution(&w, &h);
+  if (w > kMaxWidth || h > kMaxHeight) {
+    old_width = w;
+    old_height = h;
+    gfx.set_resolution(kMaxWidth, kMaxHeight, true);
+  }
+}
+
+void
+LanGame::update() {
+  steps++;
+  if (link == nullptr) {
+    return;
+  }
+  link->poll();
+  if (!gone && link->get_state() != LanLink::StateConnected) {
+    gone = true;
+  }
+  int type = 0;
+  std::string data;
+  while (link->receive(&type, &data)) {
+    if (type == MessageSum) {
+      std::istringstream s(data);
+      unsigned int step = 0;
+      uint32_t sum = 0;
+      if (s >> step >> sum) {
+        other_sums[step] = sum;
+      }
+    }
+  }
+  if ((steps - 1) % kSumSteps == 0) {
+    PGame game = interface->get_game();
+    if (game) {
+      uint32_t sum = lan_checksum(game.get());
+      own_sums[steps] = sum;
+      link->send(MessageSum, std::to_string(steps) + " " +
+                             std::to_string(sum));
+    }
+  }
+  compare();
+}
+
+void
+LanGame::compare() {
+  while (!other_sums.empty()) {
+    auto theirs = other_sums.begin();
+    auto mine = own_sums.find(theirs->first);
+    if (mine == own_sums.end()) {
+      if (own_sums.empty() || own_sums.rbegin()->first < theirs->first) {
+        break;  /* This side is not there yet. */
+      }
+      other_sums.erase(theirs);  /* Too old to compare. */
+      continue;
+    }
+    if (mine->second != theirs->second && !out_of_step) {
+      out_of_step = true;
+      out_of_step_at = theirs->first;
+    }
+    last_checked = theirs->first;
+    own_sums.erase(own_sums.begin(), ++mine);
+    other_sums.erase(theirs);
+  }
+  /* The other side may be gone or far behind. */
+  while (own_sums.size() > 64) {
+    own_sums.erase(own_sums.begin());
+  }
+}
+
+void
+LanGame::draw(Frame *frame) {
+  std::string text = "LAN ";
+  if (link == nullptr) {
+    text += "-";
+  } else if (gone) {
+    text += "player gone";
+  } else {
+    text += link->get_peer_name();
+    int ms = link->get_ping_ms();
+    if (ms >= 0) text += " " + std::to_string(ms) + " ms";
+  }
+  if (out_of_step) {
+    text += " OUT OF STEP " + std::to_string(out_of_step_at);
+  } else if (last_checked != 0) {
+    text += " same " + std::to_string(last_checked);
+  }
+  int w = 8 * static_cast<int>(text.size()) + 4;
+  frame->fill_rect(0, 12, w, 11, Color::black);
+  frame->draw_string(2, 14, text,
+                     out_of_step ? Color(0xff, 0x40, 0x40) : Color::green,
+                     Color::transparent);
+}
