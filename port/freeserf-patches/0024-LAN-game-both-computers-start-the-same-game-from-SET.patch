+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with freeserf.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include "src/lan-sync.h"
+
+#include <sstream>
+#include <string>
+
+#include "src/game.h"
+#include "src/map.h"
+#include "src/player.h"
+
+/* The version of SETUP. */
+static const int kSetupVersion = 1;
+
+/* "1 <map size> <random base> <seed> <players>" and for each player
+   "<face> <r> <g> <b> <intelligence> <supplies> <reproduction>". */
+std::string
+lan_encode_setup(PGameInfo mission, const Random &seed) {
+  std::ostringstream s;
+  s << kSetupVersion << ' ' << mission->get_map_size() << ' '
+    << std::string(mission->get_random_base()) << ' '
+    << std::string(seed) << ' ' << mission->get_player_count();
+  for (size_t i = 0; i < mission->get_player_count(); i++) {
+    PPlayerInfo p = mission->get_player(i);
+    Player::Color c = p->get_color();
+    s << ' ' << p->get_face() << ' ' << static_cast<unsigned int>(c.red)
+      << ' ' << static_cast<unsigned int>(c.green) << ' '
+      << static_cast<unsigned int>(c.blue) << ' ' << p->get_intelligence()
+      << ' ' << p->get_supplies() << ' ' << p->get_reproduction();
+  }
+  return s.str();
+}
+
+PGameInfo
+lan_decode_setup(const std::string &data, Random *seed) {
+  std::istringstream s(data);
+  int version = 0;
+  unsigned int map_size = 0;
+  size_t count = 0;
+  std::string base, seed_text;
+  s >> version >> map_size >> base >> seed_text >> count;
+  if (!s || version != kSetupVersion || base.size() != 16 ||
+      seed_text.size() != 16 || count < 2 || count > 4) {
+    return nullptr;
+  }
+  PGameInfo mission = std::make_shared<GameInfo>(Random(base));
+  mission->set_map_size(map_size);
+  mission->remove_all_players();
+  for (size_t i = 0; i < count; i++) {
+    unsigned int face, r, g, b, intelligence, supplies, reproduction;
+    s >> face >> r >> g >> b >> intelligence >> supplies >> reproduction;
+    if (!s) {
+      return nullptr;
+    }
+    Player::Color c = { static_cast<uint8_t>(r), static_cast<uint8_t>(g),
+                        static_cast<uint8_t>(b) };
+    mission->add_player(face, c, intelligence, supplies, reproduction);
+  }
+  *seed = Random(seed_text);
+  return mission;
+}
+
+/* FNV-1a of the map tiles, the step and the random numbers: what the two
+   games have to agree on. A size 8 map is 65536 tiles, a few ms on a
+   68060, once in kSumSteps. */
+uint32_t
+lan_checksum(Game *game) {
+  uint32_t h = 2166136261u;
+  auto add = [&h](uint32_t v) {
+    for (int i = 0; i < 4; i++) {
+      h ^= (v >> (8 * i)) & 0xff;
+      h *= 16777619u;
+    }
+  };
+  add(game->get_tick());
+  std::string rnd = game->get_random_text();
+  for (char c : rnd) add(static_cast<uint8_t>(c));
+  PMap map = game->get_map();
+  for (unsigned int r = 0; r < map->get_rows(); r++) {
+    for (unsigned int c = 0; c < map->get_cols(); c++) {
+      MapPos pos = map->pos(c, r);
+      add(map->get_height(pos) | (map->paths(pos) << 8) |
+          (map->get_owner(pos) << 16) |
+          (static_cast<uint32_t>(map->get_obj(pos)) << 24));
+      add(map->get_serf_index(pos) | (map->get_res_amount(pos) << 16));
+    }
+  }
+  return h;
+}
