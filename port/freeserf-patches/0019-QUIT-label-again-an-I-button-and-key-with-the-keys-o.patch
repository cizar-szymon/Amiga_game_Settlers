From ad1b3342fd9b44cd2722b755f895da7ae1ed10c4 Mon Sep 17 00:00:00 2001
From: cizar-szymon <szymon@cs-lab.eu>
Date: Mon, 26 Oct 2026 00:42:20 +0100
Subject: [PATCH 19/39] QUIT label again; an I button and key with the keys of
 the game

The settings box's button to the start menu shows the original QUIT
again. Between Save and the small Exit an 'I' button (the small Exit
picture with an I in the lettering of the buttons) opens a box with the
keys of the game; the I key opens it too. The game's font has no '+' and
'/': the plus signs are drawn.
---
 src/interface.cc |   5 +++
 src/popup.cc     | 112 ++++++++++++++++++++++++++++++++++++-----------
 src/popup.h      |   6 ++-
 3 files changed, 96 insertions(+), 27 deletions(-)

diff --git a/src/interface.cc b/src/interface.cc
index d49d61e..a3bbe01 100644
--- a/src/interface.cc
+++ b/src/interface.cc
@@ -1344,6 +1344,11 @@ Interface::handle_key_pressed(char key, int modifier) {
       game->pause();
       break;
     }
+    case 'i': {
+      /* The keys of the game (also the "I" button of the settings box). */
+      open_popup(PopupBox::TypeKeysInfo);
+      break;
+    }
 
     /* Audio */
     case 's': {
