-        }
-      }
-    }
-  }
+  /* The "I" button between Save and Exit (Amiga port): the keys of the
+     game. The small Exit picture with an I on it. */
+  static const char *const kI[5] = { "###", " # ", " # ", " # ", "###" };
+  draw_popup_icon(12, 128, 60);
+  draw_small_label(8 * 12 + 8, 128 + 9, 16, kI);
 }
 
 /* Draw slide bar in a popup box. */
@@ -1962,6 +1943,66 @@ PopupBox::draw_sett_5_box() {
   draw_popup_icon(6, 120, 33+current_sett_5_item);
 }
 
+/* A label of 5 pixel high letters (rows of '#'), yellow with a dark
+   outline like the lettering of the original's buttons, centred on a plate
+   over a button w pixels wide and 16 high at x, y. */
+void
+PopupBox::draw_small_label(int x, int y, int w, const char *const rows[5]) {
+  int lw = static_cast<int>(std::strlen(rows[0]));
+  frame->fill_rect(x + 2, y + 2, w - 4, 12, Color(0x99, 0x55, 0x22));
+  const int lx = x + (w - lw) / 2, ly = y + 5;
+  for (int pass = 0; pass < 2; pass++) {
+    for (int r = 0; r < 5; r++) {
+      for (int col = 0; rows[r][col] != 0; col++) {
+        if (rows[r][col] != '#') continue;
+        if (pass == 0) {
+          frame->fill_rect(lx + col - 1, ly + r - 1, 3, 3,
+                           Color(0x55, 0x22, 0x00));
+        } else {
+          frame->fill_rect(lx + col, ly + r, 1, 1, Color(0xdd, 0xdd, 0x00));
+        }
+      }
+    }
+  }
+}
+
+/* The keys of the game, from the "I" button of the settings box (Amiga
+   port). At most 15 characters a line. */
+void
+PopupBox::draw_keys_info_box() {
+  draw_box_background(PatternDiagonalGreen);
+
+  draw_green_centered(4, "Keys");
+  /* The game's font has no '+' and no '/': a space in the text, the plus
+     drawn below. */
+  static const char *const kLines =
+    "  Game speed   \n"
+    "- Game speed --\n"
+    "0 Normal speed\n"
+    "Z Zoom\n"
+    "Wheel Zoom\n"
+    "P Pause\n"
+    "M Music on-off\n"
+    "S Sound on-off\n"
+    "Ctrl Z Save\n"
+    "F9 Screenshot\n"
+    "I This box\n"
+    "Shift Esc Quit";
+  draw_green_lines(1, 18, kLines, 9);
+  static const int kPlus[][2] = {  /* character, line */
+    {0, 0}, {13, 0}, {14, 0}, {4, 8}, {5, 11}
+  };
+  for (const auto &p : kPlus) {
+    int x = 8 * 1 + 8 + 8 * p[0], y = 18 + 9 + 9 * p[1];
+    frame->fill_rect(x + 2, y + 4, 6, 2, Color::black);  /* shadow */
+    frame->fill_rect(x + 4, y + 2, 2, 6, Color::black);
+    frame->fill_rect(x + 1, y + 3, 6, 2, Color::green);
+    frame->fill_rect(x + 3, y + 1, 2, 6, Color::green);
+  }
+
+  draw_popup_icon(14, 128, 60); /* exit */
+}
+
