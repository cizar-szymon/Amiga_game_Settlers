From 45eb93906c6497c5ea16c6ddc713ffaa57e022bc Mon Sep 17 00:00:00 2001
From: cizar-szymon <szymon@cs-lab.eu>
Date: Sun, 25 Oct 2026 23:03:41 +0100
Subject: [PATCH 14/20] EXIT label in small letters

The game's 8x8 font filled the whole 32x16 button. The label is drawn in
5 pixel high letters, yellow with a dark outline, like the lettering of
the buttons beside it.
---
 src/popup.cc | 31 ++++++++++++++++++++++++++-----
 1 file changed, 26 insertions(+), 5 deletions(-)

diff --git a/src/popup.cc b/src/popup.cc
index 9d28427..a98ec99 100644
--- a/src/popup.cc
+++ b/src/popup.cc
@@ -1682,11 +1682,32 @@ PopupBox::draw_sett_select_box() {
   draw_box_background(PatternCheckerdDiagonalBrown);
   draw_custom_icon_box(layout);
 
-  /* The Quit button leads back to the start menu in this port: Exit on
-     it, yellow like the original's lettering, on a plate inside it. */
-  frame->fill_rect(8 * 0 + 8 + 2, 128 + 9 + 2, 28, 12, Color(0x55, 0x22, 0x00));
-  frame->draw_string(8 * 0 + 8, 128 + 9 + 4, "EXIT", Color(0xdd, 0xdd, 0x00),
-                     Color::transparent);
+  /* The Quit button leads back to the start menu in this port: EXIT on
+     it, in small letters like those of the buttons beside it (5 pixels
+     high, yellow, dark outline), as the game's data has no such picture. */
+  static const char *const kExit[5] = {
+    "#### #   # ### #####",
+    "#     # #   #    #  ",
+    "###    #    #    #  ",
+    "#     # #   #    #  ",
+    "#### #   # ###   #  "
+  };
+  const int bx = 8 * 0 + 8, by = 128 + 9;  /* the button, 32x16 */
+  frame->fill_rect(bx + 2, by + 2, 28, 12, Color(0x99, 0x55, 0x22));
+  const int lx = bx + 6, ly = by + 5;
+  for (int pass = 0; pass < 2; pass++) {
+    for (int r = 0; r < 5; r++) {
+      for (int c = 0; kExit[r][c] != 0; c++) {
+        if (kExit[r][c] != '#') continue;
+        if (pass == 0) {
+          frame->fill_rect(lx + c - 1, ly + r - 1, 3, 3,
+                           Color(0x55, 0x22, 0x00));
+        } else {
+          frame->fill_rect(lx + c, ly + r, 1, 1, Color(0xdd, 0xdd, 0x00));
+        }
+      }
+    }
+  }
 }
 
 /* Draw slide bar in a popup box. */
