@@ -31,6 +33,11 @@ void draw_box_frame(Frame *frame, int width, int height);
 /* Letters 5 pixels high (rows of '#', or as many rows as given) at x, y,
    yellow with a dark outline like the lettering of the original's
    buttons; scale 2: each dot 2x2. */
+/* A button with a text on a wooden plate with a dark edge, 16 pixels
+   high; a disabled one is grey. */
+void draw_text_button(Frame *frame, int x, int y, int w,
+                      const std::string &text, bool enabled = true);
+
