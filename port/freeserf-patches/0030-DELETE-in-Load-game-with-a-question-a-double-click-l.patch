diff --git a/src/box-frame.cc b/src/box-frame.cc
index f3318f1..418efd1 100644
--- a/src/box-frame.cc
+++ b/src/box-frame.cc
@@ -26,6 +26,18 @@
 #include "src/gfx.h"
 #include "src/data.h"
 
+void
+draw_text_button(Frame *frame, int x, int y, int w, const std::string &text,
+                 bool enabled) {
+  frame->fill_rect(x, y, w, 16, Color(0x55, 0x22, 0x00));
+  frame->fill_rect(x + 1, y + 1, w - 2, 14,
+                   enabled ? Color(0x99, 0x55, 0x22) : Color(0x55, 0x55, 0x55));
+  int tx = x + (w - frame->get_string_width(text)) / 2;
+  frame->draw_string(tx, y + 4, text,
+                     enabled ? Color(0xdd, 0xdd, 0x00) : Color(0x99, 0x99, 0x99),
+                     Color::black);
+}
+
 void
 draw_small_letters(Frame *frame, int x, int y, const char *const *rows,
                    int scale, int row_count) {
