+bool
+ListSavedFiles::handle_dbl_click(int cx, int cy, Event::Button button) {
+  if (button != Event::ButtonLeft || open_handler == nullptr ||
+      (scrollable() && cx >= width - kBarWidth)) {
+    return false;
+  }
+  int row = static_cast<int>(first_visible_item) + (cy - 3) / 9;
+  if (cy >= 3 && row == selected_item) {
+    open_handler(items[selected_item].path);
+  }
+  return true;
+}
