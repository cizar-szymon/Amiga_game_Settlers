+/* The player ends the game (Quit -> YES, and in a LAN game after the
+   question whether to save it): out of the program, or to the start
+   menu. A LAN game is left on purpose: no LAN_ERR save here. */
+void
+PopupBox::quit_game(Interface *iface) {
+  if (iface->get_lan_game() != nullptr) {
+    iface->get_lan_game()->leave_on_purpose();
+  }
+  Audio::get_instance().enqueue_sfx(Audio::TypeSfxAhhh);
+  if (iface->is_quit_program()) {
+    EventLoop::get_instance().quit();
+  } else {
+    /* Exit: to the start menu, not out of the program (its Quit
+       button, Shift+Esc and Ctrl+Q quit it). */
+    iface->exit_to_start_menu();
+  }
+}
+
 /* Generic handler for clicks in popup boxes. */
 int
 PopupBox::handle_clickmap(int x_, int y_, const int clkmap[]) {
@@ -4375,7 +4417,14 @@ PopupBox::handle_quit_confirm_click(int cx, int cy) {
     ACTION_QUIT_CANCEL, 88, 45, 32, 8,
     -1
   };
-  handle_clickmap(cx, cy, clkmap);
+  /* The question whether to save the LAN game, under the first one (the
+     buttons of the first one do nothing then). */
+  const int save_clkmap[] = {
+    ACTION_LAN_QUIT_SAVE, 8, 108, 32, 8,
+    ACTION_LAN_QUIT_NO_SAVE, 88, 108, 32, 8,
+    -1
+  };
+  handle_clickmap(cx, cy, lan_save_ask ? save_clkmap : clkmap);
 }
 
