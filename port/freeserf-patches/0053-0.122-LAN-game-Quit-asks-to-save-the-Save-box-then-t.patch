   , mission(_mission)
   , view(ViewChoose)
-  , server_name_field(make_name_field("server_name", "MASTER"))
-  , player_name_field(make_name_field("player_name", "SLAVE"))
+  , server_name_field(make_name_field("server_name", "PLAYER 1"))
+  , player_name_field(make_name_field("player_name", "PLAYER 2"))
   , address_field(new TextInput())
   , port(LanLink::kDefaultPort)
   , port_in_use(LanLink::kDefaultPort)
diff --git a/src/lan-box.h b/src/lan-box.h
index c4d0cb1..6d9dc77 100644
--- a/src/lan-box.h
+++ b/src/lan-box.h
@@ -67,8 +67,8 @@ class LanBox : public GuiObject {
   View view;
   std::string own_address;
   /* The names in a LAN game, kept in the settings: of a server (players
-     looking for one see it, MASTER at first) and of a player who joins
-     (the server shows it, SLAVE at first). */
+     looking for one see it, PLAYER 1 at first) and of a player who joins
+     (the server shows it, PLAYER 2 at first). */
   std::unique_ptr<TextInput> server_name_field;
   std::unique_ptr<TextInput> player_name_field;
   std::unique_ptr<TextInput> address_field;
