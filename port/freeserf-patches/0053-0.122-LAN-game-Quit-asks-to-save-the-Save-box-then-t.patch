+    std::string(server ? "PLAYER 1" : "PLAYER 2"));
 }
 
 LanGame::~LanGame() {
@@ -119,7 +121,8 @@ LanGame::~LanGame() {
     /* The other side learns that this one left (sent before the BYE of
        close()). */
     if (!gone && !other_quit) {
-      link->send(MessageQuit, std::string());
+      link->send(MessageQuit, left_on_purpose ? std::string("purpose")
+                                              : std::string());
     }
     link->close();
   }
@@ -212,6 +215,9 @@ LanGame::receive() {
       receive_resync(type, data);
     } else if (type == MessageQuit) {
       other_quit = true;
+      /* "purpose": the player ended the game on purpose (asked whether to
+         save it); nothing to save here. */
+      other_left_on_purpose = data == "purpose";
     } else if (type == MessageSum) {
       std::istringstream s(data);
       unsigned int step = 0;
@@ -520,7 +526,7 @@ LanGame::receive_file(int type, const std::string &data) {
 
 bool
 LanGame::save_at_end() {
-  if (end_saved) return false;
+  if (end_saved || left_on_purpose || other_left_on_purpose) return false;
   end_saved = true;
   PGame game = interface->get_game();
   /* Not before the game went (a saved game still coming). */
@@ -555,7 +561,11 @@ LanGame::other_side_ended() {
                                       : peer_name;
   /* Both sides end: the game of one player alone would no longer be the
      LAN game (a save of it could not go on together). */
-  if (other_quit) {
+  if (other_left_on_purpose) {
+    /* The other player chose to end it (Quit, asked whether to save). */
+    notice = std::string(server ? "The player " : "The server ") + who +
+             " ended the game.";
+  } else if (other_quit) {
     notice = who + (server ? " left the game." : " ended the game.");
   } else {
     notice = "The connection to " + who + " is lost.";
diff --git a/src/lan-game.h b/src/lan-game.h
index d7a8ae7..d73cc2f 100644
--- a/src/lan-game.h
+++ b/src/lan-game.h
@@ -57,7 +57,8 @@ class LanGame {
     MessageSetup = 0,  /* START GAME: the settings of the game */
     MessageSum = 1,    /* step and checksum */
     MessageTurn = 2,   /* turn, more frames follow, commands */
-    MessageQuit = 3,   /* the player left the game (exit, quit) */
+    MessageQuit = 3,   /* the player left the game (exit, quit); "purpose":
+                          ended on purpose, the other side saves nothing */
     /* A saved game, from the server: "<size> <checksum> <delay>",
        then its bytes in pieces, then the end. */
     MessageSaveBegin = 4,
@@ -125,6 +126,12 @@ class LanGame {
   bool other_quit;
   /* The game was saved when it ended (save_at_end). */
   bool end_saved;
+  /* This player quit on purpose (Quit, then saved or not): no LAN_ERR
+     save on this side. */
+  bool left_on_purpose;
+  /* The other player quit on purpose (its QUIT says so): no LAN_ERR save
+     here either. */
+  bool other_left_on_purpose;
   /* gone or other_quit seen: the notice is up. */
   bool end_seen;
   std::string peer_name;
@@ -200,6 +207,9 @@ class LanGame {
   /* What is wrong with the connection now, "" if nothing. */
   std::string problem_text();
   bool is_server() const { return server; }
+  /* The player quits on purpose: the game is not saved at its end here
+     (the player was asked whether to save it). */
+  void leave_on_purpose() { left_on_purpose = true; }
   /* A key for the chat: Tab opens and closes it, while open it takes the
      letters (Return sends the line). false: the key is not for it. */
   bool handle_chat_key(char key, int modifier);
